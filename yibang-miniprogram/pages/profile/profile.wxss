
/* 右侧值样式 */
.acc-val {
  flex: none;
  margin-left: 16rpx;
  font-size: 27rpx;
  color: #667085;
  font-variant-numeric: tabular-nums;
}
/* 消息通知铃铛 */
.me-notify {
  position: relative;
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.me-notify-ico {
  width: 40rpx;
  height: 40rpx;
}
.me-notify-badge {
  position: absolute;
  top: -4rpx;
  right: -4rpx;
  min-width: 28rpx;
  height: 28rpx;
  padding: 0 8rpx;
  border-radius: 14rpx;
  background: #FF3B30;
  color: #fff;
  font-size: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* pages/profile/profile.wxss */

/* ---------- 分类标题 ---------- */
.section-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #98A2B3;
  padding: 32rpx 36rpx 16rpx;
  letter-spacing: 1rpx;
}

/* ---------- 身份卡 ---------- */
.me-card {
  margin: 24rpx 0 24rpx;
  padding: 40rpx 36rpx 16rpx;
  border-radius: var(--r-lg);
  /* 这张卡上同时有 38/40rpx 的大字（3:1 即可）和 24/25rpx 的小字（要 4.5:1）。
     原来压在 #E4551D→#C9451A 上亮端只有 3.74:1 —— 大字够、小字不够。
     收口到品牌渐变后亮端 4.75:1，两种字号都过。 */
  background: #C9451A;
  background: var(--brand-grad);
  box-shadow: 0 16rpx 36rpx -18rpx rgba(201, 69, 26, .7);
  position: relative;
  overflow: hidden;
}
.me-top {
  display: flex;
  align-items: center;
}
.me-avatar {
  width: 116rpx;
  height: 116rpx;
  border-radius: 50%;
  /* 半透明白底 + 白字，这里是**刻意**的：首字 56rpx＝28px，属 WCAG 的"大字"（≥24px），
     只要 3:1；实测在收口后的品牌渐变上约 3.38:1 ✓。
     对比 contact-detail 的 .info-avatar（40rpx＝20px，属小字要 4.5:1）——
     那一处已经改成半透明黑底。同一套规则、不同字号，处理方式自然不同，别一刀切。 */
  background: rgba(255, 255, 255, .22);
  border: 2rpx solid rgba(255, 255, 255, .35);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 56rpx;
  flex-shrink: 0;
}
.me-info {
  flex: 1;
  min-width: 0;
  margin: 0 20rpx;
}
.me-name {
  font-size: 38rpx;
  font-weight: 700;
  color: #fff;
}
.me-shop {
  margin-top: 6rpx;
  font-size: 25rpx;
  /* 原来是 rgba(255,255,255,.8)：半透明白等于把文字掺进橙色底，实测再掉到约 3.6:1。
     小字必须是纯白（4.75:1）—— 层级交给字号和字重，不靠透明度。 */
  color: #fff;
}
.me-plan {
  height: 52rpx;
  padding: 0 22rpx;
  border-radius: var(--r-full);
  font-size: 24rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  flex-shrink: 0;
}
.me-plan.free {
  /* 原来是 rgba(255,255,255,.2) —— 半透明白底把白字所在的背景**提亮**了，
     实测对比度掉到约 3.5:1（24rpx 小字要 4.5:1）。
     改成半透明**黑**底（压暗底色），白字升到约 7:1，而且视觉上依然是一个"淡标签"。 */
  background: rgba(0, 0, 0, .22);
  color: #fff;
}
.me-plan.pro {
  background: #FFD66B;
  color: #6B3A00;
}

/* 数据条：让「用的越久越值」这件事可视化 */
.me-stats {
  display: flex;
  align-items: stretch;
  margin-top: 32rpx;
  padding: 24rpx 0;
  border-top: 1rpx solid rgba(255, 255, 255, .2);
}
.me-stat {
  flex: 1;
  min-width: 0;
  text-align: center;
}
.me-stat-v {
  font-size: 40rpx;
  font-weight: 700;
  color: #fff;
  line-height: 1.1;
}
.me-stat-k {
  margin-top: 6rpx;
  font-size: 24rpx;
  /* 同上：24rpx 小字不能用半透明白（会掉到约 3.3:1），必须纯白。
     和上面的 40rpx 数字靠字号拉开层级即可。 */
  color: #fff;
}
.me-sep {
  width: 2rpx;
  background: rgba(255, 255, 255, .2);
  margin: 6rpx 0;
}

/* ---------- 底部 ---------- */
.me-footer {
  text-align: center;
  padding: 48rpx 0 24rpx;
}
.me-footer-l1 {
  font-size: 24rpx;
  color: var(--t3);
}
.me-footer-l2 {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--t4);
}

/* ---------- 越用越懂卡片 ---------- */
/* 放在身份卡下面第一屏：招牌卖点要让老板天天看见，不能藏在设置里 */
.memo-card {
  padding: 28rpx 32rpx 24rpx;
  background: linear-gradient(160deg, #FFFFFF 0%, #FFF8F4 100%);
}
.memo-hd {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.memo-t {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--t1);
}
.memo-hero {
  display: flex;
  align-items: baseline;
  margin-top: 14rpx;
}
.memo-num {
  font-size: 58rpx;
  font-weight: 700;
  color: var(--brand-ink);
  line-height: 1.1;
}
.memo-unit {
  margin-left: 12rpx;
  font-size: 27rpx;
  color: var(--t2);
}
.memo-sub {
  margin: 22rpx 0 12rpx;
  font-size: 25rpx;
  color: var(--t3);
}
.memo-map {
  display: flex;
  align-items: center;
  min-height: 64rpx;
  padding: 10rpx 0;
  font-size: 28rpx;
}
.memo-from {
  color: var(--t3);
}
.memo-arrow {
  margin: 0 14rpx;
  color: var(--t4);
}
.memo-to {
  color: var(--t1);
  font-weight: 600;
}
.memo-by {
  margin-left: 14rpx;
  padding: 2rpx 12rpx;
  border-radius: 8rpx;
  background: var(--brand-weak);
  color: var(--brand-ink);
  font-size: 22rpx;
  font-weight: 600;
}
.memo-chips {
  display: flex;
  flex-wrap: wrap;
  margin: 0 -8rpx;
}
.memo-chip {
  height: 56rpx;
  padding: 0 22rpx;
  margin: 0 8rpx 12rpx;
  border-radius: var(--r-full);
  background: var(--fill);
  color: var(--t2);
  font-size: 25rpx;
  display: flex;
  align-items: center;
}
.memo-empty {
  margin-top: 16rpx;
  font-size: 26rpx;
  line-height: 1.6;
  color: var(--t3);
}
.memo-tip {
  margin-top: 18rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid var(--line);
  font-size: 25rpx;
  line-height: 1.6;
  color: var(--t3);
}

/* ---------- 身份卡的店名行：可点击修改 ---------- */
/* 原来「点这里完善店名」点不动，是个空头承诺。现在整块可点，右侧给一支白铅笔做提示。
   图标用另存的白色版（ic-pencil-w.svg），不用 CSS filter —— 小程序里 image 的 filter 支持不稳。 */
.me-shop-row {
  display: flex;
  align-items: center;
  margin-top: 6rpx;
}
.me-shop-row .me-shop {
  margin-top: 0;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.me-edit {
  width: 26rpx;
  height: 26rpx;
  flex: none;
  margin-left: 10rpx;
  opacity: .8;
}

/* 改资料的弹层里那行说明 */
.pf-note {
  padding: 2rpx 0 22rpx;
  font-size: 25rpx;
  line-height: 1.65;
  color: var(--t3);
}
/* 表单三件套（.f-block / .f-label / .f-input）已收口到 app.wxss（2026-09-22）。
   原来这里写着"页面级作用域拿不到 record.wxss 里的同名类，所以定义一份" ——
   正是这种"各页各抄一份"导致 4 份定义慢慢漂移，其中两份漏写 height 把文字裁掉了。 */

/* ---------- 营业日截止时间弹层（2026-09-22）----------
   替掉 wx.showActionSheet：它 itemList 上限 6 项，这里有 7 项，超限直接失败。
   改成弹层后还能给每项配一句说明 —— 选项本身（「凌晨2点前」）老板不一定看得懂，
   说明那句话才是他真正做判断的依据。 */
.de-hint {
  padding: 2rpx 0 10rpx;
  font-size: 25rpx;
  line-height: 1.6;
  color: var(--t3);
}
.de-opt {
  display: flex;
  align-items: center;
  /* 触控区 ≥88rpx（全站规范） */
  min-height: 108rpx;
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--line);
}
.de-opt:last-child {
  border-bottom: none;
}
.de-opt:active {
  background: var(--fill);
}
.de-main {
  flex: 1;
  min-width: 0;
}
.de-t {
  font-size: 29rpx;
  color: var(--t1);
}
.de-opt.is-on .de-t {
  color: var(--brand-ink);
  font-weight: 600;
}
.de-d {
  margin-top: 4rpx;
  font-size: 24rpx;
  color: var(--t3);
}
/* 选中打勾：纯 CSS 画，不额外引一个图标文件（勾只有一个用处，不值得多个资源） */
.de-check {
  flex: none;
  position: relative;
  width: 36rpx;
  height: 36rpx;
  margin-left: 16rpx;
}
.de-check::after {
  content: '';
  position: absolute;
  left: 11rpx;
  top: 4rpx;
  width: 11rpx;
  height: 20rpx;
  border-right: 4rpx solid var(--brand-ink);
  border-bottom: 4rpx solid var(--brand-ink);
  transform: rotate(45deg);
}
