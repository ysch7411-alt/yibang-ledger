
/* 分享按钮占满宽度 */
.action-btn-full {
  flex: none;
  width: 100%;
}

/* 收入支出区域：增加和金额之间的留白，上下对称 */
.stat-grid {
  margin-top: 28rpx;
}
/* 应收应付卡片：左右排列，大字体 */
.debt-card {
  display: flex;
  flex-direction: row;
  padding: 40rpx 24rpx;
}
.debt-col {
  flex: 1;
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}
.debt-k {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--t2);
  margin-bottom: 16rpx;
}
.debt-v {
  font-size: 56rpx;
  font-weight: 700;
  margin: 0 0 12rpx;
  letter-spacing: -.5rpx;
}
.debt-s {
  font-size: 26rpx;
  color: var(--t4);
}
.debt-line {
  width: 2rpx;
  background: var(--line);
  margin: 8rpx 16rpx;
}
/* 操作按钮区 */
.action-bar {
  display: flex;
  gap: 20rpx;
  margin: 24rpx 32rpx;
}
.action-btn {
  flex: 1;
  height: 88rpx;
  border-radius: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 600;
}
.action-btn:active {
  opacity: 0.85;
}
.action-primary {
  background: linear-gradient(135deg, #FF6B35 0%, #C9451A 100%);
  color: #fff;
}
.action-secondary {
  background: #FFF4EE;
  color: #C9451A;
  border: 2rpx solid #FFD9C6;
}
.action-warn {
  background: #FFF6E5;
  color: #B54708;
  border: 2rpx solid #FDE68A;
}

/* 功能入口列表 */
.entry-list {
  margin: 0 32rpx 24rpx;
  padding: 0;
  overflow: hidden;
}
.entry-row {
  display: flex;
  align-items: center;
  padding: 28rpx 32rpx;
  border-bottom: 2rpx solid #F2F4F7;
}
.entry-row:last-child {
  border-bottom: none;
}
.entry-row:active {
  background: #F9FAFB;
}
.entry-ico {
  width: 88rpx;
  height: 88rpx;
  border-radius: 22rpx;
  background: linear-gradient(135deg, #FF6B35 0%, #C9451A 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
  flex-shrink: 0;
  box-shadow: 0 4rpx 12rpx rgba(255, 107, 53, 0.3);
}
.entry-ico-img {
  width: 48rpx;
  height: 48rpx;
  filter: brightness(0) invert(1);
}
.entry-main {
  flex: 1;
  min-width: 0;
}
.entry-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #101828;
  margin-bottom: 6rpx;
}
.entry-desc {
  font-size: 24rpx;
  color: #667085;
}
.entry-arrow {
  width: 16rpx;
  height: 16rpx;
  border-top: 3rpx solid #98A2B3;
  border-right: 3rpx solid #98A2B3;
  transform: rotate(45deg);
  margin-left: 16rpx;
  flex-shrink: 0;
}
/* pages/summary/summary.wxss */

/* ---------- 顶部标题栏 ---------- */
.page-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx 36rpx 16rpx;
}
.page-head-left {
  flex: 1;
}
.page-head-right {
  flex-shrink: 0;
}
.export-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 16rpx 32rpx;
  border-radius: 32rpx;
  background: linear-gradient(135deg, #E4551D 0%, #C9451A 100%);
  box-shadow: 0 8rpx 20rpx -8rpx rgba(201, 69, 26, .5);
}
.export-btn:active {
  transform: scale(0.96);
  opacity: 0.9;
}
.export-btn-text {
  font-size: 26rpx;
  font-weight: 600;
  color: #FFFFFF;
}

/* ---------- 生意参谋入口 ---------- */
.advisor-entry {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 24rpx;
  margin: 24rpx;
  background: linear-gradient(135deg, rgba(228, 85, 29, .06) 0%, rgba(201, 69, 26, .03) 100%);
  border: 2rpx solid rgba(228, 85, 29, .15);
  border-radius: 20rpx;
  position: relative;
  overflow: hidden;
}
.advisor-entry:active {
  transform: scale(0.98);
  opacity: 0.9;
}
.advisor-entry::before {
  content: "";
  position: absolute;
  top: -30rpx;
  right: -30rpx;
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(228, 85, 29, .1) 0%, transparent 70%);
  pointer-events: none;
}
.advisor-entry-left {
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0;
}
.advisor-entry-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #FF8A50 0%, #E4551D 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  flex-shrink: 0;
  box-shadow: 0 8rpx 20rpx -8rpx rgba(201, 69, 26, .5);
}
.advisor-entry-icon-img {
  width: 36rpx;
  height: 36rpx;
}
.advisor-entry-info {
  flex: 1;
  min-width: 0;
}
.advisor-entry-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #101828;
  margin-bottom: 6rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.advisor-entry-desc {
  font-size: 24rpx;
  color: #98A2B3;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.advisor-entry-arrow {
  width: 12rpx;
  height: 12rpx;
  border-top: 3rpx solid #D0D5DD;
  border-right: 3rpx solid #D0D5DD;
  transform: rotate(45deg);
  flex-shrink: 0;
  margin-left: 16rpx;
}

.sum-tail {
  height: 40rpx;
}
.pad {
  padding: 24rpx 0;
}

/* 分段控件统一用 app.wxss 的 .seg / .seg-i / .is-on。
   这里原来还有一份 68rpx 的旧版本，同一个页面两套类名迟早长得不一样，已删除。 */

/* ---------- 汇总卡 ---------- */
.sum-card {
  padding: 24rpx 36rpx 24rpx;
  position: relative;
  overflow: hidden;
}
.sum-card::before {
  content: "";
  position: absolute;
  top: -40rpx;
  right: -40rpx;
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(255, 107, 53, .06) 0%, transparent 70%);
  pointer-events: none;
}
.sum-hero {
  text-align: center;
  padding: 0;
  margin-top: 0;
}
.sum-hero-k {
  display: block;
  font-size: 25rpx;
  color: var(--t3);
  margin-bottom: 0;
  margin-top: 20rpx;
  line-height: 1.2;
}
.sum-hero-v {
  font-size: 80rpx;
  font-weight: 700;
  letter-spacing: -2rpx;
  line-height: 1;
  margin-top: 0;
}
.sum-ft {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid var(--line);
}
.sum-count {
  font-size: 25rpx;
  color: var(--t3);
}
/* 页脚右侧那两个动作。查询是次要入口，所以用灰字，别跟实心的「分享报表」抢眼 */
.sum-ft-acts {
  display: flex;
  align-items: center;
  flex: none;
}
/* 上下给足内边距，把可点区域撑到 88rpx；这一行本来就有这么高，不会把页面撑长 */
.sum-link {
  margin-right: 22rpx;
  padding: 26rpx 8rpx;
  font-size: 26rpx;
  color: var(--t3);
}
.sum-link:active {
  opacity: .6;
}

.sum-share {
  /* 原来 64rpx（32px）——不到 44px 的触控下限。这个按钮正是老板要点的那个，
     顺手提到 88rpx。 */
  min-height: 88rpx;
  padding: 0 36rpx;
  border-radius: var(--r-full);
  background: var(--brand-weak);
  color: var(--brand-ink);
  font-size: 27rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
}
.sum-share:active {
  opacity: .75;
}

/* ---------- 往来总览 ---------- */
.debt-hd {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}
.debt-body {
  display: flex;
  align-items: stretch;
  padding-top: 16rpx;
}
.debt-col {
  flex: 1;
  min-width: 0;
  text-align: center;
}
.debt-k {
  font-size: 25rpx;
  color: var(--t3);
}
.debt-v {
  margin: 10rpx 0 6rpx;
  font-size: 48rpx;
  font-weight: 700;
}
.debt-line {
  width: 2rpx;
  background: var(--line);
  margin: 8rpx 16rpx;
}

/* ---------- 往来行：圆形首字，替代纯文字列表（一眼区分对象） ---------- */
.ct-avatar {
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  background: var(--brand-weak);
  color: var(--brand-ink);
  font-size: 30rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 22rpx;
  flex-shrink: 0;
}

/* ---------- 报表图：离屏画布 ---------- */
/* 必须真实存在且可渲染：2d canvas 用 display:none 拿不到 node，画不出来。
   所以是挪到屏幕外，不是藏起来。 */
.rep-canvas {
  position: fixed;
  left: -9999px;
  top: 0;
  z-index: -1;
}

/* ---------- 分享报表弹层 ---------- */
.sh-note {
  padding: 2rpx 0 18rpx;
  font-size: 25rpx;
  color: var(--t3);
}
.sh-opt {
  display: flex;
  align-items: center;
  min-height: 108rpx;
  padding: 22rpx 0;
  border-bottom: 1rpx solid var(--line);
}
.sh-opt:last-child {
  border-bottom: none;
}
.sh-opt:active {
  opacity: .6;
}
.sh-opt.is-busy {
  opacity: .45;
}
/* 分享页面那一项是个原生 button（只有 open-type="share" 才能拉起微信转发面板），
   所以要把它复位成普通一行的样子。button 自带的白底/边框/居中都要清掉。 */
.sh-opt-btn {
  display: flex;
  align-items: center;
  width: 100%;
  background: transparent;
  border-radius: 0;
  font-size: inherit;
  font-weight: inherit;
  line-height: inherit;
  color: inherit;
  text-align: left;
}
.sh-opt-btn::after {
  border: none;
}
/* 主路径的图标底用实心橙：ic-brand.svg 本身是**纯白**图标（设计给深底用的），
   配下面那个浅底会白压浅、等于隐形。
   写成复合选择器而不是单独的类 —— 同权重下靠源码顺序决定胜负太脆
   （第一版就栽在这：.sh-ico-key 写在 .sh-ico 前面，橙底被浅底盖掉，图标直接看不见了）。
   把意图写进选择器，谁前谁后都不受影响。 */
.sh-ico.sh-ico-key {
  background: var(--brand-btn);
}
.sh-ico {
  width: 72rpx;
  height: 72rpx;
  flex: none;
  margin-right: 24rpx;
  border-radius: var(--r-md);
  background: var(--brand-weak);
  display: flex;
  align-items: center;
  justify-content: center;
}
.sh-ico-img {
  width: 40rpx;
  height: 40rpx;
}
.sh-main {
  flex: 1;
  min-width: 0;
}
.sh-t {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--t1);
}
.sh-d {
  margin-top: 4rpx;
  font-size: 24rpx;
  line-height: 1.5;
  color: var(--t3);
}

/* ---------- 报表日历 ---------- */
.cal-card {
  padding: 24rpx 20rpx 18rpx;
}
.cal-hd {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 2rpx 0 14rpx;
}
.cal-nav {
  width: 88rpx;
  height: 88rpx;
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  font-size: 46rpx;
  line-height: 1;
  color: var(--t2);
}
.cal-nav:active {
  background: var(--fill);
}
/* 已经是当前月时，下一月不能点：让它看起来就是关掉的，而不是点了没反应 */
.cal-nav.is-off {
  color: var(--line);
}
.cal-nav.is-ghost {
  pointer-events: none;
}
.cal-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--t1);
}
.cal-week {
  display: flex;
  padding-bottom: 6rpx;
}
.cal-wd {
  flex: 1;
  text-align: center;
  font-size: 24rpx;
  color: var(--t3);
}
.cal-grid {
  display: flex;
  flex-wrap: wrap;
}
.cal-cell {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border-radius: var(--r-sm);
}
.cal-grid.is-day .cal-cell {
  width: 14.285%;
  height: 92rpx;
}
.cal-grid.is-month .cal-cell,
.cal-grid.is-year .cal-cell {
  width: 33.333%;
  height: 132rpx;
}
.cal-cell.is-blank {
  visibility: hidden;
}
.cal-n {
  font-size: 26rpx;
  font-weight: 500;
  color: var(--t1);
}
.cal-cell.is-today {
  background: var(--brand-weak);
}
.cal-cell.is-today .cal-n {
  color: var(--brand-ink);
  font-weight: 700;
}
.cal-cell.is-sel {
  background: var(--brand-btn);
}
.cal-cell.is-sel .cal-n,
.cal-cell.is-sel .cal-big-l,
.cal-cell.is-sel .cal-big-none {
  color: #fff;
}
/* 日视图的格子里只有日期 + 两条色条：7 列一格才 96rpx，金额塞进去只能是小字。
   色条本身不写数字，但哪天有进账、哪天有支出一眼就能看出来。 */
.cal-marks {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 10rpx;
  margin-top: 6rpx;
}
.cal-mark {
  width: 14rpx;
  height: 8rpx;
  margin: 0 3rpx;
  border-radius: 4rpx;
}
.mk-in {
  background: var(--income);
}
.mk-out {
  background: var(--expense);
}
.cal-cell.is-sel .mk-in,
.cal-cell.is-sel .mk-out {
  background: #fff;
}
/* 月/年视图格子大得下数字，就直接给收支，省得再点一下 */
.cal-big {
  margin-top: 4rpx;
  text-align: center;
}
.cal-big-l {
  display: block;
  font-size: 24rpx;
  line-height: 1.45;
}
.cal-big-none {
  font-size: 24rpx;
  color: var(--t4);
}
.cal-tip {
  padding: 26rpx 0 10rpx;
  text-align: center;
  font-size: 25rpx;
  color: var(--t3);
}
.cal-tip.is-bad {
  color: var(--expense);
}
.cal-now {
  margin-top: 10rpx;
  padding: 16rpx 0;
  text-align: center;
  font-size: 25rpx;
  color: var(--brand-ink);
}
.cal-now:active {
  opacity: .6;
}
/* 选中那一格的汇总 */
.cal-sel {
  margin-top: 14rpx;
  padding: 20rpx 24rpx;
  border-radius: var(--r-md);
  background: var(--fill);
}
.cal-sel-hd {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}
.cal-sel-d {
  font-size: 27rpx;
  font-weight: 600;
  color: var(--t1);
}
.cal-sel-v {
  font-size: 34rpx;
  font-weight: 700;
}

.cal-sel-share {
  margin-top: 20rpx;
  height: 72rpx;
  border-radius: 36rpx;
  background: linear-gradient(135deg, #FF8A3D, #FF6B35);
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 16rpx rgba(255, 107, 53, 0.3);
}
.cal-sel-share:active {
  opacity: 0.85;
  transform: scale(0.98);
}
.cal-sel-share-ico {
  margin-right: 8rpx;
  font-size: 32rpx;
}
.cal-sel-ft {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--t3);
}
.cal-dot {
  margin: 0 10rpx;
  color: var(--line);
}

/* ---------- 汇总表（每日 / 每月，都不列明细） ---------- */
/* 只给结余一列上色：收入/支出两列的头已经写着字了，再上色只是噪声；
   而结余是有正负的，颜色在这里才真的承载信息。 */
.tbl-hd,
.tbl-r {
  display: flex;
  align-items: center;
}
.tbl-hd {
  padding-bottom: 12rpx;
  border-bottom: 1rpx solid var(--line);
}
.tbl-hd .tbl-c1,
.tbl-hd .tbl-c2,
.tbl-hd .tbl-c3,
.tbl-hd .tbl-c4 {
  font-size: 24rpx;
  color: var(--t3);
}
.tbl-r {
  min-height: 88rpx;
  border-bottom: 1rpx solid var(--line);
}
.tbl-r .tbl-c1 {
  font-size: 26rpx;
  color: var(--t1);
}
.tbl-r .tbl-c2,
.tbl-r .tbl-c3,
.tbl-r .tbl-c4 {
  font-size: 25rpx;
}
.tbl-c1 {
  flex: 1.15;
  min-width: 0;
}
.tbl-c2,
.tbl-c3,
.tbl-c4 {
  flex: 1;
  text-align: right;
}
.tbl-r.is-total {
  border-top: 2rpx solid var(--line);
  border-bottom: none;
}
.tbl-r.is-total .tbl-c1 {
  font-weight: 600;
}
.tbl-r.is-total .tbl-c2,
.tbl-r.is-total .tbl-c3,
.tbl-r.is-total .tbl-c4 {
  font-weight: 700;
}
.tbl-tip {
  padding: 40rpx 0;
  text-align: center;
  font-size: 25rpx;
  color: var(--t3);
}
.tbl-tip.is-bad {
  color: var(--expense);
}


/* ---------- 每日汇总表：点某天展开当天明细 ---------- */
/* 行被 .tbl-grp 包了一层，.tbl-r:last-child 落不到最后一行头上 ——
   不补这条，最后一行底下会多一道跟合计行重复的线。 */
.tbl-grp:last-child .tbl-r {
  border-bottom: none;
}
/* 展开中的那一行：底色提亮 + 日期变橙，让人一眼知道下面那坨是谁的 */
.tbl-r.is-open {
  background: var(--brand-weak);
}
.tbl-r.is-open .tbl-c1 {
  color: var(--brand-ink);
  font-weight: 600;
}
/* 展开指示列。固定宽度，两张汇总表都留这一列，列宽才对得齐 */
.tbl-cx {
  flex: none;
  width: 34rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.tbl-caret {
  width: 12rpx;
  height: 12rpx;
  border-right: 3rpx solid var(--t4);
  border-bottom: 3rpx solid var(--t4);
  transform: rotate(45deg) translate(-2rpx, -2rpx);
  transition: transform .18s ease;
}
.tbl-caret.up {
  transform: rotate(-135deg) translate(-2rpx, -2rpx);
}

/* 展开出来的当天明细 */
.dd {
  padding: 4rpx 0 14rpx;
  animation: yb-fade .18s ease;
}
.dd-tip {
  padding: 18rpx 0;
  font-size: 25rpx;
  color: var(--t3);
}
.dd-tip.is-bad {
  color: var(--expense);
}
.dd-r {
  display: flex;
  align-items: center;
  padding: 14rpx 0;
  border-bottom: 1rpx dashed var(--line);
}
.dd-r:last-child {
  border-bottom: none;
}
.dd-t {
  flex: none;
  width: 86rpx;
  font-size: 24rpx;
  color: var(--t3);
}
.dd-n {
  flex: 1;
  min-width: 0;
  margin: 0 16rpx;
  font-size: 27rpx;
  color: var(--t1);
}
.dd-a {
  flex: none;
  font-size: 27rpx;
  font-weight: 600;
  text-align: right;
}
.dd-sum {
  padding-top: 12rpx;
  font-size: 24rpx;
  color: var(--t3);
}
