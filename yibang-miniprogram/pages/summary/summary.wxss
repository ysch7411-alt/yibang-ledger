
/* 本页是 **TabBar 页**：弹层要停在 tabBar 之上。
   （公共 .sheet 的默认值 `--sheet-rest` 是二级页的情形 —— 页面没有 tabBar，贴底避让安全区。）
   2026-09-22 收口：全站弹层位置统一由 --sheet-rest 控制，**页面不再各自覆盖 .sheet**。 */
page {
  --sheet-rest: calc(var(--tabbar-h) + env(safe-area-inset-bottom, 0px));
}

/* ---------- 申请解锁弹层的输入区 ----------
   2026-09-22：这一块原来是 .unlock-form / .unlock-label / .unlock-textarea / .unlock-count
   四个类，而它们**全项目都没有定义** —— 弹层真渲染出来是个没样式的裸块。
   现在只保留这两个（textarea 和字数）自己独有的规格，其余复用 .sheet-bd / .f-block / .f-label。 */
.unlock-textarea {
  width: 100%;
  min-height: 176rpx;
  padding: 20rpx 24rpx;
  border-radius: var(--r-md);
  background: var(--fill);
  font-size: 28rpx;
  line-height: 1.6;
  color: var(--t1);
  /* 宽度含内边距（唯一一处必须显式写的场景：textarea 默认不回传父级盒模型） */
  box-sizing: border-box;
}
.unlock-count {
  margin-top: 10rpx;
  text-align: right;
  font-size: 24rpx;
  color: var(--t4);
}
/* 「解锁申请中」那一行：不可点，视觉上比可点的行轻一档 */
.entry-row.is-pending {
  opacity: .72;
}

/* 分享按钮占满宽度 */
.action-btn-full {
  flex: none;
  width: 100%;
}

/* 收入支出区域：增加和金额之间的留白，上下对称 */
.stat-grid {
  margin-top: 28rpx;
}
/* 应收应付卡片：左右排列，大字体 */
.debt-card {
  display: flex;
  flex-direction: row;
  padding: 40rpx 24rpx;
}
.debt-col {
  flex: 1;
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}
.debt-k {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--t2);
  margin-bottom: 16rpx;
}
.debt-v {
  font-size: 56rpx;
  font-weight: 700;
  margin: 0 0 12rpx;
  letter-spacing: -.5rpx;
}
.debt-s {
  font-size: 26rpx;
  color: var(--t4);
}
.debt-line {
  width: 2rpx;
  background: var(--line);
  margin: 8rpx 16rpx;
}
/* 操作按钮区 */
.action-bar {
  display: flex;
  gap: 20rpx;
  margin: 24rpx 32rpx;
}
.action-btn {
  flex: 1;
  height: 88rpx;
  border-radius: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 600;
}
.action-btn:active {
  opacity: 0.85;
}
/* 2026-09-22：原来是 #FF6B35 → #C9451A 的渐变，最亮那一端白字只有 2.81:1，
   正好踩在项目自己写的"#FF6B35 禁止承载文字"上。改成按钮色实底（白字 4.75:1 ✓）。 */
.action-primary {
  background: var(--brand-btn);
  color: #fff;
}
.action-secondary {
  background: #FFF4EE;
  color: #C9451A;
  border: 2rpx solid #FFD9C6;
}
.action-warn {
  background: #FFF6E5;
  color: #B54708;
  border: 2rpx solid #FDE68A;
}

/* 功能入口列表 */
.entry-list {
  margin: 0 32rpx 24rpx;
  padding: 0;
  overflow: hidden;
}
.entry-row {
  display: flex;
  align-items: center;
  padding: 28rpx 32rpx;
  border-bottom: 2rpx solid #F2F4F7;
}
.entry-row:last-child {
  border-bottom: none;
}
.entry-row:active {
  background: #F9FAFB;
}
.entry-ico {
  width: 88rpx;
  height: 88rpx;
  border-radius: 22rpx;
  /* 原来 #FF6B35→#C9451A：亮端白图标只有 2.84:1（图标要 ≥3:1）。收口到品牌渐变 */
  background: #C9451A;
  background: var(--brand-grad);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
  flex-shrink: 0;
  box-shadow: 0 4rpx 12rpx rgba(255, 107, 53, 0.3);
}
.entry-ico-img {
  width: 48rpx;
  height: 48rpx;
}
/* 2026-09-22 去掉了这里的 filter: brightness(0) invert(1)。
   它是个 hack —— 把任意颜色的 svg 硬涂成白色；一旦某个图标忘了放进来就会露馅，
   而且换主题色时这层白也帮不上忙。现在直接用白色版图标：
   ic-clock-w / ic-search-w / ic-lock-open-w（命名沿用项目已有的 ic-mic-o / ic-sparkle-w 习惯）。 */
.entry-main {
  flex: 1;
  min-width: 0;
}
.entry-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #101828;
  margin-bottom: 6rpx;
}
.entry-desc {
  font-size: 24rpx;
  color: #667085;
}
.entry-arrow {
  width: 16rpx;
  height: 16rpx;
  border-top: 3rpx solid #98A2B3;
  border-right: 3rpx solid #98A2B3;
  transform: rotate(45deg);
  margin-left: 16rpx;
  flex-shrink: 0;
}
/* pages/summary/summary.wxss */

/* ---------- 顶部标题栏 ---------- */
.page-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx 36rpx 16rpx;
}
.page-head-left {
  flex: 1;
}
.page-head-right {
  flex-shrink: 0;
}
.export-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 16rpx 32rpx;
  border-radius: 32rpx;
  /* 白字原压在 #E4551D→#C9451A 上只有 3.74:1（26rpx 属小字，需 4.5:1）→ 收口到品牌渐变 */
  background: #C9451A;
  background: var(--brand-grad);
  box-shadow: 0 8rpx 20rpx -8rpx rgba(201, 69, 26, .5);
}
.export-btn:active {
  transform: scale(0.96);
  opacity: 0.9;
}
.export-btn-text {
  font-size: 26rpx;
  font-weight: 600;
  color: #FFFFFF;
}

/* 2026-09-22 删除「生意参谋入口」整块（.advisor-entry / -left / -icon / -icon-img /
   -info / -title / -desc / -arrow + ::before、:active，共 10 条规则）。
   这是旧的参谋入口样式，对应 wxml 早已移除（改成结余卡下方的 .ask-entry 了），
   全项目没有任何 wxml 再引用它 —— 留着只会让人以为还有第二个入口，
   而且它的 .advisor-entry-icon 用的是 #FF8A50→#E4551D（白图标 2.33:1）。
   删除前已 `grep -rn advisor-entry --include=*.wxml` 确认为 0 引用。 */

/* ---------- 钱花在哪（品类分布）----------
   2026-09-22 新增，配合 /record/stats 接口。

   条形色用**账本的语义色**（支出红 / 收入绿），不用品牌橙：
   老板在这套账本里已经建立"红=钱出去、绿=钱进来"的条件反射，
   而这张卡说的正是这件事，用同一套颜色他才不用重新学一遍。
   （品牌橙留给"入口/图标"那一层，不参与收支语义。） */
.cat-hd {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
/* 「花了 / 赚了」是 **seg**（同一批数据的两个视角）而不是 chip（筛掉数据），
   所以用浅底 + 橙字，不用实心橙 —— 这是全站的既定分工。 */
.cat-seg {
  display: flex;
  flex: none;
  padding: 4rpx;
  margin-left: 16rpx;
  border-radius: var(--r-full);
  background: var(--fill);
}
.cat-seg-i {
  /* 触控区 ≥ 88rpx 是宽度方向的规范，这里高度取 60rpx + 上下 4rpx 内边距，
     命中区域对外感受等同于 68rpx；刻意小于主控件，因为它是本卡的次级开关 */
  min-width: 88rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--r-full);
  font-size: 26rpx;
  color: var(--t2);
}
.cat-seg-i.is-on {
  background: var(--card);
  color: var(--brand-ink);
  font-weight: 600;
  box-shadow: 0 2rpx 8rpx -2rpx rgba(16, 24, 40, .12);
}
.cat-sub {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--t3);
}
.cat-loading {
  margin-top: 28rpx;
}
.cat-tip {
  margin-top: 24rpx;
  padding: 36rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: var(--t3);
}
/* 「取不到」要有别于「真的没有」：给品牌色 + 可点的提示语 */
.cat-tip.is-bad {
  color: var(--brand-ink);
}
.cat-row {
  margin-top: 26rpx;
}
.cat-top {
  display: flex;
  align-items: baseline;
}
.cat-name {
  flex: 1;
  /* 🔴 flex 子项配 text-overflow 必须同时写 min-width: 0，否则长品类名会把行撑破 */
  min-width: 0;
  font-size: 28rpx;
  color: var(--t1);
}
.cat-share {
  flex: none;
  margin-left: 12rpx;
  font-size: 24rpx;
  color: var(--t3);
}
.cat-amt {
  flex: none;
  margin-left: 16rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--t1);
}
.cat-track {
  margin-top: 12rpx;
  height: 16rpx;
  border-radius: var(--r-full);
  background: var(--fill);
  overflow: hidden;
}
.cat-fill {
  height: 100%;
  border-radius: var(--r-full);
  transition: width .3s ease;
}
.cat-card.is-out .cat-fill {
  background: var(--expense);
}
.cat-card.is-in .cat-fill {
  background: var(--income);
}
.cat-ft {
  margin-top: 28rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid var(--line);
  font-size: 26rpx;
  color: var(--t3);
}
.cat-dot {
  margin: 0 12rpx;
  color: var(--line);
}

.sum-tail {
  height: 40rpx;
}
.pad {
  padding: 24rpx 0;
}

/* 分段控件统一用 app.wxss 的 .seg / .seg-i / .is-on。
   这里原来还有一份 68rpx 的旧版本，同一个页面两套类名迟早长得不一样，已删除。 */

/* ---------- 汇总卡 ---------- */
.sum-card {
  padding: 24rpx 36rpx 24rpx;
  position: relative;
  overflow: hidden;
}
.sum-card::before {
  content: "";
  position: absolute;
  top: -40rpx;
  right: -40rpx;
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(255, 107, 53, .06) 0%, transparent 70%);
  pointer-events: none;
}
.sum-hero {
  text-align: center;
  padding: 0;
  margin-top: 0;
}
.sum-hero-k {
  display: block;
  font-size: 25rpx;
  color: var(--t3);
  margin-bottom: 0;
  margin-top: 20rpx;
  line-height: 1.2;
}
.sum-hero-v {
  font-size: 80rpx;
  font-weight: 700;
  letter-spacing: -2rpx;
  line-height: 1;
  margin-top: 0;
}
.sum-ft {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid var(--line);
}
.sum-count {
  font-size: 25rpx;
  color: var(--t3);
}
/* 页脚右侧那两个动作。查询是次要入口，所以用灰字，别跟实心的「分享报表」抢眼 */
.sum-ft-acts {
  display: flex;
  align-items: center;
  flex: none;
}
/* 上下给足内边距，把可点区域撑到 88rpx；这一行本来就有这么高，不会把页面撑长 */
.sum-link {
  margin-right: 22rpx;
  padding: 26rpx 8rpx;
  font-size: 26rpx;
  color: var(--t3);
}
.sum-link:active {
  opacity: .6;
}

.sum-share {
  /* 原来 64rpx（32px）——不到 44px 的触控下限。这个按钮正是老板要点的那个，
     顺手提到 88rpx。 */
  min-height: 88rpx;
  padding: 0 36rpx;
  border-radius: var(--r-full);
  background: var(--brand-weak);
  color: var(--brand-ink);
  font-size: 27rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
}
.sum-share:active {
  opacity: .75;
}

/* ---------- 往来总览 ---------- */
.debt-hd {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}
.debt-body {
  display: flex;
  align-items: stretch;
  padding-top: 16rpx;
}
.debt-col {
  flex: 1;
  min-width: 0;
  text-align: center;
}
.debt-k {
  font-size: 25rpx;
  color: var(--t3);
}
.debt-v {
  margin: 10rpx 0 6rpx;
  font-size: 48rpx;
  font-weight: 700;
}
.debt-line {
  width: 2rpx;
  background: var(--line);
  margin: 8rpx 16rpx;
}

/* ---------- 往来行：圆形首字，替代纯文字列表（一眼区分对象） ---------- */
.ct-avatar {
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  background: var(--brand-weak);
  color: var(--brand-ink);
  font-size: 30rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 22rpx;
  flex-shrink: 0;
}

/* ---------- 报表图：离屏画布 ---------- */
/* 必须真实存在且可渲染：2d canvas 用 display:none 拿不到 node，画不出来。
   所以是挪到屏幕外，不是藏起来。 */
.rep-canvas {
  position: fixed;
  left: -9999px;
  top: 0;
  z-index: -1;
}

/* ---------- 报表日历 ---------- */
.cal-card {
  padding: 24rpx 20rpx 18rpx;
}
.cal-hd {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 2rpx 0 14rpx;
}
.cal-nav {
  width: 88rpx;
  height: 88rpx;
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  font-size: 46rpx;
  line-height: 1;
  color: var(--t2);
}
.cal-nav:active {
  background: var(--fill);
}
/* 已经是当前月时，下一月不能点：让它看起来就是关掉的，而不是点了没反应 */
.cal-nav.is-off {
  color: var(--line);
}
.cal-nav.is-ghost {
  pointer-events: none;
}
.cal-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--t1);
}
.cal-week {
  display: flex;
  padding-bottom: 6rpx;
}
.cal-wd {
  flex: 1;
  text-align: center;
  font-size: 24rpx;
  color: var(--t3);
}
.cal-grid {
  display: flex;
  flex-wrap: wrap;
}
.cal-cell {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border-radius: var(--r-sm);
}
.cal-grid.is-day .cal-cell {
  width: 14.285%;
  height: 92rpx;
}
.cal-grid.is-month .cal-cell,
.cal-grid.is-year .cal-cell {
  width: 33.333%;
  height: 132rpx;
}
.cal-cell.is-blank {
  visibility: hidden;
}
.cal-n {
  font-size: 26rpx;
  font-weight: 500;
  color: var(--t1);
}
.cal-cell.is-today {
  background: var(--brand-weak);
}
.cal-cell.is-today .cal-n {
  color: var(--brand-ink);
  font-weight: 700;
}
.cal-cell.is-sel {
  background: var(--brand-btn);
}
.cal-cell.is-sel .cal-n,
.cal-cell.is-sel .cal-big-l,
.cal-cell.is-sel .cal-big-none {
  color: #fff;
}
/* 日视图的格子里只有日期 + 两条色条：7 列一格才 96rpx，金额塞进去只能是小字。
   色条本身不写数字，但哪天有进账、哪天有支出一眼就能看出来。 */
.cal-marks {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 10rpx;
  margin-top: 6rpx;
}
.cal-mark {
  width: 14rpx;
  height: 8rpx;
  margin: 0 3rpx;
  border-radius: 4rpx;
}
.mk-in {
  background: var(--income);
}
.mk-out {
  background: var(--expense);
}
.cal-cell.is-sel .mk-in,
.cal-cell.is-sel .mk-out {
  background: #fff;
}
/* 月/年视图格子大得下数字，就直接给收支，省得再点一下 */
.cal-big {
  margin-top: 4rpx;
  text-align: center;
}
.cal-big-l {
  display: block;
  font-size: 24rpx;
  line-height: 1.45;
}
.cal-big-none {
  font-size: 24rpx;
  color: var(--t4);
}
.cal-tip {
  padding: 26rpx 0 10rpx;
  text-align: center;
  font-size: 25rpx;
  color: var(--t3);
}
.cal-tip.is-bad {
  color: var(--expense);
}
.cal-now {
  margin-top: 10rpx;
  padding: 16rpx 0;
  text-align: center;
  font-size: 25rpx;
  color: var(--brand-ink);
}
.cal-now:active {
  opacity: .6;
}
/* 选中那一格的汇总 */
.cal-sel {
  margin-top: 14rpx;
  padding: 20rpx 24rpx;
  border-radius: var(--r-md);
  background: var(--fill);
}
.cal-sel-hd {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}
.cal-sel-d {
  font-size: 27rpx;
  font-weight: 600;
  color: var(--t1);
}
.cal-sel-v {
  font-size: 34rpx;
  font-weight: 700;
}

/* 2026-09-22：原来是 #FF8A3D → #FF6B35 的渐变 —— 这是全站最亮的一段橙，
   白字对比度只有约 2.4:1（全站最低）。改成按钮色实底 + 图标换成白色版，
   同时把高度提到 88rpx 满足触控下限（原来是 72rpx＝36px，不达标）。 */
.cal-sel-share {
  margin-top: 20rpx;
  height: 88rpx;
  border-radius: var(--r-full);
  background: var(--brand-btn);
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 16rpx -6rpx rgba(201, 69, 26, .5);
}
.cal-sel-share:active {
  background: var(--brand-btn-press);
  transform: scale(0.98);
}
/* 曾经这里是个 📤 emoji（全站第 20 处 emoji 当图标）—— 换成白色版分享图标 */
.cal-sel-share-ico {
  width: 32rpx;
  height: 32rpx;
  margin-right: 12rpx;
  flex: none;
}
.cal-sel-ft {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--t3);
}
.cal-dot {
  margin: 0 10rpx;
  color: var(--line);
}

/* ---------- 汇总表（每日 / 每月，都不列明细） ---------- */
/* 只给结余一列上色：收入/支出两列的头已经写着字了，再上色只是噪声；
   而结余是有正负的，颜色在这里才真的承载信息。 */
.tbl-hd,
.tbl-r {
  display: flex;
  align-items: center;
}
.tbl-hd {
  padding-bottom: 12rpx;
  border-bottom: 1rpx solid var(--line);
}
.tbl-hd .tbl-c1,
.tbl-hd .tbl-c2,
.tbl-hd .tbl-c3,
.tbl-hd .tbl-c4 {
  font-size: 24rpx;
  color: var(--t3);
}
.tbl-r {
  min-height: 88rpx;
  border-bottom: 1rpx solid var(--line);
}
.tbl-r .tbl-c1 {
  font-size: 26rpx;
  color: var(--t1);
}
.tbl-r .tbl-c2,
.tbl-r .tbl-c3,
.tbl-r .tbl-c4 {
  font-size: 25rpx;
}
.tbl-c1 {
  flex: 1.15;
  min-width: 0;
}
.tbl-c2,
.tbl-c3,
.tbl-c4 {
  flex: 1;
  text-align: right;
}
.tbl-r.is-total {
  border-top: 2rpx solid var(--line);
  border-bottom: none;
}
.tbl-r.is-total .tbl-c1 {
  font-weight: 600;
}
.tbl-r.is-total .tbl-c2,
.tbl-r.is-total .tbl-c3,
.tbl-r.is-total .tbl-c4 {
  font-weight: 700;
}
.tbl-tip {
  padding: 40rpx 0;
  text-align: center;
  font-size: 25rpx;
  color: var(--t3);
}
.tbl-tip.is-bad {
  color: var(--expense);
}

/* ---------- 每日汇总表：点某天展开当天明细 ---------- */
/* 行被 .tbl-grp 包了一层，.tbl-r:last-child 落不到最后一行头上 ——
   不补这条，最后一行底下会多一道跟合计行重复的线。 */
.tbl-grp:last-child .tbl-r {
  border-bottom: none;
}
/* 展开中的那一行：底色提亮 + 日期变橙，让人一眼知道下面那坨是谁的 */
.tbl-r.is-open {
  background: var(--brand-weak);
}
.tbl-r.is-open .tbl-c1 {
  color: var(--brand-ink);
  font-weight: 600;
}
/* 展开指示列。固定宽度，两张汇总表都留这一列，列宽才对得齐 */
.tbl-cx {
  flex: none;
  width: 34rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.tbl-caret {
  width: 12rpx;
  height: 12rpx;
  border-right: 3rpx solid var(--t4);
  border-bottom: 3rpx solid var(--t4);
  transform: rotate(45deg) translate(-2rpx, -2rpx);
  transition: transform .18s ease;
}
.tbl-caret.up {
  transform: rotate(-135deg) translate(-2rpx, -2rpx);
}

/* 展开出来的当天明细 */
.dd {
  padding: 4rpx 0 14rpx;
  animation: yb-fade .18s ease;
}
.dd-tip {
  padding: 18rpx 0;
  font-size: 25rpx;
  color: var(--t3);
}
.dd-tip.is-bad {
  color: var(--expense);
}
.dd-r {
  display: flex;
  align-items: center;
  padding: 14rpx 0;
  border-bottom: 1rpx dashed var(--line);
}
.dd-r:last-child {
  border-bottom: none;
}
.dd-t {
  flex: none;
  width: 86rpx;
  font-size: 24rpx;
  color: var(--t3);
}
.dd-n {
  flex: 1;
  min-width: 0;
  margin: 0 16rpx;
  font-size: 27rpx;
  color: var(--t1);
}
.dd-a {
  flex: none;
  font-size: 27rpx;
  font-weight: 600;
  text-align: right;
}
.dd-sum {
  padding-top: 12rpx;
  font-size: 24rpx;
  color: var(--t3);
}
