<!--pages/summary/summary.wxml-->
<view class="container" style="{{_cv}}">
  <view class="page-head">
    <view class="page-head-left">
      <view class="page-title">报表</view>
      <view class="page-sub">不用会计，一眼看懂</view>
    </view>
    <view class="page-head-right">
      <view class="export-btn" bindtap="exportExcel">
        <text class="export-btn-text">导出</text>
      </view>
    </view>
  </view>

  <!-- 收支汇总：今日 / 本月 两种口径切换，替代原先「首页弹窗 + 本页卡片」两处重复 -->
  <view class="card sum-card">
    <view class="seg">
      <view class="seg-i {{period === 'yesterday' ? 'is-on' : ''}}" data-p="yesterday" bindtap="pickPeriod">昨日</view>
      <view class="seg-i {{period === 'today' ? 'is-on' : ''}}" data-p="today" bindtap="pickPeriod">今日</view>
      <view class="seg-i {{period === 'month' ? 'is-on' : ''}}" data-p="month" bindtap="pickPeriod">本月</view>
      <view class="seg-i {{period === 'year' ? 'is-on' : ''}}" data-p="year" bindtap="pickPeriod">本年</view>
    </view>

    <view class="sum-hero">
      <text class="sum-hero-k">{{periodLabel}}结余</text>
      <text class="sum-hero-v num {{stat.isPositive ? 'c-income' : 'c-expense'}}">
        {{stat.isPositive ? '+' : '-'}}¥{{stat.netText}}
      </text>
    </view>

    <view class="stat-grid">
      <view class="stat-col">
        <view class="stat-k">收入</view>
        <view class="stat-v num c-income">¥{{stat.incomeText}}</view>
      </view>
      <view class="stat-line"></view>
      <view class="stat-col">
        <view class="stat-k">支出</view>
        <view class="stat-v num c-expense">¥{{stat.expenseText}}</view>
      </view>
    </view>

    <view class="sum-ft">
      <view class="sum-ft-left">
        <text class="sum-count">{{stat.count}} 笔已入账</text>
        <!-- 报表状态 -->
        <view wx:if="{{reportStatus && reportStatus.status === 2}}" class="report-status confirmed">
          <text class="status-dot"></text>
          <text class="status-text">已确认·已锁定</text>
        </view>
        <view wx:elif="{{reportStatus && reportStatus.status === 3}}" class="report-status pending">
          <text class="status-dot"></text>
          <text class="status-text">解锁申请中</text>
        </view>
        <view wx:elif="{{reportStatus && reportStatus.status === 1}}" class="report-status draft">
          <text class="status-dot"></text>
          <text class="status-text">草稿中</text>
        </view>
      </view>
      <view class="sum-ft-acts">
        <!-- 确认报表：经理/店主，草稿状态 -->
        <view wx:if="{{canConfirmReport && reportStatus && reportStatus.status === 1}}" class="confirm-report-btn" bindtap="confirmReport">
          <text>确认报表</text>
        </view>
        <!-- 申请解锁：经理，已确认状态 -->
        <view wx:if="{{myRole === 3 && reportStatus && reportStatus.status === 2}}" class="unlock-btn" bindtap="openUnlock">
          <text>申请解锁</text>
        </view>
        <!-- 取消确认：店主，已确认状态 -->
        <view wx:if="{{myRole === 1 && reportStatus && reportStatus.status === 2}}" class="unconfirm-btn" bindtap="unconfirmReport">
          <text>取消确认</text>
        </view>
        <!-- 日历入口 -->
        <text class="sum-link" wx:if="{{_f && _f.calendar}}" bindtap="toggleCal">{{calOpen ? '收起日历' : (_t.calendarEntry || '按日查询 ›')}}</text>
        <view class="sum-share" wx:if="{{_f && _f.shareReport}}" bindtap="openShare">{{_t.shareBtn || '分享报表'}}</view>
      </view>
    </view>
  </view>

  <!-- ============ 报表日历（默认不出现）============
       整张卡片的开关就是上面那行小字「按日查询」。不点，页面上就没有日历。
       日视图的格子里**只放日期数字 + 收/支色条，不放金额**：
       7 列一格才 96rpx，金额塞进去只能是小字，而这个产品的用户看不清小字。 -->
  <view wx:if="{{calOpen}}" class="card cal-card">
    <!-- 先选粒度、再看时段：分段控件是"换个角度看"，标题栏是"翻到哪一段" -->
    <view class="seg">
      <view class="seg-i {{calBy === 'day' ? 'is-on' : ''}}" data-by="day" bindtap="pickCalBy">按日</view>
      <view class="seg-i {{calBy === 'month' ? 'is-on' : ''}}" data-by="month" bindtap="pickCalBy">按月</view>
      <view class="seg-i {{calBy === 'year' ? 'is-on' : ''}}" data-by="year" bindtap="pickCalBy">按年</view>
    </view>

    <view class="cal-hd">
      <view wx:if="{{calBy !== 'year'}}" class="cal-nav" bindtap="calPrev">‹</view>
      <view wx:else class="cal-nav is-ghost"></view>
      <view class="cal-title">{{calTitle}}</view>
      <view class="cal-nav {{calHasNext ? '' : 'is-off'}}" wx:if="{{calBy !== 'year'}}" bindtap="calNext">›</view>
      <view wx:else class="cal-nav is-ghost"></view>
    </view>

    <view wx:if="{{calBy === 'day'}}" class="cal-week">
      <view class="cal-wd" wx:for="{{calWeek}}" wx:key="*this" wx:for-item="w">{{w}}</view>
    </view>

    <!-- is-{{calBy}} 直接拼出 is-day / is-month / is-year。
         别写成嵌套三元：模板里层层嵌套没人读得懂，静态自检也会把比较值当成类名误报。 -->
    <view class="cal-grid is-{{calBy}}">
      <view
        wx:for="{{calCells}}"
        wx:key="k"
        wx:for-item="c"
        class="cal-cell {{c.blank ? 'is-blank' : ''}} {{c.isToday ? 'is-today' : ''}} {{calSelKey === c.k ? 'is-sel' : ''}}"
        data-k="{{c.k}}"
        bindtap="pickCell"
      >
        <text class="cal-n">{{c.n}}</text>
        <block wx:if="{{!c.blank}}">
          <view wx:if="{{calBy === 'day'}}" class="cal-marks">
            <view wx:if="{{c.income}}" class="cal-mark mk-in"></view>
            <view wx:if="{{c.expense}}" class="cal-mark mk-out"></view>
          </view>
          <view wx:else class="cal-big">
            <block wx:if="{{c.has}}">
              <text wx:if="{{c._income}}" class="cal-big-l c-income num">收 {{c._income}}</text>
              <text wx:if="{{c._expense}}" class="cal-big-l c-expense num">支 {{c._expense}}</text>
            </block>
            <text wx:else class="cal-big-none">—</text>
          </view>
        </block>
      </view>
    </view>

    <view wx:if="{{calLoading}}" class="cal-tip">正在读数据…</view>
    <view wx:elif="{{calFailed}}" class="cal-tip is-bad" bindtap="retryCalendar">没读到，点这里重试</view>
    <view wx:elif="{{calCells.length === 0}}" class="cal-tip">还没有记账</view>

    <view wx:if="{{calBy === 'month'}}" class="cal-now" bindtap="calToday">回到今年</view>
    <view wx:elif="{{calBy === 'day'}}" class="cal-now" bindtap="calToday">回到本月</view>

    <!-- 选中那一格的汇总。**只给汇总，不列每笔** —— 老板要的是"这天收了多少支了多少" -->
    <view wx:if="{{calSel}}" class="cal-sel">
      <view class="cal-sel-hd">
        <text class="cal-sel-d">{{calSel.label}}</text>
        <text class="cal-sel-v num {{calSel._isPositive ? 'c-income' : 'c-expense'}}">{{calSel._net}}</text>
      </view>
      <view class="cal-sel-ft">
        <text>收入 <text class="c-income num">¥{{calSel._income}}</text></text>
        <text class="cal-dot">·</text>
        <text>支出 <text class="c-expense num">¥{{calSel._expense}}</text></text>
        <text class="cal-dot">·</text>
        <text>{{calSel.count}} 笔</text>
      </view>
    </view>
  </view>

  <!-- ============ 每日汇总表（折叠）============
       首屏默认收起，点一下才展开。减少视觉噪音，让用户一眼看到核心数据。 -->
  <view class="list-hd" bindtap="toggleDayTable">
    <view class="list-hd-l">
      <text class="list-hd-t">{{dayTableTitle}}</text>
      <text class="list-hd-hint" wx:if="{{dayTable && dayTable.length}}">{{dayTableOpen ? '点某天看明细' : '点这里展开'}}</text>
    </view>
    <view class="list-hd-arrow {{dayTableOpen ? 'up' : ''}}"></view>
  </view>
  <view class="card card-flush" wx:if="{{dayTableOpen}}">
    <view wx:if="{{dayTableFailed}}" class="tbl-tip is-bad" bindtap="retryDayTable">没读到，点这里重试</view>
    <view wx:elif="{{dayTable && dayTable.length === 0}}" class="tbl-tip">这个月还没有记账</view>
    <block wx:elif="{{dayTable}}">
      <view class="tbl-hd">
        <text class="tbl-c1">日期</text>
        <text class="tbl-c2">收入</text>
        <text class="tbl-c3">支出</text>
        <text class="tbl-c4">结余</text>
        <view class="tbl-cx"></view>
      </view>
      <view class="tbl-grp" wx:for="{{dayTable}}" wx:key="key" wx:for-item="r">
        <view class="tbl-r {{dayOpenKey === r.key ? 'is-open' : ''}}" data-k="{{r.key}}" bindtap="toggleDayRow">
          <text class="tbl-c1">{{r._label}}</text>
          <text class="tbl-c2 num">{{r._income}}</text>
          <text class="tbl-c3 num">{{r._expense}}</text>
          <text class="tbl-c4 num {{r._isPositive ? 'c-income' : 'c-expense'}}">{{r._isPositive ? '+' : '-'}}¥{{r._netAbs}}</text>
          <view class="tbl-cx"><view class="tbl-caret {{dayOpenKey === r.key ? 'up' : ''}}"></view></view>
        </view>

        <!-- 这一天的逐笔。只在这一行被点开时才存在 -->
        <view wx:if="{{dayOpenKey === r.key}}" class="dd">
          <view wx:if="{{dayLoading}}" class="dd-tip">正在读明细…</view>
          <view wx:elif="{{dayFail}}" class="dd-tip is-bad" catchtap="retryDay">没读到，点这里重试</view>
          <block wx:elif="{{dayDetails.length}}">
            <view class="dd-r" wx:for="{{dayDetails}}" wx:key="id" wx:for-item="d">
              <text class="dd-t">{{d.time}}</text>
              <text class="dd-n ellipsis">{{d.title}}</text>
              <text class="dd-a num {{d.cls}}">{{d.amount}}</text>
            </view>
            <view class="dd-sum">{{dayDetails.length}} 笔 · 上面是这一天的全部记录</view>
          </block>
          <view wx:else class="dd-tip">这一天没有记录</view>
        </view>
      </view>
      <view class="tbl-r is-total">
        <text class="tbl-c1">合计</text>
        <text class="tbl-c2 num">{{dayTotal._income}}</text>
        <text class="tbl-c3 num">{{dayTotal._expense}}</text>
        <text class="tbl-c4 num {{dayTotal._isPositive ? 'c-income' : 'c-expense'}}">{{dayTotal._isPositive ? '+' : '-'}}¥{{dayTotal._netAbs}}</text>
        <view class="tbl-cx"></view>
      </view>
    </block>
  </view>

  <!-- 每月汇总表已移除（2026-09-19 用户要求）：
       月度是低频数据，放在报表页只是占地方。要看某个月的账，去「查询」页
       按范围筛（那边有「本月」，并且会按天分组给出每天的收支）。 -->

  <!-- 应收应付 -->
  <view class="card">
    <view class="debt-hd">
      <text class="card-title">往来总览</text>
      <text class="card-more" wx:if="{{_f && _f.shareReport}}" bindtap="shareReconciliation">一键对账 ›</text>
    </view>
    <view class="debt-body">
      <view class="debt-col">
        <view class="debt-k">别人欠我</view>
        <view class="debt-v num c-income">¥{{receivable}}</view>
        <view class="debt-s">{{receivableCount}} 位</view>
      </view>
      <view class="debt-line"></view>
      <view class="debt-col">
        <view class="debt-k">我欠别人</view>
        <view class="debt-v num c-expense">¥{{payable}}</view>
        <view class="debt-s">{{payableCount}} 位</view>
      </view>
    </view>
  </view>

  <!-- 往来明细 -->
  <view class="seg">
    <view class="seg-i {{activeTab === 'receivable' ? 'is-on' : ''}}" data-tab="receivable" bindtap="switchTab">客户应收</view>
    <view class="seg-i {{activeTab === 'payable' ? 'is-on' : ''}}" data-tab="payable" bindtap="switchTab">供应商应付</view>
  </view>

  <view class="card card-flush">
    <view wx:if="{{loading}}" class="pad">
      <view class="skeleton-line" style="width: 46%;"></view>
      <view class="skeleton-line mt-24" style="width: 70%;"></view>
    </view>

    <view wx:elif="{{contactList.length === 0}}" class="empty">
      <image class="empty-ico" src="/images/ic-empty.svg" mode="aspectFit" />
      <view class="empty-title">{{activeTab === 'receivable' ? '还没有客户欠款' : '还没有供应商欠款'}}</view>
      <view class="empty-desc">记一笔带对方名字的账，这里就会自动汇总</view>
      <view class="empty-action" bindtap="goRecord">去记一笔</view>
    </view>

    <block wx:else>
      <view
        wx:for="{{contactList}}"
        wx:key="id"
        class="row row-tap"
        data-id="{{item.id}}"
        bindtap="goToDetail"
      >
        <view class="ct-avatar">{{item._initial}}</view>
        <view class="row-main">
          <view class="row-title">{{item.name}}</view>
          <view class="row-sub">{{item.phone || '未填手机号'}}</view>
        </view>
        <view class="row-val num {{item._cls}}">{{item._amountText}}</view>
        <view class="row-arrow"></view>
      </view>
    </block>
  </view>

  <!-- 生意参谋入口：AI分析是特色功能，从TabBar移到这里，不占主导航位置 -->
  <view class="card advisor-entry" bindtap="goAdvisor">
    <view class="advisor-entry-left">
      <view class="advisor-entry-icon">
        <image class="advisor-entry-icon-img" src="/images/ic-sparkle.svg" mode="aspectFit" />
      </view>
      <view class="advisor-entry-info">
        <view class="advisor-entry-title">生意参谋 <text class="tag tag-brand">AI</text></view>
        <view class="advisor-entry-desc">自动分析经营状况，给你实用建议</view>
      </view>
    </view>
    <view class="advisor-entry-arrow"></view>
  </view>

  <view class="sum-tail"></view>
</view>

<!-- ============ 离屏画布 ============
     报表图在这里画好再导出。必须"真实存在于页面上"——
     2d canvas 用 display:none 就拿不到 node，画不出来。所以挪到屏幕外而不是藏起来。 -->
<canvas
  type="2d"
  id="reportCanvas"
  class="rep-canvas"
  style="width: {{canvasW}}px; height: {{canvasH}}px;"
></canvas>

<!-- ============ 分享报表 ============
     两条路都要有：图片微信里最顺、一屏看完；文字能带全量明细，
     明细多的时候图片塞不下，就靠它兜。 -->
<view class="sheet-mask" wx:if="{{shareSheet}}" bindtap="closeShare" />
<view class="sheet" wx:if="{{shareSheet}}" catchtap="noop">
  <view class="sheet-handle"></view>
  <view class="sheet-hd">
    <text class="sheet-title">分享{{period === 'today' ? '今日' : '本月'}}报表</text>
    <view class="sheet-close" bindtap="closeShare"></view>
  </view>
  <view class="sheet-bd">
    <!-- 20 = 图上最多画几行（summary.js 的 MAX_ROWS）；500 = 明细接口一次的上限。
         超过 500 时不能再承诺"给全量"—— 文字版实际只带得走最近 500 笔，
         说成全量就是虚假承诺，对方拿去对账会差。 -->
    <view class="sh-note">
      带 {{rowCount}} 笔明细{{rowCount > 500 ? '（图片列前 20 笔，文字版列最近 500 笔）' : rowCount > 20 ? '（图片列前 20 笔，其余两条给全量）' : ''}}
    </view>

    <!-- 主路径：把**这个页面**分享出去。对方用微信打开就能看，不用注册。
         token 没备好时按钮不给点 —— 绝不能分享出一个打不开的链接。 -->
    <block wx:if="{{shareReady}}">
      <button class="sh-opt sh-opt-btn" open-type="share">
        <view class="sh-ico sh-ico-key">
          <image class="sh-ico-img" src="/images/ic-brand.svg" mode="aspectFit" />
        </view>
        <view class="sh-main">
          <view class="sh-t">分享这个页面</view>
          <view class="sh-d">对方用微信打开就能看这份报表，不用注册</view>
        </view>
        <view class="row-arrow"></view>
      </button>
    </block>

    <view wx:elif="{{sharePreparing}}" class="sh-opt is-busy">
      <view class="sh-ico sh-ico-key">
        <image class="sh-ico-img" src="/images/ic-brand.svg" mode="aspectFit" />
      </view>
      <view class="sh-main">
        <view class="sh-t">正在准备分享链接…</view>
        <view class="sh-d">马上就好</view>
      </view>
    </view>

    <view wx:else class="sh-opt" bindtap="ensureShareToken">
      <view class="sh-ico sh-ico-key">
        <image class="sh-ico-img" src="/images/ic-brand.svg" mode="aspectFit" />
      </view>
      <view class="sh-main">
        <view class="sh-t">分享这个页面</view>
        <view class="sh-d">上次没准备好，点一下重试</view>
      </view>
      <view class="row-arrow"></view>
    </view>

    <view class="sh-opt {{sharing ? 'is-busy' : ''}}" bindtap="shareAsImage">
      <view class="sh-ico">
        <image class="sh-ico-img" src="/images/ic-scan.svg" mode="aspectFit" />
      </view>
      <view class="sh-main">
        <view class="sh-t">发图片到微信</view>
        <view class="sh-d">汇总 + 明细排成一张图，发出去不用点链接就能看</view>
      </view>
      <view class="row-arrow"></view>
    </view>

    <view class="sh-opt" bindtap="shareAsText">
      <view class="sh-ico">
        <image class="sh-ico-img" src="/images/ic-say.svg" mode="aspectFit" />
      </view>
      <view class="sh-main">
        <view class="sh-t">复制文字</view>
        <view class="sh-d">明细全量不截断，适合粘到表格里逐条核</view>
      </view>
      <view class="row-arrow"></view>
    </view>
  </view>
  <view class="sheet-ft">
    <view class="btn btn-ghost btn-block" bindtap="closeShare">先不分享</view>
  </view>

<!-- ============ 申请解锁弹层 ============ -->
<view wx:if="{{showUnlock}}" class="sheet-mask" bindtap="closeUnlock">
  <view class="sheet-panel unlock-panel" catchtap="noop">
    <view class="sheet-title">申请解锁报表</view>
    <view class="sheet-desc">本月报表已确认并锁定，如需修改请申请解锁，店主批准后即可修改。</view>
    
    <view class="unlock-form">
      <view class="unlock-label">申请原因（选填）</view>
      <textarea 
        class="unlock-textarea" 
        placeholder="例如：有一笔账记错了需要修改"
        value="{{unlockReason}}"
        bindinput="onUnlockReason"
        maxlength="200"
        auto-height
      />
      <view class="unlock-count">{{unlockReason.length}}/200</view>
    </view>

    <view class="sheet-actions">
      <view class="sheet-btn sheet-btn-cancel" bindtap="closeUnlock">取消</view>
      <view class="sheet-btn sheet-btn-confirm {{unlocking ? 'is-loading' : ''}}" bindtap="submitUnlock">
        <text wx:if="{{unlocking}}">提交中...</text>
        <text wx:else>提交申请</text>
      </view>
    </view>
  </view>
</view></view>
