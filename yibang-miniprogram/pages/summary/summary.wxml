<!--pages/summary/summary.wxml-->
<view class="container" style="{{_cv}}">
  <!-- 页内标题改成"信息型"：导航栏已经写着「经营情况」，
       这里再复述一遍等于白占一行 44rpx 大字。
       现在放的是"下面这堆数字是哪个口径的" —— 跟今日/本月切换联动，随切随变。 -->
  <view class="page-head">
    <view class="page-head-left">
      <view class="page-title">{{periodLabel}}账目</view>
      <view class="page-sub">不用会计，一眼看懂</view>
    </view>
    <view class="page-head-right">
      <view class="export-btn" bindtap="exportExcel">
        <text class="export-btn-text">导出</text>
      </view>
    </view>
  </view>

  <!-- 收支汇总：今日 / 本月 两种口径切换，替代原先「首页弹窗 + 本页卡片」两处重复 -->
  <view class="card sum-card">
    <view class="seg">
      <view class="seg-i {{period === 'today' ? 'is-on' : ''}}" data-p="today" bindtap="pickPeriod">今日</view>
      <view class="seg-i {{period === 'month' ? 'is-on' : ''}}" data-p="month" bindtap="pickPeriod">本月</view>
    </view>

    <view class="sum-hero">
      <text class="sum-hero-k">{{periodLabel}}结余</text>
      <text class="sum-hero-v num {{stat.isPositive ? 'c-income' : 'c-expense'}}">
        {{stat.isPositive ? '+' : '-'}}¥{{stat.netText}}
      </text>
    </view>

    <view class="stat-grid">
      <view class="stat-col">
        <view class="stat-k">收入</view>
        <view class="stat-v num c-income">¥{{stat.incomeText}}</view>
      </view>
      <view class="stat-line"></view>
      <view class="stat-col">
        <view class="stat-k">支出</view>
        <view class="stat-v num c-expense">¥{{stat.expenseText}}</view>
      </view>
    </view>

    <view class="sum-ft">
      <view class="sum-ft-left">
        <text class="sum-count">{{stat.count}} 笔已入账</text>
      </view>
    </view>
  </view>

  <!-- 2026-09-22：AI 参谋入口从这里（结余卡正下方）挪到了**整页最底部**，见文件末尾。
       原来它紧贴在「分享报表」主按钮上方，两块橙色上下叠着互相抢；而且
       "看完结余接着追问"这个理由也站不住 —— 老板更常见的动作是先去翻明细。
       挪走之后这一段的阅读顺序回到最简：结论 → 分享 → 钱花在哪 → 明细。 -->

  <!-- 操作按钮区：分享收支报表 -->
  <view class="action-bar">
    <!-- 分享报表 -->
    <view wx:if="{{_f && _f.shareReport}}" class="action-btn action-primary action-btn-full" bindtap="openShare">
      <text>{{_t.shareBtn || '分享报表'}}</text>
    </view>
  </view>

  <!-- ══════ 钱花在哪（品类分布）══════
       2026-09-22 新增。在它之前，报表只能回答"这个月花了多少"这一个总数，
       而老板真正想知道的是"花在哪了" —— 那样才知道下个月该省哪一块。

       三态必须**分开**显示：加载中 / 取不到（可点重试） / 真的没有账。
       把"取不到"画成一张空表，老板会以为账丢了（项目里栽过这类假象）。

       条形长度以**榜首**为基准而不是以总额，并设 6% 下限 ——
       否则第一名占比很高时，后面几项会细成一条看不见的线。 -->
  <view class="card cat-card {{catDir === 'in' ? 'is-in' : 'is-out'}}">
    <view class="cat-hd">
      <text class="card-title">钱花在哪</text>
      <view class="cat-seg">
        <view class="cat-seg-i {{catDir === 'out' ? 'is-on' : ''}}" data-d="out" bindtap="pickCatDir">花了</view>
        <view class="cat-seg-i {{catDir === 'in' ? 'is-on' : ''}}" data-d="in" bindtap="pickCatDir">赚了</view>
      </view>
    </view>
    <view class="cat-sub">{{catLabel}} · {{catDir === 'out' ? '按品类看支出' : '按品类看收入'}}</view>

    <view wx:if="{{catLoading}}" class="cat-loading">
      <view class="skeleton-line" style="width: 100%;"></view>
      <view class="skeleton-line mt-16" style="width: 82%;"></view>
      <view class="skeleton-line mt-16" style="width: 64%;"></view>
    </view>

    <view wx:elif="{{catFailed}}" class="cat-tip is-bad" bindtap="retryCatStat">没读到，点这里重试</view>

    <view wx:elif="{{!catStat || catStat.list.length === 0}}" class="cat-tip">
      {{catDir === 'out' ? '这段时间还没有支出' : '这段时间还没有收入'}}
    </view>

    <block wx:else>
      <view class="cat-row" wx:for="{{catStat.list}}" wx:key="key">
        <view class="cat-top">
          <text class="cat-name ellipsis">{{item.key}}</text>
          <text class="cat-share num">{{item.share}}%</text>
          <text class="cat-amt num">¥{{item.amountText}}</text>
        </view>
        <view class="cat-track">
          <view class="cat-fill" style="width: {{item.pct}}%;"></view>
        </view>
      </view>
      <view class="cat-ft">
        <text>合计 ¥{{catStat.totalText}}</text>
        <text class="cat-dot">·</text>
        <text>{{catStat.count}} 类</text>
      </view>
    </block>
  </view>


  <!-- 功能入口区：按日查询 -->
  <view class="card entry-list">
    <!-- 按日查询 -->
    <view class="entry-row" wx:if="{{_f && _f.calendar}}" bindtap="toggleCal">
      <view class="entry-ico"><image class="entry-ico-img" src="/images/ic-clock-w.svg" mode="aspectFit" /></view>
      <view class="entry-main">
        <view class="entry-title">{{calOpen ? '收起日历' : '按日查询'}}</view>
        <view class="entry-desc">选某一天看当天的收支明细</view>
      </view>
      <view class="entry-arrow"></view>
    </view>

    <!-- 申请解锁：只在「本月报表已被确认锁定」时出现。
         2026-09-22 —— 这块原来是彻底的死代码：openUnlock() 全项目无人调用、
         弹层还被嵌在分享弹层内部（只有分享弹层打开时才可能渲染）、
         连 9 个类名都全项目没有定义。但后端 /reports/request-unlock 一直是好的，
         所以按真实状态把它接上，而不是删掉了事。
         status：1 草稿（不显示）/ 2 已确认锁定（可申请）/ 3 申请中（显示进度、不可再点）。 -->
    <view class="entry-row" wx:if="{{reportStatus && reportStatus.status === 2}}" bindtap="openUnlock">
      <view class="entry-ico"><image class="entry-ico-img" src="/images/ic-lock-open-w.svg" mode="aspectFit" /></view>
      <view class="entry-main">
        <view class="entry-title">申请解锁本月报表</view>
        <view class="entry-desc">本月报表已确认锁定，需要修改请申请解锁</view>
      </view>
      <view class="entry-arrow"></view>
    </view>
    <view class="entry-row is-pending" wx:elif="{{reportStatus && reportStatus.status === 3}}">
      <view class="entry-ico"><image class="entry-ico-img" src="/images/ic-clock-w.svg" mode="aspectFit" /></view>
      <view class="entry-main">
        <view class="entry-title">解锁申请中</view>
        <view class="entry-desc">已提交申请，等店主批准后就能改</view>
      </view>
    </view>
  </view>

  <!-- ============ 报表日历（默认不出现）============
       整张卡片的开关就是上面那行小字「按日查询」。不点，页面上就没有日历。
       日视图的格子里**只放日期数字 + 收/支色条，不放金额**：
       7 列一格才 96rpx，金额塞进去只能是小字，而这个产品的用户看不清小字。 -->
  <view wx:if="{{calOpen}}" class="card cal-card">
    <!-- 先选粒度、再看时段：分段控件是"换个角度看"，标题栏是"翻到哪一段" -->
    <view class="seg">
      <view class="seg-i {{calBy === 'day' ? 'is-on' : ''}}" data-by="day" bindtap="pickCalBy">按日</view>
      <view class="seg-i {{calBy === 'month' ? 'is-on' : ''}}" data-by="month" bindtap="pickCalBy">按月</view>
      <view class="seg-i {{calBy === 'year' ? 'is-on' : ''}}" data-by="year" bindtap="pickCalBy">按年</view>
    </view>

    <view class="cal-hd">
      <view wx:if="{{calBy !== 'year'}}" class="cal-nav" bindtap="calPrev">‹</view>
      <view wx:else class="cal-nav is-ghost"></view>
      <view class="cal-title">{{calTitle}}</view>
      <view class="cal-nav {{calHasNext ? '' : 'is-off'}}" wx:if="{{calBy !== 'year'}}" bindtap="calNext">›</view>
      <view wx:else class="cal-nav is-ghost"></view>
    </view>

    <view wx:if="{{calBy === 'day'}}" class="cal-week">
      <view class="cal-wd" wx:for="{{calWeek}}" wx:key="*this" wx:for-item="w">{{w}}</view>
    </view>

    <!-- is-{{calBy}} 直接拼出 is-day / is-month / is-year。
         别写成嵌套三元：模板里层层嵌套没人读得懂，静态自检也会把比较值当成类名误报。 -->
    <view class="cal-grid is-{{calBy}}">
      <view
        wx:for="{{calCells}}"
        wx:key="k"
        wx:for-item="c"
        class="cal-cell {{c.blank ? 'is-blank' : ''}} {{c.isToday ? 'is-today' : ''}} {{calSelKey === c.k ? 'is-sel' : ''}}"
        data-k="{{c.k}}"
        bindtap="pickCell"
      >
        <text class="cal-n">{{c.n}}</text>
        <block wx:if="{{!c.blank}}">
          <view wx:if="{{calBy === 'day'}}" class="cal-marks">
            <view wx:if="{{c.income}}" class="cal-mark mk-in"></view>
            <view wx:if="{{c.expense}}" class="cal-mark mk-out"></view>
          </view>
          <view wx:else class="cal-big">
            <block wx:if="{{c.has}}">
              <text wx:if="{{c._income}}" class="cal-big-l c-income num">收 {{c._income}}</text>
              <text wx:if="{{c._expense}}" class="cal-big-l c-expense num">支 {{c._expense}}</text>
            </block>
            <text wx:else class="cal-big-none">—</text>
          </view>
        </block>
      </view>
    </view>

    <view wx:if="{{calLoading}}" class="cal-tip">正在读数据…</view>
    <view wx:elif="{{calFailed}}" class="cal-tip is-bad" bindtap="retryCalendar">没读到，点这里重试</view>
    <view wx:elif="{{calCells.length === 0}}" class="cal-tip">还没有记账</view>

    <view wx:if="{{calBy === 'month'}}" class="cal-now" bindtap="calToday">回到今年</view>
    <view wx:elif="{{calBy === 'day'}}" class="cal-now" bindtap="calToday">回到本月</view>

    <!-- 选中那一格的汇总。**只给汇总，不列每笔** —— 老板要的是"这天收了多少支了多少" -->
    <view wx:if="{{calSel}}" class="cal-sel">
      <view class="cal-sel-hd">
        <text class="cal-sel-d">{{calSel.label}}</text>
        <text class="cal-sel-v num {{calSel._isPositive ? 'c-income' : 'c-expense'}}">{{calSel._net}}</text>
      </view>
      <view class="cal-sel-ft">
        <text>收入 <text class="c-income num">¥{{calSel._income}}</text></text>
        <text class="cal-dot">·</text>
        <text>支出 <text class="c-expense num">¥{{calSel._expense}}</text></text>
        <text class="cal-dot">·</text>
        <text>{{calSel.count}} 笔</text>
      </view>
      <view class="cal-sel-share" bindtap="shareSelectedDay">
        <image class="cal-sel-share-ico" src="/images/ic-share-w.svg" mode="aspectFit" />
        <text>分享这天报表</text>
      </view>
    </view>
  </view>

  <!-- 应收应付卡片：往来情况 -->
  <view class="card debt-card">
    <view class="debt-col" bindtap="goContacts">
      <view class="debt-k">别人欠我的</view>
      <view class="debt-v num c-income">¥{{receivable}}</view>
      <view class="debt-s">{{receivableCount}} 位往来 ›</view>
    </view>
    <view class="debt-line"></view>
    <view class="debt-col" bindtap="goContacts">
      <view class="debt-k">我欠别人的</view>
      <view class="debt-v num c-expense">¥{{payable}}</view>
      <view class="debt-s">{{payableCount}} 位往来 ›</view>
    </view>
  </view>


  <!-- 搜索账目入口 -->
  <view class="card entry-list">
    <view class="entry-row" bindtap="goSearch">
      <view class="entry-ico"><image class="entry-ico-img" src="/images/ic-search-w.svg" mode="aspectFit" /></view>
      <view class="entry-main">
        <view class="entry-title">搜索账目</view>
        <view class="entry-desc">搜人名、事由、金额，快速找到记录</view>
      </view>
      <view class="entry-arrow"></view>
    </view>
  </view>

  <!-- 每月汇总表已移除（2026-09-19 用户要求）：
       月度是低频数据，放在报表页只是占地方。要看某个月的账，去「查询」页
       按范围筛（那边有「本月」，并且会按天分组给出每天的收支）。 -->

  <!-- AI 参谋入口在 2026-09-22 从本页**撤掉**了：
       它已经提成 tabBar 的第 3 个 tab（记账 / 报表 / AI 参谋 / 我的），
       底部常驻、随时可点。这里再留一个就是重复入口 ——
       而且原来它紧挨着「分享报表」主按钮，两块橙色上下叠着互相抢。
       本页的阅读顺序回到最简：结论 → 分享 → 钱花在哪 → 明细。 -->


  <view class="sum-tail"></view>
</view>

<!-- ============ 离屏画布 ============
     报表图在这里画好再导出。必须"真实存在于页面上"——
     2d canvas 用 display:none 就拿不到 node，画不出来。所以挪到屏幕外而不是藏起来。 -->
<canvas
  type="2d"
  id="reportCanvas"
  class="rep-canvas"
  style="width: {{canvasW}}px; height: {{canvasH}}px;"
></canvas>

<!-- ============ 分享报表 ============
     两条路都要有：图片微信里最顺、一屏看完；文字能带全量明细，
     明细多的时候图片塞不下，就靠它兜。 -->
<view class="sheet-mask" wx:if="{{shareSheet}}" bindtap="closeShare" />
<view class="sheet" wx:if="{{shareSheet}}" catchtap="noop">
  <view class="sheet-handle"></view>
  <view class="sheet-hd">
    <text class="sheet-title">分享报表</text>
    <view class="sheet-close" bindtap="closeShare"></view>
  </view>
  <view class="sheet-bd">
    <!-- 20 = 图上最多画几行（summary.js 的 MAX_ROWS）；500 = 明细接口一次的上限。
         超过 500 时不能再承诺"给全量"—— 文字版实际只带得走最近 500 笔，
         说成全量就是虚假承诺，对方拿去对账会差。 -->
    <view class="sh-note">
      带 {{rowCount}} 笔明细{{rowCount > 500 ? '（图片列前 20 笔，文字版列最近 500 笔）' : rowCount > 20 ? '（图片列前 20 笔，其余两条给全量）' : ''}}
    </view>

    <!-- 主路径：把**这个页面**分享出去。对方用微信打开就能看，不用注册。
         token 没备好时按钮不给点 —— 绝不能分享出一个打不开的链接。 -->
    <block wx:if="{{shareReady}}">
      <button class="sh-opt sh-opt-btn" open-type="share">
        <view class="sh-ico sh-ico-key">
          <image class="sh-ico-img" src="/images/ic-brand.svg" mode="aspectFit" />
        </view>
        <view class="sh-main">
          <view class="sh-t">分享这个页面</view>
          <view class="sh-d">对方用微信打开就能看这份报表，不用注册</view>
        </view>
        <view class="row-arrow"></view>
      </button>
    </block>

    <view wx:elif="{{sharePreparing}}" class="sh-opt is-busy">
      <view class="sh-ico sh-ico-key">
        <image class="sh-ico-img" src="/images/ic-brand.svg" mode="aspectFit" />
      </view>
      <view class="sh-main">
        <view class="sh-t">正在准备分享链接…</view>
        <view class="sh-d">马上就好</view>
      </view>
    </view>

    <view wx:else class="sh-opt" bindtap="ensureShareToken">
      <view class="sh-ico sh-ico-key">
        <image class="sh-ico-img" src="/images/ic-brand.svg" mode="aspectFit" />
      </view>
      <view class="sh-main">
        <view class="sh-t">分享这个页面</view>
        <view class="sh-d">上次没准备好，点一下重试</view>
      </view>
      <view class="row-arrow"></view>
    </view>

    <view class="sh-opt {{sharing ? 'is-busy' : ''}}" bindtap="shareAsImage">
      <view class="sh-ico">
        <image class="sh-ico-img" src="/images/ic-image.svg" mode="aspectFit" />
      </view>
      <view class="sh-main">
        <view class="sh-t">发图片到微信</view>
        <view class="sh-d">汇总 + 明细排成一张图，发出去不用点链接就能看</view>
      </view>
      <view class="row-arrow"></view>
    </view>

    <view class="sh-opt" bindtap="shareAsText">
      <view class="sh-ico">
        <image class="sh-ico-img" src="/images/ic-copy.svg" mode="aspectFit" />
      </view>
      <view class="sh-main">
        <view class="sh-t">复制文字</view>
        <view class="sh-d">明细全量不截断，适合粘到表格里逐条核</view>
      </view>
      <view class="row-arrow"></view>
    </view>
  </view>
  <view class="sheet-ft">
    <view class="btn btn-ghost btn-block" bindtap="closeShare">先不分享</view>
  </view>
</view>

<!-- ============ 申请解锁弹层 ============
     2026-09-22 重写，修掉三重毛病：
     ① 位置 —— 原来它被写在上面那个「分享弹层」的 <view class="sheet"> **内部**，
        只有 shareSheet 为真时才可能被渲染（分享弹层没开时，申请解锁永远不出现）。
        现在与分享弹层同级、独立开关。
     ② 形态 —— 原来是 .sheet-panel 居中弹窗，与全站"底部弹层优先"的规范不一致。
     ③ 样式 —— sheet-panel / unlock-panel / sheet-btn / sheet-actions / unlock-form /
        unlock-label / sheet-desc 这 9 个类名**全项目都没有定义**，
        真渲染出来会是一个没有样式的裸块。改用 .sheet / .sheet-bd / .sheet-ft 标准件。
     入口见上方「申请解锁本月报表」那一行（按 reportStatus.status === 2 显示）。 -->
<view class="sheet-mask" wx:if="{{showUnlock}}" bindtap="closeUnlock" />
<!-- --kb-lift：这里有个 textarea，键盘弹起时必须整层上挪，否则「提交申请」够不着 -->
<view class="sheet" wx:if="{{showUnlock}}" style="--kb-lift: {{kbLift}}px;">
  <view class="sheet-handle"></view>
  <view class="sheet-hd">
    <text class="sheet-title">申请解锁报表</text>
    <view class="sheet-close" bindtap="closeUnlock"></view>
  </view>

  <view class="sheet-bd">
    <view class="sh-note">本月报表已确认锁定。提交申请后，店主批准就能改。</view>

    <view class="f-block">
      <view class="f-label">申请原因（选填）</view>
      <textarea
        class="unlock-textarea"
        placeholder="例如：有一笔账记错了，需要改一下"
        placeholder-class="ph"
        value="{{unlockReason}}"
        bindinput="onUnlockReason"
        bindfocus="onKbFocus"
        bindblur="onKbBlur"
        bindkeyboardheightchange="onKbHeight"
        maxlength="200"
        auto-height
      />
      <view class="unlock-count">{{unlockReason.length}}/200</view>
    </view>
  </view>

  <view class="sheet-ft">
    <view class="btn btn-ghost" bindtap="closeUnlock">取消</view>
    <view class="btn btn-primary {{unlocking ? 'is-disabled' : ''}}" bindtap="submitUnlock">
      {{unlocking ? '提交中…' : '提交申请'}}
    </view>
  </view>
</view>
