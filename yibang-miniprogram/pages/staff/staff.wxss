/* pages/staff/staff.wxss */

.me-row {
  display: flex;
  align-items: center;
}
.me-row-line {
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--line);
}
.me-row-line:last-child {
  border-bottom: none;
}
.av {
  width: 92rpx;
  height: 92rpx;
  border-radius: 50%;
  background: var(--fill);
  color: var(--t2);
  font-size: 34rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
  flex-shrink: 0;
}
.av-boss {
  background: var(--brand-weak);
  color: var(--brand-ink);
  font-size: 40rpx;
}
.me-main {
  flex: 1;
  min-width: 0;
}
.me-name {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--t1);
}
.me-sub {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: var(--t3);
}

/* 待审核：左侧色条 + 高识别度，老板一眼看到 */
.audit-card {
  display: flex;
  align-items: center;
  border-left: 8rpx solid var(--warn);
  background: linear-gradient(100deg, #FFFBF4 0%, #FFFFFF 60%);
}
.audit-card:active {
  opacity: .82;
}
.audit-ico {
  width: 44rpx;
  height: 44rpx;
  margin-right: 22rpx;
}
.audit-main {
  flex: 1;
  min-width: 0;
}
.audit-t {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--t1);
}
.audit-d {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: var(--t3);
}

.staff-tip {
  padding: 8rpx 12rpx;
  font-size: 24rpx;
  color: var(--t4);
  line-height: 1.7;
}

/* 底部固定操作栏 */
.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 20rpx 32rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: #fff;
  box-shadow: 0 -2rpx 12rpx rgba(0,0,0,0.06);
  z-index: 100;
}

.bottom-bar .btn {
  width: 100%;
}

/* 页面底部留白，避免内容被底部栏遮挡 */
.container-page {
  padding-bottom: 140rpx;
}
