/* pages/promote/promote.wxss —— 推广赚钱 */

/* 进度卡：把「还差几个人」放大放亮，其余信息压到次要层级 */
.pg-card {
  background: linear-gradient(160deg, #FFFFFF 0%, #FFF8F4 100%);
}
.pg-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}
.pg-num {
  display: flex;
  align-items: baseline;
}
.pg-cur {
  font-size: 72rpx;
  font-weight: 700;
  color: var(--brand-ink);
  line-height: 1;
}
.pg-total {
  margin-left: 10rpx;
  font-size: 28rpx;
  color: var(--t3);
}
.pg-badge {
  height: 56rpx;
  padding: 0 26rpx;
  border-radius: var(--r-full);
  background: var(--warn-weak);
  color: var(--warn);
  font-size: 25rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
}
.pg-badge.done {
  background: var(--income-weak);
  color: var(--income);
}
.pg-bar {
  height: 20rpx;
  border-radius: 10rpx;
  background: var(--fill);
  overflow: hidden;
}
.pg-fill {
  height: 100%;
  border-radius: 10rpx;
  background: linear-gradient(90deg, #E4551D, #C9451A);
  transition: width .4s cubic-bezier(.32, .72, 0, 1);
}
.pg-tip {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: var(--t3);
}

/* 规则 */
.rule {
  display: flex;
  align-items: flex-start;
  padding: 16rpx 0;
}
.rule-no {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: var(--brand-weak);
  color: var(--brand-ink);
  font-size: 24rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  flex-shrink: 0;
}
.rule-t {
  flex: 1;
  font-size: 28rpx;
  color: var(--t2);
  line-height: 1.6;
  padding-top: 6rpx;
}

/* 原生 button 复位后再套 .btn 的视觉（.bottom-bar .btn 已给 flex:1） */
.btn-share {
  margin: 0;
  padding: 0;
  line-height: normal;
  border: none;
  font-weight: 600;
}
button.btn-share::after {
  border: none;
}

/* ---------------- 海报：离屏画布 ---------------- */
/* ⚠️ 2d canvas 用 display:none 拿不到 node（wx.createSelectorQuery 查不到尺寸），
   画不出来 —— 所以必须**挪到屏幕外**，而不是藏起来。 */
.ps-canvas {
  position: fixed;
  left: -9999rpx;
  top: 0;
  z-index: -1;
}

/* ---------------- 海报预览弹层 ---------------- */
/* 海报是竖长图，弹层要比常规 .sheet 更高，给图留够可视面积；
   底部两个按钮固定在 .sheet-ft（公共层）里，这里只负责中间那块可滚动区。 */
.ps-sheet {
  max-height: 92vh;
}
.ps-bd {
  text-align: center;
}
.ps-img {
  display: block;
  width: 100%;
  border-radius: var(--r-md);
  background: var(--fill);
}
.ps-hint {
  margin: 20rpx 0 8rpx;
  font-size: 24rpx;
  color: var(--t3);
  line-height: 1.6;
  text-align: left;
}

/* ---------------- 「扫一扫试扫」入口 ---------------- */
/* 整行可点。规格与分享弹层里的 .sh-opt 一致：左侧图标 + 主副文案 + 右箭头。 */
.ps-scan {
  display: flex;
  align-items: center;
  min-height: 112rpx;
  margin-top: 16rpx;
  padding: 0 24rpx;
  border-radius: var(--r-md);
  background: var(--card);
  border: 1rpx solid var(--line);
  text-align: left;
}
.ps-scan-hover,
.ps-scan:active {
  background: var(--fill);
}
.ps-scan-ico {
  width: 44rpx;
  height: 44rpx;
  flex: none;
  margin-right: 20rpx;
}
.ps-scan-main {
  flex: 1;
  min-width: 0;      /* 必须：副文案长了会把右箭头挤出去 */
}
.ps-scan-t {
  display: block;
  font-size: 29rpx;
  font-weight: 600;
  color: var(--t1);
}
.ps-scan-sub {
  display: block;
  margin-top: 4rpx;
  font-size: 24rpx;
  color: var(--t3);
}
.ps-scan-arrow {
  width: 16rpx;
  height: 16rpx;
  flex: none;
  margin-left: 16rpx;
  border-top: 2rpx solid var(--t4);
  border-right: 2rpx solid var(--t4);
  transform: rotate(45deg);
}
