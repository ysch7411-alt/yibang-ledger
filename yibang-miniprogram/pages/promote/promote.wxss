/* pages/promote/promote.wxss —— 推广赚钱 */

/* 进度卡：把「还差几个人」放大放亮，其余信息压到次要层级 */
.pg-card {
  background: linear-gradient(160deg, #FFFFFF 0%, #FFF8F4 100%);
}
.pg-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}
.pg-num {
  display: flex;
  align-items: baseline;
}
.pg-cur {
  font-size: 72rpx;
  font-weight: 700;
  color: var(--brand-ink);
  line-height: 1;
}
.pg-total {
  margin-left: 10rpx;
  font-size: 28rpx;
  color: var(--t3);
}
.pg-badge {
  height: 56rpx;
  padding: 0 26rpx;
  border-radius: var(--r-full);
  background: var(--warn-weak);
  color: var(--warn);
  font-size: 25rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
}
.pg-badge.done {
  background: var(--income-weak);
  color: var(--income);
}
.pg-bar {
  height: 20rpx;
  border-radius: 10rpx;
  background: var(--fill);
  overflow: hidden;
}
.pg-fill {
  height: 100%;
  border-radius: 10rpx;
  background: linear-gradient(90deg, #E4551D, #C9451A);
  transition: width .4s cubic-bezier(.32, .72, 0, 1);
}
.pg-tip {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: var(--t3);
}

/* 规则 */
.rule {
  display: flex;
  align-items: flex-start;
  padding: 16rpx 0;
}
.rule-no {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: var(--brand-weak);
  color: var(--brand-ink);
  font-size: 24rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  flex-shrink: 0;
}
.rule-t {
  flex: 1;
  font-size: 28rpx;
  color: var(--t2);
  line-height: 1.6;
  padding-top: 6rpx;
}

/* 原生 button 复位后再套 .btn 的视觉（.bottom-bar .btn 已给 flex:1）。
   不复位的话 button 自带的 padding / line-height 会让文字不居中。 */
.bottom-bar .btn {
  margin: 0;
  padding: 0;
  line-height: normal;
  border: none;
  font-weight: 600;
}

/* ---------- 分销海报 ---------- */
/* 离屏画布：必须真实存在且可渲染，2d canvas 用 display:none 拿不到 node，画不出来 */
.ps-canvas {
  position: fixed;
  left: -9999px;
  top: 0;
  z-index: -1;
}

/* 本页是从「我的」navigateTo 打开的二级页，**没有 TabBar**。
   .sheet 默认停在 bottom: var(--tabbar-h)，在这一页会凭空悬空 108rpx、
   底边露出下面的内容 —— 压回屏幕底部。 */
.ps-sheet {
  bottom: 0;
}

/* 海报约 750×1200，弹层里放不下，要能上下滚 */
.ps-bd {
  overflow-y: auto;
}
.ps-img {
  display: block;
  width: 100%;
  border-radius: var(--r-md);
  background: var(--fill);
}
.ps-hint {
  padding: 18rpx 0 12rpx;
  text-align: center;
  font-size: 24rpx;
  color: var(--t3);
}

/* 扫一扫试扫入口：小程序里长按图识别不了码，给一个显式的 scanCode 入口 */
.ps-scan {
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin: 0 0 8rpx;
  padding: 20rpx 24rpx;
  background: var(--brand-weak);
  border: 1rpx solid var(--brand-line);
  border-radius: var(--r-md);
}
.ps-scan-hover {
  opacity: .85;
}
.ps-scan-ico {
  width: 40rpx;
  height: 40rpx;
  flex: none;
}
.ps-scan-main {
  flex: 1;
  min-width: 0;
}
.ps-scan-t {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--brand-ink);
}
.ps-scan-sub {
  display: block;
  margin-top: 2rpx;
  font-size: 22rpx;
  color: var(--t3);
}
.ps-scan-arrow {
  width: 14rpx;
  height: 14rpx;
  flex: none;
  border-top: 3rpx solid var(--t4);
  border-right: 3rpx solid var(--t4);
  transform: rotate(45deg);
}
