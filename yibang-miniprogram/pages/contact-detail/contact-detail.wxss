/* pages/contact-detail/contact-detail.wxss —— 往来对象详情（对账单）
   ⚠️ 本文件在 2026-09-23 的一次批量脚本事故中丢失了绝大部分内容，下面为重建版。
   重建依据：① 页面 wxml 的实际结构与类名（唯一权威）；② app.wxss 的令牌与公共类。

   注意：从 9-19 快照恢复回来的那版用的是 `.ct-*` 命名，而**当前 wxml 已经改成
   `.info-*` / `.record-*`**（这一页重做过）—— 那批 `.ct-*` 是死代码，已随重建一并删除。 */

/* ---------------- 往来对象信息卡 ---------------- */
/* 头像 + 名字/类型 + 右侧余额。这是整页最重要的信息，放在最上面。 */
.info-card {
  display: flex;
  align-items: center;
  padding: 32rpx;
  background: var(--card);
  border-radius: var(--r-lg);
  box-shadow: var(--sh-card);
}
.info-avatar {
  width: 96rpx;
  height: 96rpx;
  flex: none;
  margin-right: 22rpx;
  border-radius: 50%;
  background: var(--brand-weak);
  color: var(--brand-ink);
  font-size: 38rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}
.info-main {
  flex: 1;
  min-width: 0;      /* 必须：名字长时右侧余额不能被挤出去 */
}
.info-name {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--t1);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.info-type {
  margin-top: 6rpx;
  font-size: 25rpx;
  color: var(--t3);
}
.info-balance {
  flex: none;
  margin-left: 20rpx;
  text-align: right;
}
.balance-v {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--t1);
}
.balance-label {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: var(--t3);
}

/* ---------------- 分享对账单 ---------------- */
/* 这一页最主要的动作（老板打开多半就是想把这个数发给对方核一下），
   所以放在信息卡正下方，做成一个整行可点的浅橙条。 */
.stmt-share {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 96rpx;
  margin-top: 24rpx;
  padding: 0 28rpx;
  border-radius: var(--r-lg);
  background: var(--brand-weak);
  border: 2rpx solid var(--brand-line);
  color: var(--brand-ink);
  font-size: 29rpx;
  font-weight: 600;
}
.stmt-share:active {
  opacity: .88;
}
.stmt-share-ico {
  width: 34rpx;
  height: 34rpx;
  margin-right: 12rpx;
  flex: none;
}

/* ---------------- 联系信息 ---------------- */
.contact-info-card {
  margin-top: 24rpx;
  padding: 8rpx 32rpx;
}
.info-row {
  display: flex;
  align-items: flex-start;
  padding: 22rpx 0;
}
.info-row + .info-row {
  border-top: 1rpx solid var(--line);
}
.info-row-k {
  flex: none;
  width: 120rpx;
  font-size: 27rpx;
  color: var(--t3);
}
.info-row-v {
  flex: 1;
  min-width: 0;
  font-size: 29rpx;
  color: var(--t1);
  word-break: break-all;
}

/* ---------------- 往来记录 ---------------- */
.record-list {
  background: var(--card);
  border-radius: var(--r-lg);
  box-shadow: var(--sh-card);
  overflow: hidden;
}
.record-item {
  display: flex;
  align-items: center;
  padding: 24rpx 28rpx;
}
.record-item:active {
  background: var(--fill);
}
.record-item + .record-item {
  border-top: 1rpx solid var(--line);
}
.record-left {
  flex: 1;
  min-width: 0;      /* 必须：事由长时右侧金额不能被挤出去 */
}
.record-content {
  font-size: 29rpx;
  color: var(--t1);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
/* 类型标签（应收/回款/应付/付款/收入/支出）：
   底色与文字色由全站 .tag-* 决定（wxml 里传的是 item.typeTag），这里只收紧尺寸 ——
   记录行里的标签要小一号，不能跟正文抢。 */
.record-tag {
  margin-right: 12rpx;
  padding: 2rpx 12rpx;
  font-size: 22rpx;
  vertical-align: 2rpx;
}
.record-date {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: var(--t3);
}
.record-right {
  flex: none;
  margin-left: 20rpx;
  text-align: right;
}
.record-amount {
  font-size: 31rpx;
  font-weight: 600;
  color: var(--t1);
}

/* ---------------- 页尾留白 ---------------- */
.bottom-space {
  height: 40rpx;
}
