/* pages/contact-detail/contact-detail.wxss */

/* ---------- 信息卡 ---------- */
.info-card {
  display: flex;
  align-items: center;
  padding: 36rpx;
  margin: 24rpx;
  background: linear-gradient(140deg, #E4551D 0%, #C9451A 100%);
  border-radius: 24rpx;
  box-shadow: 0 16rpx 36rpx -18rpx rgba(201, 69, 26, .7);
  position: relative;
  overflow: hidden;
}
.info-card::before {
  content: "";
  position: absolute;
  top: -40rpx;
  right: -40rpx;
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(255,255,255,.15) 0%, transparent 70%);
  pointer-events: none;
}
.info-avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: rgba(255,255,255,.25);
  color: #FFFFFF;
  font-size: 40rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
  flex-shrink: 0;
}
.info-main {
  flex: 1;
  min-width: 0;
}
.info-name {
  font-size: 36rpx;
  font-weight: 700;
  color: #FFFFFF;
  margin-bottom: 8rpx;
}
.info-type {
  font-size: 24rpx;
  color: rgba(255,255,255,.8);
}
.info-balance {
  text-align: right;
  flex-shrink: 0;
}
.info-balance .balance-v {
  font-size: 40rpx;
  font-weight: 700;
  color: #FFFFFF;
  margin-bottom: 6rpx;
}
.info-balance .balance-label {
  font-size: 22rpx;
  color: rgba(255,255,255,.8);
}

/* ---------- 联系信息卡 ---------- */
.contact-info-card {
  margin: 0 24rpx 24rpx;
  padding: 8rpx 24rpx;
}
.info-row {
  display: flex;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #F2F4F7;
}
.info-row:last-child {
  border-bottom: none;
}
.info-row-k {
  width: 100rpx;
  font-size: 26rpx;
  color: #98A2B3;
  flex-shrink: 0;
}
.info-row-v {
  flex: 1;
  font-size: 28rpx;
  color: #344054;
}

/* ---------- 分类标题 ---------- */
.section-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #98A2B3;
  padding: 16rpx 36rpx;
  letter-spacing: 1rpx;
}

/* ---------- 记录列表 ---------- */
.record-list {
  padding: 0 24rpx;
}
.record-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 24rpx;
  margin-bottom: 12rpx;
  background: #FFFFFF;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 12rpx -6rpx rgba(16, 24, 40, .06);
}
.record-left {
  flex: 1;
  min-width: 0;
}
.record-content {
  font-size: 28rpx;
  color: #101828;
  margin-bottom: 6rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.record-date {
  font-size: 22rpx;
  color: #98A2B3;
}
.record-right {
  flex-shrink: 0;
  margin-left: 16rpx;
}
.record-amount {
  font-size: 30rpx;
  font-weight: 600;
}

/* ---------- 空状态 ---------- */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 60rpx;
}
.empty-icon {
  width: 140rpx;
  height: 140rpx;
  margin-bottom: 24rpx;
  opacity: 0.5;
}
.empty-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #344054;
  margin-bottom: 10rpx;
}
.empty-desc {
  font-size: 24rpx;
  color: #98A2B3;
  text-align: center;
}

.bottom-space {
  height: 60rpx;
}