<!--pages/contact-detail/contact-detail.wxml-->
<view class="container container-page" style="{{_cv}}">

  <!-- 往来对象信息卡 -->
  <view class="info-card">
    <view class="info-avatar">{{contact.initial}}</view>
    <view class="info-main">
      <view class="info-name">{{contact.name}}</view>
      <view class="info-type">{{contact.type === 1 ? '客户' : '供应商'}}</view>
    </view>
    <view class="info-balance">
      <view class="balance-v num {{contact.balance > 0 ? 'c-income' : (contact.balance < 0 ? 'c-expense' : '')}}">
        {{contact.balance > 0 ? '+' : (contact.balance < 0 ? '-' : '')}}¥{{balanceText}}
      </view>
      <view class="balance-label">{{contact.balance > 0 ? '应收' : (contact.balance < 0 ? '应付' : '已结清')}}</view>
    </view>
  </view>

  <!-- 分享对账单：这一页最主要的动作 —— 老板打开这个页面，
       十有八九就是想把这个数发给对方核一下。所以放在信息卡正下方。 -->
  <view class="stmt-share" bindtap="openShare">
    <image class="stmt-share-ico" src="/images/ic-share.svg" mode="aspectFit" />
    <text>分享对账单给{{contact.type === 1 ? '客户' : '供应商'}}</text>
  </view>

  <!-- 联系信息 -->
  <view wx:if="{{contact.phone || contact.remark}}" class="card contact-info-card">
    <view wx:if="{{contact.phone}}" class="info-row">
      <text class="info-row-k">电话</text>
      <text class="info-row-v">{{contact.phone}}</text>
    </view>
    <view wx:if="{{contact.remark}}" class="info-row">
      <text class="info-row-k">备注</text>
      <text class="info-row-v">{{contact.remark}}</text>
    </view>
  </view>

  <!-- 往来记录 -->
  <view class="section-title">交易记录</view>

  <view wx:if="{{records.length}}" class="record-list">
    <view class="record-item" wx:for="{{records}}" wx:key="id">
      <view class="record-left">
        <view class="record-content">
          <text class="tag record-tag {{item.typeTag}}">{{item.typeText}}</text>{{item.content || item.typeText}}
        </view>
        <view class="record-date">{{item.dateText}}</view>
      </view>
      <view class="record-right">
        <!-- 金额符号与颜色统一走全站的 TYPE_STYLE（原来只判 type === 1，
             应收/回款/应付/付款全被画成红色减号） -->
        <view class="record-amount num {{item.typeCls}}">{{item.sign}}¥{{item.amountText}}</view>
      </view>
    </view>
  </view>

  <!-- 空状态：并入全站公共 .empty 体系（原来自己写了一套 .empty-state/.empty-icon） -->
  <view wx:else class="empty">
    <image class="empty-ico" src="/images/ic-empty.svg" mode="aspectFit" />
    <view class="empty-title">暂无往来记录</view>
    <view class="empty-desc">记账时选择这个往来对象，记录会自动出现在这里</view>
  </view>

  <view class="bottom-space"></view>
</view>

<!-- ============ 分享对账单 ============
     为什么主推"分享这个页面"而不是生成长图：
     对账单是给对方**核对**用的，他要从头看到尾、以后还可能回头再翻；
     页面能全量、能滚动；图片一生成内容就冻结了，长图在微信里预览还很差。
     图片只在"对方只想瞄一眼"时才合适 —— 所以这里不做图片。 -->
<view class="sheet-mask" wx:if="{{shareSheet}}" bindtap="closeShare" />
<view class="sheet" wx:if="{{shareSheet}}" catchtap="noop">
  <view class="sheet-handle"></view>
  <view class="sheet-hd">
    <text class="sheet-title">分享对账单</text>
    <view class="sheet-close" bindtap="closeShare"></view>
  </view>
  <view class="sheet-bd">
    <view class="sh-note">
      <text>{{contact.name}}</text>
      <text wx:if="{{asOfText}}"> · 截至 {{asOfText}}</text>
      <text> · {{records.length}} 笔往来</text>
    </view>

    <!-- 分享这个页面：token 备好才可点。没备好就绝不给点 ——
         分享出一个打不开的链接，比不分享更伤。 -->
    <block wx:if="{{shareReady}}">
      <button class="sh-opt sh-opt-btn" open-type="share">
        <view class="sh-ico sh-ico-key">
          <image class="sh-ico-img" src="/images/ic-brand.svg" mode="aspectFit" />
        </view>
        <view class="sh-main">
          <view class="sh-t">分享这个页面</view>
          <view class="sh-d">对方用微信打开就能看这份对账单，不用注册</view>
        </view>
        <view class="row-arrow"></view>
      </button>
    </block>

    <view wx:elif="{{sharePreparing}}" class="sh-opt is-busy">
      <view class="sh-ico sh-ico-key">
        <image class="sh-ico-img" src="/images/ic-brand.svg" mode="aspectFit" />
      </view>
      <view class="sh-main">
        <view class="sh-t">正在准备分享链接…</view>
        <view class="sh-d">马上就好</view>
      </view>
    </view>

    <view wx:else class="sh-opt" bindtap="ensureShareToken">
      <view class="sh-ico sh-ico-key">
        <image class="sh-ico-img" src="/images/ic-brand.svg" mode="aspectFit" />
      </view>
      <view class="sh-main">
        <view class="sh-t">分享这个页面</view>
        <view class="sh-d">上次没准备好，点一下重试</view>
      </view>
      <view class="row-arrow"></view>
    </view>

    <view class="sh-opt" bindtap="copyStatement">
      <view class="sh-ico">
        <image class="sh-ico-img" src="/images/ic-copy.svg" mode="aspectFit" />
      </view>
      <view class="sh-main">
        <view class="sh-t">复制文字</view>
        <view class="sh-d">适合对方要粘进表格逐条核</view>
      </view>
      <view class="row-arrow"></view>
    </view>
  </view>
</view>