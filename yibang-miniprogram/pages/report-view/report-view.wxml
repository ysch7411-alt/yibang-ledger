<!--pages/report-view/report-view.wxml-->
<view class="container container-page" style="{{_cv}}">
  <!-- ===== 没带 token：链接被截断了 ===== -->
  <view wx:if="{{state === 'no-token'}}" class="card">
    <view class="empty">
      <image class="empty-ico" src="/images/ic-info.svg" mode="aspectFit" />
      <view class="empty-title">链接打不开了</view>
      <view class="empty-desc">转发的时候链接断了，让对方重新发一次就行</view>
    </view>
  </view>

  <!-- ===== 链接失效：过期 / 被关掉 ===== -->
  <view wx:elif="{{state === 'not-found'}}" class="card">
    <view class="empty">
      <image class="empty-ico" src="/images/ic-clock.svg" mode="aspectFit" />
      <view class="empty-title">这份报表过期了</view>
      <view class="empty-desc">分享的报表有时间限制，让对方重新发一份就行</view>
    </view>
  </view>

  <!-- ===== 网络没通：跟上面两件事完全不同，要能重试 ===== -->
  <view wx:elif="{{state === 'failed'}}" class="card">
    <view class="empty">
      <image class="empty-ico" src="/images/ic-empty.svg" mode="aspectFit" />
      <view class="empty-title">没加载出来</view>
      <view class="empty-desc">网络不太好，点一下再试</view>
      <view class="empty-action" bindtap="retry">重新加载</view>
    </view>
  </view>

  <!-- ===== 加载中 ===== -->
  <view wx:elif="{{loading}}" class="card">
    <view class="skeleton-line" style="width: 48%;"></view>
    <view class="skeleton-line mt-24" style="width: 72%;"></view>
    <view class="skeleton-line mt-16" style="width: 60%;"></view>
    <view class="skeleton-line mt-16" style="width: 66%;"></view>
  </view>

  <!-- ===== 正常：这就是给对方看的那份表 ===== -->
  <block wx:else>
    <view class="rv-head">
      <view class="rv-shop">{{shop || '易帮账本'}}</view>
      <view class="rv-label">{{label}}</view>
      <view class="rv-range">{{rangeText}}</view>
    </view>

    <!-- ===== 汇总 =====
         报表问"这个区间赚了没"，所以头条是结余；
         对账单问"我还欠不欠、欠多少"，所以头条必须是**带方向的余额**
         （「对方欠我 8000」比一个光秃秃的「余额 -8000」有用得多），
         下面列出四个分项，让客户能自己加一遍核对 —— 这是对账单存在的意义。 -->
    <view wx:if="{{kind === 'contact'}}" class="card rv-sum">
      <view class="rv-sum-k">{{balLabel}}</view>
      <view class="rv-sum-v num {{balTone === 'is-recv' ? 'c-income' : (balTone === 'is-pay' ? 'c-expense' : '')}}">
        ¥{{balText}}
      </view>
      <view class="stmt-grid">
        <view class="stmt-cell">
          <view class="stmt-k">累计应收</view>
          <view class="stmt-v num">¥{{recvText}}</view>
        </view>
        <view class="stmt-cell">
          <view class="stmt-k">已回款</view>
          <view class="stmt-v num">¥{{backText}}</view>
        </view>
        <view class="stmt-cell">
          <view class="stmt-k">累计应付</view>
          <view class="stmt-v num">¥{{payText}}</view>
        </view>
        <view class="stmt-cell">
          <view class="stmt-k">已付款</view>
          <view class="stmt-v num">¥{{doneText}}</view>
        </view>
      </view>
    </view>

    <view wx:else class="card rv-sum">
      <view class="rv-sum-k">结余</view>
      <view class="rv-sum-v num {{isPositive ? 'c-income' : 'c-expense'}}">
        {{isPositive ? '+' : '-'}}¥{{netText}}
      </view>
      <view class="stat-grid rv-grid">
        <view class="stat-col">
          <view class="stat-k">收入</view>
          <view class="stat-v num c-income">¥{{incomeText}}</view>
        </view>
        <view class="stat-line"></view>
        <view class="stat-col">
          <view class="stat-k">支出</view>
          <view class="stat-v num c-expense">¥{{expenseText}}</view>
        </view>
      </view>
    </view>

    <!-- 明细 -->
    <view class="rv-hd">
      <text class="rv-hd-t">明细</text>
      <text class="rv-hd-n">{{kind === 'contact' ? '共 ' + count + ' 笔往来' : '共 ' + count + ' 笔'}}</text>
    </view>

    <view wx:if="{{rows.length === 0}}" class="card">
      <view class="empty">
        <image class="empty-ico" src="/images/ic-empty.svg" mode="aspectFit" />
        <view class="empty-title">{{kind === 'contact' ? '还没有往来记录' : '这段时间还没记账'}}</view>
        <view class="empty-desc">{{kind === 'contact' ? '账本里还没有跟这个对象的往来。' : '账本里还没有这个区间的记录。'}}</view>
      </view>
    </view>

    <view wx:else class="card card-flush">
      <view class="rv-row" wx:for="{{rows}}" wx:key="id">
        <view class="rv-row-main">
          <view class="rv-row-t line1">
            <text wx:if="{{item.tag}}" class="tag rv-tag {{item.tagCls}}">{{item.tag}}</text>{{item.title}}
          </view>
          <view class="rv-row-s">
            <text wx:if="{{item.date}}">{{item.date}} </text>
            <text>{{item.time}}</text>
            <text wx:if="{{item.calc}}"> · {{item.calc}}</text>
          </view>
        </view>
        <view class="rv-row-v num {{item.cls}}">{{item.amount}}</view>
      </view>
    </view>

    <view wx:if="{{truncated}}" class="rv-trunc">
      {{kind === 'contact' ? '共 ' + count + ' 笔往来，上面列出了最近 ' + rows.length + ' 笔' : '这一期共 ' + count + ' 笔，上面列出了前 ' + rows.length + ' 笔'}}
    </view>

    <!-- 只读说明：让对方明确知道自己看到的是什么、能不能改 -->
    <view class="rv-note">
      <text>{{kind === 'contact' ? '这份对账单只能看，不能改' : '这份报表只能看，不能改'}}</text>
      <text wx:if="{{kind === 'contact' && asOf}}">数据截至 {{asOf}}，之后的账不会出现在这里。</text>
      <text wx:if="{{expireDay}}">链接有效到 {{expireDay}} 为止。</text>
    </view>

    <view class="rv-cta card">
      <view class="rv-cta-t">说句话就能记账，太方便了</view>
      <view class="rv-cta-d">不用打字，拍张单子就自动记好</view>
      <view class="rv-cta-btn" bindtap="goTry">我也试试</view>
    </view>

    <view class="rv-by">由 易帮账本 生成 · 已被查看 {{viewCount}} 次</view>
  </block>

  <view class="rv-tail"></view>
</view>
