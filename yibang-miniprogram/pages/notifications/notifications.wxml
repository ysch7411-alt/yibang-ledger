<!--pages/notifications/notifications.wxml-->
<view class="page">
  <!-- 顶部操作栏 -->
  <view class="top-bar">
    <view class="top-title">消息通知</view>
    <view class="top-action" wx:if="{{unreadCount > 0}}" bindtap="markAllRead">全部已读</view>
  </view>

  <!-- 加载中 -->
  <view wx:if="{{loading}}" class="loading-state">
    <view class="loading-spinner"></view>
    <text class="loading-text">加载中...</text>
  </view>

  <!-- 空状态 -->
  <view wx:elif="{{list.length === 0}}" class="empty-state">
    <view class="empty-ico">🔔</view>
    <view class="empty-title">暂无消息</view>
    <view class="empty-desc">有新消息会在这里提醒你</view>
  </view>

  <!-- 通知列表 -->
  <view wx:else class="notify-list">
    <view 
      class="notify-item {{item.is_read ? 'is-read' : 'is-unread'}}" 
      wx:for="{{list}}" 
      wx:key="id"
      bindtap="onItemTap"
      data-id="{{item.id}}"
    >
      <view class="notify-ico {{item.type}}">
        <text wx:if="{{item.type === 'report_confirmed'}}">📊</text>
        <text wx:elif="{{item.type === 'unlock_requested'}}">🔓</text>
        <text wx:elif="{{item.type === 'unlock_approved'}}">✅</text>
        <text wx:elif="{{item.type === 'unlock_rejected'}}">❌</text>
        <text wx:elif="{{item.type === 'member_added'}}">👤</text>
        <text wx:elif="{{item.type === 'role_changed'}}">🎭</text>
        <text wx:elif="{{item.type === 'member_removed'}}">🚪</text>
        <text wx:else>📌</text>
      </view>
      <view class="notify-content">
        <view class="notify-title-row">
          <text class="notify-title">{{item.title}}</text>
          <view wx:if="{{!item.is_read}}" class="unread-dot"></view>
        </view>
        <view class="notify-desc">{{item.content}}</view>
        <view class="notify-time">{{item.time_text}}</view>
      </view>
    </view>
  </view>
</view>
