/* pages/notifications/notifications.wxss */
.page {
  min-height: 100vh;
  background: #F5F7FA;
  padding-bottom: 40rpx;
}

/* 顶部操作栏 */
.top-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 32rpx;
  background: #FFFFFF;
  position: sticky;
  top: 0;
  z-index: 10;
}
.top-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #1A1D21;
}
.top-action {
  font-size: 26rpx;
  color: #E4551D;
  font-weight: 500;
  padding: 8rpx 20rpx;
  border-radius: 24rpx;
  background: rgba(228, 85, 29, .08);
}
.top-action:active {
  opacity: 0.7;
}

/* 加载状态 */
.loading-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0;
}
.loading-spinner {
  width: 48rpx;
  height: 48rpx;
  border: 4rpx solid #E4E8EC;
  border-top-color: #E4551D;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
  margin-bottom: 20rpx;
}
@keyframes spin {
  to { transform: rotate(360deg); }
}
.loading-text {
  font-size: 26rpx;
  color: #8A94A6;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 160rpx 0;
}
.empty-ico {
  font-size: 96rpx;
  margin-bottom: 24rpx;
  opacity: 0.5;
}
.empty-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1A1D21;
  margin-bottom: 12rpx;
}
.empty-desc {
  font-size: 26rpx;
  color: #8A94A6;
}

/* 通知列表 */
.notify-list {
  padding: 16rpx 24rpx;
}
.notify-item {
  display: flex;
  align-items: flex-start;
  padding: 28rpx 24rpx;
  background: #FFFFFF;
  border-radius: 20rpx;
  margin-bottom: 16rpx;
  transition: all 0.15s ease;
}
.notify-item:active {
  transform: scale(0.98);
  background: #F8F9FB;
}
.notify-item.is-unread {
  background: linear-gradient(135deg, #FFF8F5 0%, #FFFFFF 100%);
  border-left: 6rpx solid #E4551D;
}

/* 通知图标 */
.notify-ico {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  flex-shrink: 0;
  margin-right: 20rpx;
  background: #F0F2F5;
}
.notify-ico.report_confirmed {
  background: rgba(18, 183, 106, .1);
}
.notify-ico.unlock_requested {
  background: rgba(247, 144, 9, .1);
}
.notify-ico.unlock_approved {
  background: rgba(18, 183, 106, .1);
}
.notify-ico.unlock_rejected {
  background: rgba(240, 68, 56, .1);
}

/* 通知内容 */
.notify-content {
  flex: 1;
  min-width: 0;
}
.notify-title-row {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}
.notify-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1A1D21;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.unread-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #F04438;
  flex-shrink: 0;
  margin-left: 12rpx;
}
.notify-desc {
  font-size: 26rpx;
  color: #5A6472;
  line-height: 1.5;
  margin-bottom: 10rpx;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.notify-time {
  font-size: 22rpx;
  color: #A0A8B4;
}
