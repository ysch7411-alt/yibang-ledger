<!--pages/purchase/purchase.wxml-->
<view class="container container-page container-cta" style="{{_cv}}">
  <view class="page-head">
    <view class="page-title">{{multi ? '核对这几张单子' : '核对这张单子'}}</view>
    <view class="page-sub">
      {{multi ? photoCount + ' 张单据合成一张，核对无误就入库' : 'AI 已拆成 ' + items.length + ' 项，核对无误就入库'}}
    </view>
  </view>

  <!-- 单据头 -->
  <view class="card po-head">
    <view class="po-head-top">
      <text class="po-supplier">{{supplier || (multi ? '多张单据汇总' : '未识别到供应商')}}</text>
      <text class="po-total num">¥{{totalText}}</text>
    </view>
    <view class="po-meta">
      <text wx:if="{{orderNo}}">单号 {{orderNo}} · </text>
      <text>{{date}}</text>
      <text> · 共 {{items.length}} 项</text>
    </view>
    <!-- 多张时明确告诉老板"这是几张合成的一张"，以及供应商是否一致 -->
    <view wx:if="{{multi}}" class="po-multi">
      <text class="po-multi-tag">{{photoCount}} 张单据汇总</text>
      <text wx:if="{{supplierMixed}}" class="po-multi-warn">供应商不一致，请核对</text>
    </view>
  </view>

  <!-- 没进汇总的那几张：如实标出来，让老板重拍，不要悄悄丢掉 -->
  <view wx:if="{{issues.length}}" class="po-issues">
    <view class="po-issues-t">有 {{issues.length}} 张没能进汇总</view>
    <block wx:for="{{issues}}" wx:key="index" wx:for-item="is">
      <view class="po-issues-d">第 {{is.index}} 张：{{is.reason}}</view>
    </block>
  </view>

  <!-- 明细 -->
  <view class="list-hd">
    <view class="list-hd-t">
      <text>明细</text>
      <text class="list-hd-hint" wx:if="{{!editing}}">点品类可改</text>
    </view>
    <text class="list-hd-reset" wx:if="{{!editing}}" bindtap="startEdit">识别有误？改一下</text>
    <text class="list-hd-reset" wx:else bindtap="doneEdit">改好了</text>
  </view>

  <!-- 只读态 · 多张：按来源分组。老板是对着手上那叠纸单一张张核的，分组才对得上 -->
  <block wx:if="{{!editing && multi}}">
    <view class="card card-flush" wx:for="{{groups}}" wx:key="no" wx:for-item="g">
      <view class="po-group-hd">
        <text class="po-group-no">{{g.label}}</text>
        <text wx:if="{{g.supplier}}" class="po-group-sup line1">{{g.supplier}}</text>
        <text class="po-group-sum num">¥{{g.totalText}}</text>
      </view>
      <view class="po-row" wx:for="{{g.items}}" wx:key="no" wx:for-item="it">
        <view class="po-no">{{it.no}}</view>
        <view class="po-main">
          <view class="po-name line1">{{it.name || '未填写品名'}}</view>
          <view class="po-spec line1">{{it.spec || '无规格'}}{{it.unit ? ' · ' + it.unit : ''}}</view>
          <view class="po-catline">
            <view class="po-cat" data-no="{{it.no}}" catchtap="openCat">{{it.catText}}</view>
            <text class="po-calc num">{{it.qtyText}} × {{it.priceText}}</text>
          </view>
        </view>
        <view class="po-amt num">¥{{it.amountText}}</view>
      </view>
    </view>
  </block>

  <!-- 只读态 · 单张 ／ 编辑态：平铺 -->
  <block wx:else>
    <view class="card card-flush">
      <block wx:for="{{items}}" wx:key="no" wx:for-item="it" wx:for-index="idx">
        <!-- 只读态：像送货单一样看，不让老板填表 -->
        <view class="po-row" wx:if="{{!editing}}">
          <view class="po-no">{{it.no}}</view>
          <view class="po-main">
            <view class="po-name line1">{{it.name || '未填写品名'}}</view>
            <view class="po-spec line1">{{it.spec || '无规格'}}{{it.unit ? ' · ' + it.unit : ''}}</view>
            <view class="po-catline">
              <view class="po-cat" data-no="{{it.no}}" catchtap="openCat">{{it.catText}}</view>
              <text class="po-calc num">{{it.qtyText}} × {{it.priceText}}</text>
            </view>
          </view>
          <view class="po-amt num">¥{{it.amountText}}</view>
        </view>

        <!-- 编辑态：只有老板主动点「改一下」才出现 -->
        <view class="po-edit" wx:else>
          <view class="pe-hd">
            <text class="po-no">{{it.no}}</text>
            <input class="pe-name" value="{{it.name}}" data-i="{{idx}}" data-f="name" placeholder="品名" placeholder-class="ph" bindinput="onItemField" />
            <view class="pe-del" data-i="{{idx}}" bindtap="delItem"></view>
          </view>
          <input class="pe-spec" value="{{it.spec}}" data-i="{{idx}}" data-f="spec" placeholder="规格型号" placeholder-class="ph" bindinput="onItemField" />
          <view class="pe-row">
            <input class="pe-in" type="digit" value="{{it.qty}}" data-i="{{idx}}" data-f="qty" placeholder="数量" placeholder-class="ph" bindinput="onItemField" />
            <input class="pe-in pe-unit" value="{{it.unit}}" data-i="{{idx}}" data-f="unit" placeholder="单位" placeholder-class="ph" bindinput="onItemField" />
            <text class="pe-x">×</text>
            <input class="pe-in" type="digit" value="{{it.price}}" data-i="{{idx}}" data-f="price" placeholder="单价" placeholder-class="ph" bindinput="onItemField" />
            <text class="pe-amt num">¥{{it.amountText}}</text>
          </view>
          <view class="pe-foot">
            <view class="po-cat" data-no="{{it.no}}" catchtap="openCat">{{it.catText}}</view>
          </view>
        </view>
      </block>
    </view>

    <view class="po-add" wx:if="{{editing}}" bindtap="addItem">＋ 补一行</view>
  </block>

  <view class="po-tail"></view>
</view>

<!-- 品类选择：底部弹层，点一下就走，不输入也能完成 -->
<view wx:if="{{catSheet}}" class="sheet-mask" bindtap="closeCat"></view>
<view wx:if="{{catSheet}}" class="sheet cat-sheet" catchtap="noop" style="--kb-lift: {{kbLift}}px;">
  <view class="sheet-handle"></view>
  <view class="sheet-hd">
    <text class="sheet-title">这一项算哪一类？</text>
    <view class="sheet-close" bindtap="closeCat"></view>
  </view>
  <view class="sheet-bd">
    <view class="cat-tip">归类只影响统计，不影响金额。分得越准，月底看得越清。</view>
    <view class="cat-grid">
      <view
        wx:for="{{catOptions}}"
        wx:key="*this"
        wx:for-item="c"
        class="cat-chip {{catCurrent === c ? 'is-on' : ''}}"
        data-v="{{c}}"
        bindtap="pickCat"
      >{{c}}</view>
      <!-- 「未分类」也是合法选择：宁可空着，也别为了好看硬归一类 -->
      <view class="cat-chip cat-chip-none {{catCurrent === '' ? 'is-on' : ''}}" data-v="" bindtap="pickCat">未分类</view>
    </view>
    <view class="cat-custom">
      <input
        class="cat-input"
        value="{{catInput}}"
        maxlength="16"
        placeholder="或者自己写一个，如「水泥」"
        placeholder-class="ph"
        adjust-position="{{false}}"
        bindinput="onCatInput"
        bindconfirm="applyCatInput"
        confirm-type="done"
        bindfocus="onKbFocus"
        bindblur="onKbBlur"
        bindkeyboardheightchange="onKbHeight"
      />
      <view class="btn btn-outline btn-sm cat-use" bindtap="applyCatInput">用它</view>
    </view>
  </view>
  <view class="sheet-ft">
    <view class="btn btn-ghost btn-block" bindtap="closeCat">不改了</view>
  </view>
</view>

<!-- 底部固定：合计 + 确认入库 -->
<view class="bottom-bar cta-bar">
  <view class="cta-sum">
    <text class="cta-k">合计</text>
    <text class="cta-v num">¥{{totalText}}</text>
  </view>
  <view class="btn btn-primary cta-btn {{saving ? 'is-busy' : ''}}" bindtap="save">确认入库</view>
</view>
