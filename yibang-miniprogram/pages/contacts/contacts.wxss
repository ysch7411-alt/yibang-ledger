/* pages/contacts/contacts.wxss —— 应收应付（往来对象）
   ⚠️ 本文件在 2026-09-23 的一次批量脚本事故中丢失了绝大部分内容，下面为重建版。
   重建依据（按权威性排序）：
     ① 页面 wxml 的实际结构与类名 —— 唯一权威来源
     ② app.wxss 的设计令牌与公共类 —— **能复用的一律复用，不再自造**
     ③ 同站其他页面的既有规格（页头按钮沿用 record 页 .share-btn 的规格）
   其中「筛选标签」「类型选择」原来各有一套本页自造的类，已改用公共 .chip / .seg
   —— 同一件事在站内只该有一套长相（对应 wxml 里同步替换的类名）。 */

/* ---------------- 页头 ---------------- */
/* .page-head 的上下留白在公共层，这里只管左右布局 */
.page-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}
.page-head-left {
  flex: 1;
  min-width: 0;      /* 必须：否则长标题会把右侧按钮挤扁 */
}
.page-head-right {
  flex: none;
  margin-left: 20rpx;
}
/* 页头右侧的次要按钮。规格对齐 record 页的 .share-btn（浅橙底 + 描边 + 触控区 ≥88rpx） */
.add-btn {
  display: flex;
  align-items: center;
  min-height: 88rpx;
  padding: 0 26rpx;
  border-radius: var(--r-full);
  background: var(--brand-weak);
  border: 2rpx solid var(--brand-line);
}
.add-btn:active {
  opacity: .88;
}
.add-btn-text {
  font-size: 27rpx;
  font-weight: 600;
  color: var(--brand-ink);
}

/* ---------------- 应收应付汇总 ---------------- */
/* 两栏 + 中间竖线。整块可点（点哪边筛哪边），所以两栏都要撑到够按的高度 */
.sum-card {
  display: flex;
  align-items: stretch;
  padding: 0;
}
.sum-col {
  flex: 1;
  min-width: 0;
  padding: 32rpx 24rpx;
  text-align: center;
}
.sum-col:active {
  background: var(--fill);
}
.sum-k {
  font-size: 26rpx;
  color: var(--t3);
}
.sum-v {
  margin-top: 10rpx;
  font-size: 40rpx;
  font-weight: 700;
  line-height: 1.25;
}
.sum-s {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: var(--t3);
}
.sum-line {
  width: 1rpx;
  flex: none;
  align-self: stretch;
  margin: 24rpx 0;
  background: var(--line);
}

/* ---------------- 采购单入口卡片 ---------------- */
.entry-card {
  display: flex;
  align-items: center;
  padding: 28rpx 32rpx;
  margin-bottom: 24rpx;
}
.entry-card:active {
  opacity: 0.85;
}
.entry-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 20rpx;
  background: var(--brand-weak);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
  flex: none;
}
.entry-icon-img {
  width: 44rpx;
  height: 44rpx;
}
.entry-info {
  flex: 1;
  min-width: 0;
}
.entry-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--t1);
  margin-bottom: 6rpx;
}
.entry-desc {
  font-size: 24rpx;
  color: var(--t3);
}
.entry-arrow {
  width: 16rpx;
  height: 16rpx;
  border-top: 2rpx solid var(--t4);
  border-right: 2rpx solid var(--t4);
  transform: rotate(45deg);
}

/* ---------------- 往来对象列表 ---------------- */
/* 筛选标签用公共 .chip-bar / .chip（见 wxml），本页不再自造 */

.contact-list {
  background: var(--card);
  border-radius: var(--r-lg);
  box-shadow: var(--sh-card);
  overflow: hidden;
}
.contact-item {
  display: flex;
  align-items: center;
  min-height: 112rpx;
  padding: 22rpx 28rpx;
}
.contact-item:active {
  background: var(--fill);
}
/* 相邻两行之间的分割线。
   ⚠️ 用相邻选择器，**不要用 `*` 通配符** —— wxss 不支持通配符，编译会直接失败。 */
.contact-item + .contact-item {
  border-top: 1rpx solid var(--line);
}
.contact-avatar {
  width: 76rpx;
  height: 76rpx;
  flex: none;
  margin-right: 22rpx;
  border-radius: 50%;
  background: var(--brand-weak);
  color: var(--brand-ink);
  font-size: 30rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}
.contact-info {
  flex: 1;
  min-width: 0;      /* 必须：名字过长时右侧金额不能被挤出去 */
}
.contact-name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--t1);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.contact-remark {
  margin-top: 4rpx;
  font-size: 24rpx;
  color: var(--t3);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.contact-balance {
  flex: none;
  margin-left: 20rpx;
  text-align: right;
}
.balance-v {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--t1);
}
.balance-label {
  margin-top: 4rpx;
  font-size: 24rpx;
  color: var(--t3);
}
.contact-arrow {
  width: 16rpx;
  height: 16rpx;
  flex: none;
  margin-left: 14rpx;
  border-top: 2rpx solid var(--t4);
  border-right: 2rpx solid var(--t4);
  transform: rotate(45deg);
}

/* ---------------- 弹层里的表单细节 ---------------- */
/* 类型选择用公共 .seg / .seg-i（见 wxml），本页不再自造 */
.f-required {
  color: var(--expense);
  font-size: 26rpx;
}

/* ---------------- 页尾留白 ---------------- */
.bottom-space {
  height: 40rpx;
}

/* 弹层贴底已在公共层收口（变量 `--sheet-rest`），本页**不需要再覆盖 .sheet** ——
   见 app.wxss 的 page{} 里那个变量的说明。
   2026-09-22 前这里要各写一遍 bottom + 安全区 padding，而**全站 6 个二级页曾同时漏掉**，
   表现是弹层底下漏出一条缝、或弹层里的输入框被键盘压住。 */
