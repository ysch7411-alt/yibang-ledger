/* pages/contacts/contacts.wxss */

/* ---------- 顶部标题栏 ---------- */
.page-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx 36rpx 16rpx;
}
.page-head-left {
  flex: 1;
}
.page-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #101828;
  margin-bottom: 6rpx;
}
.page-sub {
  font-size: 24rpx;
  color: #98A2B3;
}
.page-head-right {
  flex-shrink: 0;
}
.add-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 14rpx 28rpx;
  border-radius: 28rpx;
  background: linear-gradient(135deg, #E4551D 0%, #C9451A 100%);
  box-shadow: 0 8rpx 20rpx -8rpx rgba(201, 69, 26, .5);
}
.add-btn:active {
  transform: scale(0.96);
  opacity: 0.9;
}
.add-btn-text {
  font-size: 26rpx;
  font-weight: 600;
  color: #FFFFFF;
}

/* ---------- 汇总卡片 ---------- */
.sum-card {
  display: flex;
  align-items: center;
  padding: 36rpx;
  margin: 16rpx 24rpx;
  position: relative;
  overflow: hidden;
}
.sum-card::before {
  content: "";
  position: absolute;
  top: -40rpx;
  right: -40rpx;
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(255, 107, 53, .06) 0%, transparent 70%);
  pointer-events: none;
}
.sum-col {
  flex: 1;
  text-align: center;
}
.sum-col:active {
  opacity: 0.7;
}
.sum-k {
  font-size: 26rpx;
  color: #667085;
  margin-bottom: 12rpx;
}
.sum-v {
  font-size: 44rpx;
  font-weight: 700;
  margin-bottom: 8rpx;
}
.sum-s {
  font-size: 22rpx;
  color: #98A2B3;
}
.sum-line {
  width: 1rpx;
  height: 80rpx;
  background: #EAECF0;
}

/* ---------- 筛选标签 ---------- */
.filter-bar {
  display: flex;
  padding: 16rpx 36rpx;
  gap: 16rpx;
}
.filter-item {
  padding: 12rpx 28rpx;
  border-radius: 24rpx;
  background: #F2F4F7;
  font-size: 26rpx;
  color: #667085;
  transition: all 0.2s;
}
.filter-item.is-on {
  background: linear-gradient(135deg, #E4551D 0%, #C9451A 100%);
  color: #FFFFFF;
  font-weight: 600;
}
.filter-item:active {
  transform: scale(0.96);
}

/* ---------- 往来对象列表 ---------- */
.contact-list {
  padding: 0 24rpx;
}
.contact-item {
  display: flex;
  align-items: center;
  padding: 28rpx 24rpx;
  margin-bottom: 16rpx;
  background: #FFFFFF;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 16rpx -8rpx rgba(16, 24, 40, .08);
  transition: all 0.2s;
}
.contact-item:active {
  transform: scale(0.98);
  box-shadow: 0 2rpx 8rpx -4rpx rgba(16, 24, 40, .12);
}
.contact-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #FF8A50 0%, #E4551D 100%);
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  flex-shrink: 0;
}
.contact-info {
  flex: 1;
  min-width: 0;
}
.contact-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #101828;
  margin-bottom: 6rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.contact-remark {
  font-size: 24rpx;
  color: #98A2B3;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.contact-balance {
  text-align: right;
  margin-right: 12rpx;
  flex-shrink: 0;
}
.balance-v {
  font-size: 32rpx;
  font-weight: 700;
  margin-bottom: 4rpx;
}
.balance-label {
  font-size: 22rpx;
  color: #98A2B3;
}
.contact-arrow {
  width: 12rpx;
  height: 12rpx;
  border-top: 3rpx solid #D0D5DD;
  border-right: 3rpx solid #D0D5DD;
  transform: rotate(45deg);
  flex-shrink: 0;
}

/* ---------- 空状态 ---------- */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 60rpx;
}
.empty-icon {
  width: 160rpx;
  height: 160rpx;
  margin-bottom: 32rpx;
  opacity: 0.5;
}
.empty-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #344054;
  margin-bottom: 12rpx;
}
.empty-desc {
  font-size: 26rpx;
  color: #98A2B3;
  text-align: center;
  margin-bottom: 40rpx;
}
.empty-btn {
  padding: 20rpx 48rpx;
  border-radius: 32rpx;
  background: linear-gradient(135deg, #E4551D 0%, #C9451A 100%);
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: 600;
  box-shadow: 0 8rpx 24rpx -8rpx rgba(201, 69, 26, .5);
}
.empty-btn:active {
  transform: scale(0.96);
  opacity: 0.9;
}

.bottom-space {
  height: 60rpx;
}

/* ---------- 表单 ---------- */
.f-block {
  margin-bottom: 28rpx;
}
.f-label {
  font-size: 26rpx;
  font-weight: 600;
  color: #344054;
  margin-bottom: 12rpx;
}
.f-required {
  color: #E4551D;
}
.f-input {
  width: 100%;
  padding: 24rpx 28rpx;
  background: #F9FAFB;
  border-radius: 16rpx;
  font-size: 28rpx;
  color: #101828;
  box-sizing: border-box;
}
.ph {
  color: #98A2B3;
}

/* ---------- 类型选择 ---------- */
.type-picker {
  display: flex;
  gap: 16rpx;
}
.type-item {
  flex: 1;
  padding: 20rpx;
  text-align: center;
  border-radius: 16rpx;
  background: #F9FAFB;
  font-size: 28rpx;
  color: #667085;
  border: 2rpx solid transparent;
  transition: all 0.2s;
}
.type-item.is-on {
  background: rgba(228, 85, 29, .08);
  color: #E4551D;
  font-weight: 600;
  border-color: #E4551D;
}
.type-item:active {
  transform: scale(0.97);
}
