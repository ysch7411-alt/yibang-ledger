/* pages/operation-logs/operation-logs.wxss */
.page {
  min-height: 100vh;
  background: #F5F7FA;
  padding-bottom: 40rpx;
}

/* 顶部 */
.top-bar {
  padding: 24rpx 32rpx 16rpx;
  background: #FFFFFF;
}
.top-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #1A1D21;
  margin-bottom: 6rpx;
}
.top-desc {
  font-size: 24rpx;
  color: #8A94A6;
}

/* 加载状态 */
.loading-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0;
}
.loading-spinner {
  width: 48rpx;
  height: 48rpx;
  border: 4rpx solid #E4E8EC;
  border-top-color: #E4551D;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
  margin-bottom: 20rpx;
}
@keyframes spin {
  to { transform: rotate(360deg); }
}
.loading-text {
  font-size: 26rpx;
  color: #8A94A6;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 160rpx 0;
}
.empty-ico {
  font-size: 96rpx;
  margin-bottom: 24rpx;
  opacity: 0.5;
}
.empty-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1A1D21;
  margin-bottom: 12rpx;
}
.empty-desc {
  font-size: 26rpx;
  color: #8A94A6;
}

/* 日志列表 */
.log-list {
  padding: 16rpx 24rpx;
}
.log-item {
  display: flex;
  align-items: flex-start;
  padding: 24rpx;
  background: #FFFFFF;
  border-radius: 16rpx;
  margin-bottom: 12rpx;
}

/* 日志图标 */
.log-ico {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  flex-shrink: 0;
  margin-right: 20rpx;
  background: #F0F2F5;
}
.log-ico.confirm_report,
.log-ico.approve_unlock {
  background: rgba(18, 183, 106, .1);
}
.log-ico.add_member {
  background: rgba(18, 183, 106, .1);
}
.log-ico.remove_member,
.log-ico.reject_unlock,
.log-ico.unconfirm_report {
  background: rgba(240, 68, 56, .1);
}
.log-ico.change_role,
.log-ico.request_unlock {
  background: rgba(247, 144, 9, .1);
}

/* 日志内容 */
.log-content {
  flex: 1;
  min-width: 0;
}
.log-title {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}
.log-operator {
  font-size: 28rpx;
  font-weight: 600;
  color: #1A1D21;
  margin-right: 12rpx;
}
.log-action {
  font-size: 24rpx;
  color: #E4551D;
  background: rgba(228, 85, 29, .08);
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
}
.log-detail {
  font-size: 26rpx;
  color: #5A6472;
  line-height: 1.5;
  margin-bottom: 8rpx;
}
.log-time {
  font-size: 22rpx;
  color: #A0A8B4;
}
