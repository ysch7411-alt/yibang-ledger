/* pages/operation-logs/operation-logs.wxss */
.page {
  min-height: 100vh;
  background: var(--bg);
  padding-bottom: 40rpx;
}

/* 顶部 */
.top-bar {
  padding: 24rpx 32rpx 16rpx;
  background: var(--card);
}
.top-title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--t1);
  margin-bottom: 6rpx;
}
.top-desc {
  font-size: 24rpx;
  color: var(--t3);
}

/* 加载状态 */
.loading-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0;
}
.loading-spinner {
  width: 48rpx;
  height: 48rpx;
  border: 4rpx solid var(--line);
  border-top-color: var(--brand-btn);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
  margin-bottom: 20rpx;
}
@keyframes spin {
  to { transform: rotate(360deg); }
}
.loading-text {
  font-size: 26rpx;
  color: var(--t3);
}

/* 2026-09-22 删除本页自写的空状态（.empty-state / .empty-ico / .empty-title / .empty-desc）。
   已改用 app.wxss 的公共 .empty 体系 —— 见 contacts.wxss 里的同类说明。 */

/* 日志列表 */
.log-list {
  padding: 16rpx 24rpx;
}
.log-item {
  display: flex;
  align-items: flex-start;
  padding: 24rpx;
  background: var(--card);
  border-radius: 16rpx;
  margin-bottom: 12rpx;
}

/* 日志图标 */
/* 操作图标 —— 2026-09-22 统一（原来有 4 组按动作上色的规则，绿/红/琥珀混排）：
   和消息页保持同一套语言「浅橙底 + 品牌橙描边图标」，
   动作语义交给右侧的行动词（"确认了报表""添加了成员"本来就写得很清楚）。
   形状从正圆改成 --r-md 圆角方，与消息页、报表页入口图标对齐。 */
.log-ico {
  width: 64rpx;
  height: 64rpx;
  border-radius: var(--r-md);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-right: 20rpx;
  background: var(--brand-weak);
}
.log-ico-img {
  width: 36rpx;
  height: 36rpx;
}

/* 日志内容 */
.log-content {
  flex: 1;
  min-width: 0;
}
.log-title {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}
.log-operator {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--t1);
  margin-right: 12rpx;
}
.log-action {
  font-size: 24rpx;
  color: var(--brand-ink);
  background: rgba(228, 85, 29, .08);
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
}
.log-detail {
  font-size: 26rpx;
  color: var(--t2);
  line-height: 1.5;
  margin-bottom: 8rpx;
}
.log-time {
  font-size: 22rpx;
  color: var(--t4);
}
