/* pages/advisor/advisor.wxss */

/* ---------- 整页对话布局（2026-09-22 改造）----------
   这一页原来是「深色洞察卡 hero + 追问条 + 经营提示列表 + 底部对话弹层」——
   从报表页点进来先看到一份概览，还要再点一次才弹出对话，等于两次点击才问到问题。
   按老板要求还原成一个**纯粹的对话窗口**：概览 / 提示 / 页内入口全部拿掉，
   对话从弹层升为页面主体。

   布局：整页是一个纵向 flex 容器，上面是消息滚动区（flex:1），下面是固定在底部的输入条。

   🔴 **高度必须用 `page { height:100% }` + `height:100%`，不要用 `100vh`**（2026-09-22 真机报障后改）：
   小程序的 `vh` 是**相对整屏**算的（含导航栏区），而页面可视区是"导航栏以下"——
   写 `height: 100vh` 会让页面比可视区高出一截，**多出来的部分露在 tabBar 下面**：
   表现就是底部一大片空白，页面还能整页滚。（模拟器**不重现**这个问题，只有真机能看出来。）
   `page { height: 100% }` 拿到的才是"页面可视高度"，是微信里可靠的写法。
   `overflow: hidden` 让整页不再滚动 —— 这一页只有一个滚动区，就是消息列表。 */
page {
  height: 100%;
  overflow: hidden;
}
.chat-page {
  display: flex;
  flex-direction: column;
  height: 100%;
  box-sizing: border-box;
  /* 底部要让出 tabBar（2026-09-22 本页成为 tab 页）：
     自定义 tabBar 是浮在页面上方的，会盖住底部约 120rpx ——
     不让出来的话，输入条正好被压在它底下，点不到。
     ⚠️ 用 max() 而不是相加：相加的话键盘弹起时会浮起一条缝（项目踩过这个坑，
        见 app.wxss 里 .sheet 的注释）。
     ⚠️ 安全区留白交给 .ibar 自己的 padding-bottom（它已经含 env()），这里不重复算。 */
  padding-bottom: max(var(--tabbar-h), var(--kb-lift, 0px));
  background: var(--bg);
}

/* ---------- 页内返回入口 ----------
   只在聊过之后出现（见 advisor.wxml 的注释）：tab 页的导航栏不会给返回箭头，
   聊完想回主界面就没路可走，所以补这一条。

   做成"左箭头 + 文字"的浅色胶囊，而不是光秃秃的文字链 ——
   全站规范是触控区 ≥88rpx，27rpx 的纯文字才三四十 rpx 高，老板（40-60 岁）点不准。
   flex: none 不能被上面的消息区挤扁。 */
.chat-top {
  flex: none;
  display: flex;
  align-items: center;
  padding: 6rpx 32rpx 0;
}
.chat-top-btn {
  display: inline-flex;
  align-items: center;
  min-height: 88rpx;
  padding: 0 26rpx 0 20rpx;
  border-radius: var(--r-full);
  background: var(--card);
  border: 1rpx solid var(--line);
  font-size: 27rpx;
  color: var(--brand-ink);
}
.chat-top-btn-hover,
.chat-top-btn:active {
  background: var(--brand-weak);
}
/* 左箭头：border + rotate 画，和 app.wxss 里 .row-arrow（右箭头）是同一套手法镜像过来 */
.chat-top-ico {
  width: 18rpx;
  height: 18rpx;
  margin-right: 10rpx;
  flex: none;
  border-left: 3rpx solid var(--brand-ink);
  border-top: 3rpx solid var(--brand-ink);
  transform: rotate(-45deg);
}

/* 消息滚动区 */
.chat-body {
  flex: 1;
  min-height: 0;
  width: 100%;              /* scroll-view 兜底：不给宽度，内容一宽就把滚动区本身撑破 */
  padding: 8rpx 32rpx;
  box-sizing: border-box;
}

/* 2026-09-22 同时删除：.adv-tail / .hero* / .tips-card / .tip* / .ask-entry.is-joined / .chat-sheet。
   它们服务的概览与提示区已经不在模板里了，留着就是死 CSS。
   （.ask-entry 的底样式在 app.wxss —— 报表页还在用，那个不能删。） */
.chat-hello {
  padding: 16rpx 0 12rpx;
  text-align: center;
}
/* 标题行：小图标 + 一行字。原来是一个 120rpx 的大图标 + 一个标题行两行占位，
   空状态整体比可视区还高，scroll-view 会停在底部（客人第一眼看到的是中间几行）。 */
.chat-hd {
  display: flex;
  align-items: center;
  justify-content: center;
}
.chat-hd-ico {
  width: 34rpx;
  height: 34rpx;
  margin-right: 10rpx;
  flex: none;
}
.chat-hd-t {
  font-size: 29rpx;
  font-weight: 600;
  color: var(--t1);
}
.chat-asks {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 16rpx;
}
.chat-ask {
  width: 100%;
  padding: 18rpx 24rpx;
  margin-bottom: 10rpx;
  border-radius: var(--r-md);
  /* 同上：从 --fill 改成白卡 + 发丝边，否则在 --bg 页面上几乎看不见 */
  background: var(--card);
  border: 1rpx solid var(--line);
  font-size: 27rpx;
  color: var(--t2);
  text-align: left;
}

/* 四件事清单（空状态最上面）。
   每行：两字的名字（品牌橙强调）+ 一句"它能干什么"。
   刻意排在快捷问题**上面** —— 快捷问题回答的是"我该问什么"，
   而这份清单回答的是"它到底能干什么"，后者才是新用户的第一疑问。 */
.chat-skills {
  margin-top: 18rpx;
}
.chat-skill {
  display: flex;
  align-items: baseline;
  text-align: left;
  padding: 16rpx 24rpx;
  margin-bottom: 10rpx;
  border-radius: var(--r-md);
  background: var(--card);
  border: 1rpx solid var(--line);
}
.chat-skill-t {
  flex: none;
  width: 96rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--brand-ink);
}
.chat-skill-d {
  flex: 1;
  min-width: 0;
  font-size: 25rpx;
  color: var(--t3);
}

/* 订阅消息授权入口。
   一行放完：一句问话 + 一个「好」。刻意不做成大卡片 ——
   它是**可选的加值服务**，不该跟上面"四件事"抢注意力；
   而且微信要求授权必须由点击触发，问太长反而像推销。 */
.chat-push {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 16rpx;
  padding: 16rpx 20rpx 16rpx 24rpx;
  border-radius: var(--r-md);
  background: var(--brand-weak);
  border: 1rpx solid var(--brand-line);
}
.chat-push-t {
  flex: 1;
  min-width: 0;
  font-size: 26rpx;
  color: var(--brand-ink);
}
.chat-push-yes {
  flex: none;
  display: flex;
  align-items: center;
  /* 触控区 ≥88rpx（全站规范）：这个按钮就俩字，全靠 padding 撑 */
  min-height: 88rpx;
  padding: 0 32rpx;
  border-radius: var(--r-full);
  background: var(--brand-btn);
  color: #fff;
  font-size: 27rpx;
}
.chat-push-yes-hover,
.chat-push-yes:active {
  opacity: .88;
}
.chat-ask:active {
  background: #E7EBF0;
}
.chat-item {
  margin-bottom: 24rpx;
  display: flex;
  min-width: 0;   /* flex 容器的子项默认 min-width:auto，会被长内容顶宽 */
}
.chat-item.user {
  justify-content: flex-end;
}
/* AI 气泡显式声明左对齐，避免依赖默认值 */
.chat-item.ai {
  justify-content: flex-start;
}
.chat-bubble {
  max-width: 78%;
  /* min-width:0 + overflow-wrap:anywhere 是两个一起用的：
     flex 子项默认 min-width:auto（= 内容最小宽度），遇到
     「5000+2000+1500」这种断不开的串，min-content 比 max-width:78% 还大，
     浏览器就按 min-width 走 —— max-width 形同虚设，气泡直接冲出屏幕。
     overflow-wrap:anywhere 把 min-content 打到 0，max-width 才真正说了算。
     （项目里 .rec-name 用的是同一条规律，只是那边靠 .ellipsis 的 overflow:hidden 顺带解决。） */
  min-width: 0;
  padding: 22rpx 28rpx;
  border-radius: 22rpx;
  font-size: 28rpx;
  line-height: 1.6;
  /* ⚠️ 2026-09-22 底色从 var(--fill) 改成 var(--card) + 发丝边框。
     原因：这一页原来对话装在**白色弹层**里，--fill(#F2F4F7) 压在纯白上刚好看得出来；
     改成整页对话后页面底色是 --bg(#F6F7F9)，和 --fill 几乎同色 ——
     气泡直接"消失"，只剩字浮在页面上。浅灰底上必须用白卡 + 一道细边才立得住。 */
  background: var(--card);
  border: 1rpx solid var(--line);
  color: var(--t1);
  border-bottom-left-radius: 6rpx;
  word-break: break-word;
  overflow-wrap: anywhere;
}
.chat-item.user .chat-bubble {
  background: var(--brand-btn);
  /* 用户气泡是实心橙，不需要发丝边 */
  border-color: transparent;
  color: #fff;
  border-bottom-left-radius: 22rpx;
  border-bottom-right-radius: 6rpx;
}

/* ---------- 卡片化排版（2026-09-20）----------
   原来不管 AI 回什么，都是一整段灰底文字七八行挤在一起，老板找不到数字在哪。
   现在分成「结论 / 关键数字 / 要点」三层，数字用大号等宽，一眼扫到钱。 */

/* 结论句：整条回答最重要的一句话 */
.cc-sum {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--t1);
  line-height: 1.5;
}

/* 关键数字：两列排，数字等宽才对得齐 */
.cc-figs {
  display: flex;
  flex-wrap: wrap;
  margin-top: 14rpx;
  padding: 14rpx 0 4rpx;
  border-top: 1rpx solid #E7EBF0;
}
.cc-fig {
  width: 50%;
  min-width: 0;
  padding: 6rpx 0 12rpx;
}
.cc-fig-k {
  display: block;
  font-size: 22rpx;
  color: var(--t3);
}
.cc-fig-v {
  display: block;
  margin-top: 2rpx;
  font-size: 34rpx;
  font-weight: 700;
  color: var(--brand-ink);
  font-variant-numeric: tabular-nums;
}

/* 要点：小圆点 + 一行一条 */
.cc-pts {
  margin-top: 8rpx;
  padding-top: 14rpx;
  border-top: 1rpx solid #E7EBF0;
}
.cc-pt {
  display: flex;
  align-items: flex-start;
  margin-bottom: 10rpx;
}
.cc-pt:last-child {
  margin-bottom: 0;
}
.cc-dot {
  width: 10rpx;
  height: 10rpx;
  flex: none;
  margin: 14rpx 12rpx 0 2rpx;
  border-radius: 50%;
  background: var(--brand);
}
.cc-pt-t {
  flex: 1;
  min-width: 0;
  font-size: 26rpx;
  color: var(--t2);
  line-height: 1.6;
}

/* 没结构时的纯文本：逐段渲染，段与段之间有呼吸 */
.cc-line {
  font-size: 28rpx;
  line-height: 1.65;
  color: var(--t1);
}
.cc-line + .cc-line {
  margin-top: 12rpx;
}

/* 拍图提问时，气泡顶部显示刚拍的那张缩略图 —— 看着才知道 AI 看的是哪张 */
.cc-thumb {
  display: block;
  width: 180rpx;
  height: 180rpx;
  margin: -6rpx 0 14rpx;
  border-radius: var(--r-md);
  background: #E7EBF0;
}
.chat-bubble-thinking {
  color: var(--t3);
}
/* 撤销入口。做成一个浅橙小胶囊而不是纯文字链：
   全站规范是触控区 ≥88rpx，纯文字链在 25rpx 字号下只有三四十 rpx 高，
   老板（40-60 岁）点不准。padding 撑到 85rpx 左右才够用。 */
.cc-undo {
  margin-top: 18rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid var(--line);
}
.cc-undo-btn {
  display: inline-block;
  padding: 22rpx 30rpx;
  border-radius: var(--r-full);
  border: 1rpx solid var(--brand-line);
  background: var(--brand-weak);
  color: var(--brand-ink);
  font-size: 25rpx;
}
.cc-undo-btn:active {
  background: #FFE8DC;
}
.cc-undo-done {
  display: inline-block;
  padding: 22rpx 30rpx;
  font-size: 25rpx;
  color: var(--t4);
}
.chat-pad {
  height: 20rpx;
}

/* 2026-09-22 删除本页的 .sheet 贴底覆盖：
   这一页已经没有底部弹层了（对话升为页面主体、输入条在 .chat-page 里），
   留着这段覆盖就是死 CSS。安全区内边距改由 .chat-page 一起处理下面那条输入条。 */
