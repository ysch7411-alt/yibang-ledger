  color: var(--t3);
}
/* 「删掉就找不回来了」用语义红：不可逆的操作要让颜色先说话 */
.del-warn {
  padding: 20rpx 4rpx 4rpx;
  font-size: 25rpx;
  line-height: 1.6;
  color: var(--expense);
}
/* AI 处理中提示：就地一条，不遮挡页面（输入条换成公共 .ibar-* 之后，这条不属于输入条了） */
.dock-tip {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  /* 同 .receipt：让开输入条（132rpx + 安全区），键盘情形按 kb-lift + 输入条高算；
     z-index 压过输入条的 900，处理中提示不能被输入条盖住 */
  bottom: max(calc(var(--tabbar-h) + 172rpx + env(safe-area-inset-bottom, 0px) + env(safe-area-inset-bottom, 0px)), calc(var(--kb-lift, 0px) + 320rpx + env(safe-area-inset-bottom, 0px)));
  z-index: 901;
  display: flex;
  align-items: center;
  padding: 20rpx 26rpx;
  border-radius: var(--r-lg);
  background: var(--card);
  border: 1rpx solid var(--line);
  box-shadow: 0 12rpx 32rpx -16rpx rgba(16, 24, 40, .28);
  font-size: 26rpx;
  color: var(--t2);
  box-sizing: border-box;
}
.dock-spin {
  width: 28rpx;
  height: 28rpx;
  flex: none;
  margin-right: 16rpx;
  border: 4rpx solid var(--brand-line);
  border-top-color: var(--brand-btn);
  border-radius: 50%;
  animation: yb-spin .7s linear infinite;
}
