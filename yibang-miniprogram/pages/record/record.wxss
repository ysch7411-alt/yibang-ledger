/* ---------------- 左滑：修改 / 删除 ----------------
   结构：.swipe（裁剪层）> .swipe-acts（垫在下面的两个按钮） + .swipe-body（会平移的内容）
   裁剪必须放在 .swipe 上而不是 .swipe-body：body 要平移，裁它等于白裁。 */
.swipe {
  position: relative;
  overflow: hidden;
}
.swipe-acts {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  display: flex;
}
/* 132rpx × 2 = 264rpx，跟 record.js 的 ACTIONS_RPX 必须一致，改一处要改两处 */
.swipe-act {
  width: 132rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 600;
  color: #fff;
}
.swipe-fix {
  background: var(--t3);
}
.swipe-del {
  background: var(--expense);
}
.swipe-act:active {
  opacity: .86;
}
/* 底色必须是实色：半透明会让下面的按钮透出来，看着像脏了 */
.swipe-body {
  position: relative;
  background: var(--card);
  transition: transform .18s ease;
  will-change: transform;
}
/* 手指正按着的时候关掉过渡 —— 否则位移会"追不上"手指，滑起来发黏 */
.swipe.is-drag .swipe-body {
  transition: none;
}
/* .row 现在被 .swipe 包了一层，:last-child 落不到它头上，
   不补这条最后一行底下会多出一道悬空的横线 */
.swipe:last-child .row {
  border-bottom: none;
}

/* ---------------- 底部录入带 ---------------- */

/* AI 处理中 */
@keyframes dockspin {
  to {
    transform: rotate(360deg);
  }
}

/* ---------------- 结果条 ---------------- */
.receipt {
  position: fixed;
  left: 20rpx;
  right: 20rpx;
  /* 底部要让开的是**输入条**（132rpx 高 + 安全区，贴在 tabBar 之上），不是 tabBar 本身。
     两个分支都必须按「输入条顶沿」算：
       无键盘：tabbar-h + 132rpx + 2×env + 24rpx 呼吸
       有键盘：kb-lift + 132rpx + env + 24rpx 呼吸（金额框 focus=true 会自动弹键盘）
     2026-09-20 之前只按 tabbar-h + 160rpx 算：安全区一大（真机 env≈34pt）输入条就盖住
     卡片底部约 24pt，追问金额的输入框和「存上」正好被挡（输入条 z-index 900 更高）。
     另外 z-index 提到 905 压过输入条 —— 位置万一算错，追问框也不能被盖。 */
  bottom: max(calc(var(--tabbar-h) + 172rpx + env(safe-area-inset-bottom, 0px) + env(safe-area-inset-bottom, 0px)), calc(var(--kb-lift, 0px) + 320rpx + env(safe-area-inset-bottom, 0px)));
  z-index: 905;
  display: flex;
  align-items: center;
  padding: 22rpx 24rpx;
  border-radius: var(--r-lg);
  background: #FFFFFF;
  border: 1rpx solid var(--line);
  box-shadow: 0 16rpx 36rpx -16rpx rgba(16, 24, 40, .45);
  animation: receiptIn .22s ease-out;
}
@keyframes receiptIn {
  from {
    opacity: 0;
    transform: translateY(16rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}
.receipt-ico {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  flex: none;
  margin-right: 18rpx;
  position: relative;
  background: var(--income-weak);
}
.receipt-ico::after {
  content: "";
  position: absolute;
  left: 12rpx;
  top: 14rpx;
  width: 14rpx;
  height: 7rpx;
  border-left: 3rpx solid var(--income);
  border-bottom: 3rpx solid var(--income);
  transform: rotate(-45deg);
}
.is-ask .receipt-ico,
.is-error .receipt-ico {
  background: var(--warn-weak);
}
.is-ask .receipt-ico::after,
.is-error .receipt-ico::after {
  content: "";
  border: none;
  width: 4rpx;
  height: 12rpx;
  background: var(--warn);
  left: 18rpx;
  top: 10rpx;
  transform: none;
  border-radius: 2rpx;
  box-shadow: 0 16rpx 0 var(--warn);
}
