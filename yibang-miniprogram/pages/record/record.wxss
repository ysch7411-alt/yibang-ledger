/* 给固定录入带留出空间（TabBar 108rpx + 录入带 ~124rpx） */
/* ══════ 记账页的输入条定位 ══════
   .ibar 是全站公共样式（app.wxss），但它只描述"长什么样"，**不描述贴在哪** ——
   参谋页里它是 fixed 弹层的 flex 子项，靠父级定位；记账页要自己贴在 tabBar 之上。
   2026-09-20 改造时漏了这段，输入条跟着页面内容流走，表现为"输入条不见了"。
   （同一天的第二个同类坑：抽公共组件时，**"外观"和"定位"要分开看清楚谁负责**。） */
.ibar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: var(--tabbar-h);
  bottom: calc(var(--tabbar-h) + env(safe-area-inset-bottom, 0px));
  /* 键盘弹起时 tabBar 已被键盘压住，不能再叠 tabbar-h（会悬空一条缝）→ 取更高者。
     这里用 .ibar 自身高度 148rpx（padding 18×2 + 内容 112）。
     2026-09-21 输入条加高（144→148rpx），此数字同步改；.receipt/.dock-tip 的底部计算也跟着改。 */
  bottom: max(calc(var(--tabbar-h) + env(safe-area-inset-bottom, 0px)), calc(var(--kb-lift, 0px) + 148rpx));
  z-index: 900;
  /* 录入带底色用纯白：半透明会让列表内容从背后透出淡淡的字影，看着脏（项目规范） */
  background: #FFFFFF;
  box-shadow: 0 -8rpx 24rpx -16rpx rgba(16, 24, 40, .18);
  /* 记账页的 .ibar 已贴在 tabBar 之上（bottom 含安全区），不需要像参谋页那样内部再留一次
     安全区 padding —— 否则下方凭空多出一条白边，上下留白不对称（老板反馈"留白太多"）。 */
  padding-bottom: 18rpx;
}

/* 结果条的底部留白要跟着输入条高度走（148rpx + 一点呼吸 + 安全区）。 */
.rec {
  padding-bottom: calc(var(--tabbar-h) + 200rpx);
  padding-bottom: calc(var(--tabbar-h) + 200rpx + env(safe-area-inset-bottom, 0px));
}
