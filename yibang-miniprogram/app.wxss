/* ============================================================
   app.wxss —— 易帮账本 设计系统 v3（时尚前卫 · 简洁 · 微质感）
   目标用户：中小门店老板（40-60 岁、非财务专业、店内光线复杂）
   设计原则：字大、点大、对比足、层级浅、语音优先
   v3 升级点：
     · 在不破 WCAG AA 的范围内，加亮品牌色双段渐变（v2 注释里写"白字压上去不达标"
       的那条被破掉了：v2 的渐变是为了保证按钮白字 ≥4.5:1 才必须压一档 —— 现在
       我们换思路，按钮底用单色 --brand-btn（已达标），渐变只用于"无文字的容器"
       即 hero 卡 / 身份卡 / 顶部状态条，这三个上面不压文字或只压浅色文字，
       所以亮端可以放回 #FF6B35 这种"漂亮橙"，对比度约束自然消失）。
     · 字号梯度更夸张：金额 -lg 提到 72rpx，标题 48rpx，强化"金额即视觉主角"。
     · 圆角梯度更柔和：r-lg 32→36，r-md 20→24，整站更"前卫简洁"。
     · 阴影分层：四级（card / lift / float / glow），加 --sh-glow 暖色微光。
     · 加 Glass / Aurora / Mesh 三个高级背景令牌（按需使用）。
   ============================================================ */

/* ---------- 1. 设计令牌（Design Tokens） ---------- */
page {
  /* === 品牌主色 === */
  /* v3 改：橘黄太深 → 主橙亮一档(#E08B45→#FF6B35之间)，按下和深橙才更深。
     视觉上现在是 3 档梯度：#FF6B35 漂亮橙(图形) / #D9541E 主橙(按钮) / #A8360F 深橙(按下/链接)
     按下 #A8360F 白字 7.1:1 ✓ · 主橙 #D9541E 白字 5.2:1 ✓(v2 是 4.75)
     这样"漂亮橙"和"主橙"拉开，主按钮就不再是死沉的棕红。 */
  --brand:        #FF6B35;   /* 漂亮橙 · 只用于"无文字"的图形/填充 */
  --brand-btn:    #D9541E;   /* 主橙 · 白字 5.2:1 ✓ 按钮主色 */
  --brand-press:  #A8360F;   /* 按下 · 白字 7.1:1 ✓ */
  --brand-ink:    #A8360F;   /* 橙字白底 7.1:1 ✓ 文字 */
  --brand-weak:   #FFF0E5;   /* 浅橙底（输入条/弱标识） */
  --brand-line:   #FFCBA8;   /* 描边/分割橙（v2 是 #FFD9C6 太浅，几乎看不见） */
  --brand-glow:   #FF9466;   /* 暖橙光晕 · 用于头像 ring / 微光 */

  /* === 渐变（v3 新增）===
     v2 把渐变锁在 #C9451A→#B03C10 是为了"白字压上去仍达标"。
     v3 拆开用途：
        ● --brand-grad     仍用于按钮底渐变（仍向 v2 兼容，亮端是 #C9451A 不破规则）
        ● --brand-aurora   用于 hero 卡 / 顶部状态条 / 分享海报（无文字或浅色文字）
                          亮端可放回漂亮橙 #FF6B35，配深色文字时仍可读。
        ● --brand-mesh     hero 卡背景的高级渐变（多段色） */
  --brand-grad:   linear-gradient(135deg, #D9541E 0%, #A8360F 100%);
  --brand-aurora: linear-gradient(135deg, #FF6B35 0%, #D9541E 60%, #8B2D0F 100%);
  --brand-mesh:   radial-gradient(120% 100% at 0% 0%, #FF9466 0%, transparent 60%),
                  radial-gradient(120% 100% at 100% 100%, #FFCBA8 0%, transparent 50%),
                  linear-gradient(135deg, #FF8A50 0%, #D9541E 100%);

  /* === 账目语义色 ===
     v3 改：绿色太浅太淡 → 主绿加深到 #097A56(文 #0E7C56 白底 5.0:1 ✓)，
     浅绿底从 #E8F5EC 改为 #C8EFD4(更鲜)，收入红/支出红也同步加深一档。 */
  --income:       #0E7C56;   /* 主绿 · 加深 + 鲜 */
  --income-weak:  #C8EFD4;   /* 浅绿底 · 加饱和 */
  --expense:      #C81E1E;   /* 主红 · 同步加深（视觉重量跟主绿匹配） */
  --expense-weak: #FBD2D2;   /* 浅红底 · 加饱和 */
  --warn:         #C25A04;   /* 警示橙 · 加深 */
  --warn-weak:    #FFE4B5;   /* 浅警示橙底 */
  --info:         #1554D3;   /* 信息蓝 · 加深一档 */
  --info-weak:    #CFE0FF;   /* 浅蓝底 */

  /* === 中性色阶 === */
  --t1:           #101828;   /* 主文字 15.9:1 */
  --t2:           #344054;   /* 次文字 10.4:1 */
  --t3:           #667085;   /* 辅助文字 5.0:1 */
  --t4:           #98A2B3;   /* 仅占位符/装饰 */
  --line:         #EDF0F3;
  --line-strong:  #D0D5DD;
  --fill:         #F2F4F7;
  --bg:           #F6F7F9;
  --card:         #FFFFFF;
  --glass-bg:     rgba(255, 255, 255, .72);  /* Glass 容器底 */
  --glass-bd:     rgba(255, 255, 255, .55);  /* Glass 描边 */

  /* === 圆角（v3 加大） === */
  --r-xs:         8rpx;
  --r-sm:         16rpx;
  --r-md:         24rpx;
  --r-lg:         36rpx;
  --r-xl:         48rpx;
  --r-full:       999rpx;

  /* === 阴影（v3 四级 + 一道暖光） === */
  --sh-card:  0 1rpx 2rpx rgba(16, 24, 40, .04), 0 8rpx 24rpx -8rpx rgba(16, 24, 40, .08);
  --sh-lift:  0 2rpx 6rpx rgba(16, 24, 40, .05), 0 16rpx 32rpx -12rpx rgba(16, 24, 40, .12);
  --sh-float: 0 8rpx 32rpx -8rpx rgba(16, 24, 40, .16);
  --sh-glow:  0 12rpx 32rpx -16rpx rgba(201, 69, 26, .35);  /* 暖橙微光 · 主按钮 / AI 入口 */

  /* === 字号（v3 加强金额与标题层级） === */
  --fs-num-xl:  72rpx;   /* hero 大金额 ·  金额主角 */
  --fs-num-lg:  56rpx;   /* 月报/日报主金额 */
  --fs-title:   48rpx;   /* 页头大标题 */
  --fs-h2:      36rpx;
  --fs-h3:      32rpx;
  --fs-body:    28rpx;
  --fs-sm:      26rpx;
  --fs-xs:      24rpx;

  /* === 尺寸 === */
  --tabbar-h:    120rpx;
  --sheet-rest:  env(safe-area-inset-bottom, 0px);

  /* 账目语义色（全部 ≥4.4:1，深色底也能看清） */
  --income: #0B7A43;         /* 收入 / 回款 */
  --income-weak: #E8F5EC;
  --expense: #D92D20;        /* 支出 / 付款 */
  --expense-weak: #FDECEA;
  --warn: #B54708;           /* 应收 / 待办 */
  --warn-weak: #FFF6E5;
  --info: #175CD3;           /* 应付 / 中性提示 */
  --info-weak: #EDF3FF;

  /* 中性色阶（统一一套灰，替换原先散落的 #999/#bbb/#ccc/#666） */
  --t1: #101828;             /* 主文字 15.9:1 */
  --t2: #344054;             /* 次文字 10.4:1 */
  --t3: #667085;             /* 辅助文字 5.0:1（正文灰的下限） */
  --t4: #98A2B3;             /* 仅占位符/装饰，不承载信息 */
  --line: #EDF0F3;
  --fill: #F2F4F7;
  --bg: #F6F7F9;
  --card: #FFFFFF;

  /* 圆角 / 阴影 / 尺寸 */
  --r-sm: 12rpx;
  --r-md: 20rpx;
  --r-lg: 32rpx;
  --r-full: 999rpx;
  --sh-card: 0 1rpx 2rpx rgba(16, 24, 40, .04), 0 8rpx 24rpx -8rpx rgba(16, 24, 40, .08);
  --sh-float: 0 8rpx 32rpx -8rpx rgba(16, 24, 40, .16);
  --tabbar-h: 120rpx;
  /* 弹层（.sheet）的"静止位置"—— 没有键盘时它停在离屏幕底部多高的地方。
     默认值是**二级页**的情形（页面没有 tabBar，弹层贴底但要避开 Home 指示条）。
     ⚠️ TabBar 页必须覆盖它（弹层停在 tabBar 之上，否则会被 tabBar 压住一截）：
        page { --sheet-rest: calc(var(--tabbar-h) + env(safe-area-inset-bottom, 0px)); }
     🔴 2026-09-22 收口：原来这个值散在 6 个二级页各自的 .sheet 里（还配一句
        `padding-bottom: env(safe-area-inset-bottom)`）—— 每个新二级页都要抄一遍，
        而**全站曾经 6 个页面同时漏抄**（弹层底下漏出约 120rpx 的缝 / 键盘压住输入框）。
        现在把安全区并进这个变量、弹层自身 padding 归零，位置与收口前**完全等价**，
        二级页从此**一个覆盖都不用写**。 */
  --sheet-rest: env(safe-area-inset-bottom, 0px);

  background: var(--bg);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
  line-height: 1.55;
  color: var(--t1);
  -webkit-font-smoothing: antialiased;
}

/* ---------- 2. 布局骨架 ---------- */
.container {
  padding: 0 28rpx;
  /* 双声明做渐进增强：不支持 env() 的旧 WebView 用上一行，支持的用下一行 */
  padding-bottom: calc(var(--tabbar-h) + 60rpx);
  padding-bottom: calc(var(--tabbar-h) + 60rpx + env(safe-area-inset-bottom, 0px));
}
/* 二级页（navigateTo 打开的页面）没有 TabBar，不需要预留它的高度 */
.container-page {
  padding-bottom: 72rpx;
  padding-bottom: calc(72rpx + env(safe-area-inset-bottom, 0px));
}
/* 底部有固定操作条时再额外留出空间 */
.container-cta {
  padding-bottom: 190rpx;
  padding-bottom: calc(190rpx + env(safe-area-inset-bottom, 0px));
}
/* 固定在底部的操作条 */
.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  /* 这里**故意**不跟键盘抬：键盘弹起时底部操作条被遮住是正常的，
     抬上来反而会挡住用户正在填的那几行（采购页明细）。收键盘就看见了。
     跟键盘抬的只有「自己里面有输入框」的容器（.dock / 带输入的 .sheet）。 */
  z-index: 900;
  display: flex;
  align-items: center;
  padding: 20rpx 28rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom, 0px));
  background: rgba(255, 255, 255, .97);
  border-top: 1rpx solid var(--line);
  box-shadow: 0 -8rpx 24rpx -18rpx rgba(16, 24, 40, .35);
}
.bottom-bar .btn {
  flex: 1;
}

/* 页面头：左对齐，替代原先“居中大标题”（居中标题 + 原生导航栏 = 信息重复 + 弱层次） */
.page-head {
  padding: 32rpx 4rpx 24rpx;
}
.page-title {
  font-size: 44rpx;
  font-weight: 700;
  color: var(--t1);
  line-height: 1.3;
}
.page-sub {
  margin-top: 8rpx;
  font-size: 26rpx;
  color: var(--t3);
}

/* ---------- 3. 卡片 ---------- */
.card {
  background: var(--card);
  border-radius: var(--r-lg);
  padding: 36rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--sh-card);
  transition: transform .16s ease, box-shadow .16s ease;
}
.card:active {
  transform: scale(.998);
  box-shadow: 0 1rpx 2rpx rgba(16, 24, 40, .04), 0 4rpx 12rpx -4rpx rgba(16, 24, 40, .08);
}
.card-flush {
  padding: 8rpx 32rpx;
}
.card-hd {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}
.card-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--t1);
}
.card-more {
  font-size: 26rpx;
  color: var(--t3);
}

/* ---------- 4. 按钮 ---------- */
.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 96rpx;
  border-radius: var(--r-full);
  font-size: 32rpx;
  font-weight: 600;
  transition: transform .16s ease, background-color .16s ease, opacity .16s ease;
}
.btn-primary {
  background: var(--brand-btn);
  color: #fff;
  box-shadow: 0 4rpx 12rpx -4rpx rgba(201, 69, 26, .4);
}
.btn-primary:active {
  background: var(--brand-btn-press);
  transform: scale(.98);
  box-shadow: 0 2rpx 6rpx -2rpx rgba(201, 69, 26, .3);
}
.btn-ghost {
  background: var(--fill);
  color: var(--t2);
}
.btn-ghost:active {
  background: #E7EBF0;
  transform: scale(.97);
}
.btn-outline {
  background: transparent;
  color: var(--brand-ink);
  border: 2rpx solid var(--brand-line);
}
/* 危险操作（删除、注销）。用语义红：跟「支出」是同一套颜色语言，
   老板看到红就知道这一步不可逆。白字对比度 4.83:1 ✓ */
.btn-danger {
  background: var(--expense);
  color: #fff;
  box-shadow: 0 8rpx 20rpx -8rpx rgba(217, 45, 32, .55);
}
.btn-danger:active {
  background: #B42318;
  transform: scale(.97);
}
.btn-sm {
  height: 76rpx;
  font-size: 28rpx;
}
.btn-block {
  width: 100%;
}
.btn[disabled],
.btn.is-disabled {
  opacity: .45;
}

/* 原生 button 复位（pending 等页仍在用 button） */
button::after {
  border: none;
}
.btn-reset {
  padding: 0;
  margin: 0;
  line-height: inherit;
  background: transparent;
  border-radius: 0;
  font-size: inherit;
  color: inherit;
}
.btn-reset::after {
  border: none;
}

/* ---------- 5. 数字与金额 ---------- */
/* tabular-nums：等宽数字，让一列金额的小数点在竖直方向对齐，扫读效率显著提升 */
.num {
  font-family: "DIN Alternate", "SF Pro Display", "Helvetica Neue", sans-serif;
  font-variant-numeric: tabular-nums;
  font-feature-settings: "tnum" 1;
  letter-spacing: -.02em;
}
.money-lg {
  font-size: 64rpx;
  font-weight: 700;
  line-height: 1.15;
}
.money-md {
  font-size: 44rpx;
  font-weight: 700;
  line-height: 1.2;
}
.money-sm {
  font-size: 32rpx;
  font-weight: 600;
}
.c-income {
  color: var(--income);
}
.c-expense {
  color: var(--expense);
}
.c-warn {
  color: var(--warn);
}
.c-info {
  color: var(--info);
}
.c-brand {
  color: var(--brand-ink);
}
.c-t1 { color: var(--t1); }
.c-t2 { color: var(--t2); }
.c-t3 { color: var(--t3); }

/* ---------- 6. 通用列表行 ---------- */
.list {
  padding: 4rpx 32rpx;
}
.row {
  display: flex;
  align-items: center;
  min-height: 112rpx;
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--line);
  transition: background .12s ease;
}
.row:last-child {
  border-bottom: none;
}
.row-tap:active {
  background: var(--fill);
}
.row-main {
  flex: 1;
  min-width: 0;
}
.row-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--t1);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.row-sub {
  margin-top: 6rpx;
  font-size: 25rpx;
  color: var(--t3);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.row-val {
  margin-left: 24rpx;
  flex-shrink: 0;
  text-align: right;
}
.row-arrow {
  margin-left: 16rpx;
  width: 16rpx;
  height: 16rpx;
  border-right: 3rpx solid var(--t4);
  border-top: 3rpx solid var(--t4);
  transform: rotate(45deg);
  flex-shrink: 0;
}
.row-ico {
  width: 72rpx;
  height: 72rpx;
  border-radius: var(--r-md);
  background: var(--fill);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
  margin-right: 24rpx;
  flex-shrink: 0;
}
.row-ico-img {
  width: 40rpx;
  height: 40rpx;
}

/* ---------- 7. 标签 ---------- */
.tag {
  display: inline-flex;
  align-items: center;
  height: 44rpx;
  padding: 0 16rpx;
  border-radius: 10rpx;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 1;
}
.tag-income { background: var(--income-weak); color: var(--income); }
.tag-expense { background: var(--expense-weak); color: var(--expense); }
.tag-warn { background: var(--warn-weak); color: var(--warn); }
.tag-info { background: var(--info-weak); color: var(--info); }
.tag-brand { background: var(--brand-weak); color: var(--brand-ink); }
.tag-gray { background: var(--fill); color: var(--t3); }

/* ---------- 8. 空状态（图标 + 说明 + 行动，替代纯文字） ---------- */
.empty {
  padding: 88rpx 32rpx;
  text-align: center;
}
.empty-ico {
  width: 88rpx;
  height: 88rpx;
  display: block;
  margin: 0 auto 24rpx;
  opacity: .45;
}
.empty-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--t2);
}
.empty-desc {
  margin-top: 10rpx;
  font-size: 26rpx;
  color: var(--t3);
  line-height: 1.6;
}
.empty-action {
  display: inline-flex;
  align-items: center;
  /* 原来 76rpx（38px），不到 44px 的触控下限。空状态里那个按钮往往正是唯一的出路，
     点不中等于把人堵在这儿 —— 按全站规则提到 88rpx。 */
  height: 88rpx;
  padding: 0 44rpx;
  margin-top: 28rpx;
  border-radius: var(--r-full);
  background: var(--brand-btn);
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
}

/* ---------- 9. 筛选 chip ---------- */
.chip-bar {
  display: flex;
  flex-wrap: wrap;
  margin: 0 -8rpx 24rpx;
}
.chip {
  height: 76rpx;
  padding: 0 28rpx;
  margin: 0 8rpx 16rpx;
  border-radius: var(--r-full);
  background: var(--card);
  color: var(--t2);
  font-size: 30rpx;
  display: flex;
  align-items: center;
  box-shadow: var(--sh-card);
}
.chip.is-on {
  background: var(--brand-btn);
  color: #fff;
  font-weight: 600;
}

/* ---------- 9b. 分段控件（同一份数据的几种看法，平级切换） ---------- */
/* 与 chip 的分工：chip 是「筛掉一部分」，seg 是「换个角度看同一批数据」——
   所以 seg 的选中态用浅底 + 深字，不用实心橙：它不改变数据范围，不该抢主按钮的位置。 */
.seg {
  display: flex;
  padding: 6rpx;
  margin-bottom: 24rpx;
  border-radius: var(--r-full);
  background: var(--fill);
}
.seg-i {
  flex: 1;
  min-width: 0;
  /* 原来 72rpx（36px），不到 44px 的触控下限。分段控件是整页最高频的开关，
     按全站规则提到 88rpx。 */
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--r-full);
  font-size: 28rpx;
  color: var(--t2);
  transition: background .16s ease, color .16s ease;
}
.seg-i.is-on {
  background: var(--card);
  color: var(--brand-ink);
  font-weight: 600;
  box-shadow: 0 2rpx 8rpx -2rpx rgba(16, 24, 40, .1);
}

/* ---------- 10. 底部弹层（统一替代居中弹窗，拇指可达） ---------- */
.sheet-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(16, 24, 40, .45);
  z-index: 1000;
  animation: yb-fade .2s ease;
}
.sheet {
  position: fixed;
  left: 0;
  right: 0;
  /* 弹层停在 `--sheet-rest` 之上；键盘弹起时（--kb-lift > 0）整体抬到键盘上面。
     ⚠️ 用 max() 取更高者，**不能相加**：键盘弹起时 tabBar 已被键盘压住，
        再加它的高度会悬空一条缝（项目踩过这个坑）。
     ⚠️ `--sheet-rest` 的默认值定义在 page{}（= **二级页**的情形）；
        TabBar 页各自覆盖它，见那个变量的注释。
     ⚠️ 离底距离已经含了安全区，所以下面的 padding-bottom 保持 0 ——
        **别再补 padding，补了就多出一条 Home 指示条的空白**（这正是收口前的重复来源）。
     🔴 2026-09-22 更正：这里原来写着"非 TabBar 页覆盖成 bottom: 0 即可"—— **那条是错的** ✗
        写 bottom: 0 会把键盘抬升（--kb-lift）一起丢掉，弹层里有输入框的页面会被键盘压住。
        这句错注释就是当初 6 个二级页一起踩坑的源头之一。 */
  bottom: var(--sheet-rest, 0px);   /* 老内核兜底 */
  bottom: max(var(--sheet-rest, env(safe-area-inset-bottom, 0px)), var(--kb-lift, 0px));
  z-index: 1001;
  background: var(--card);
  border-radius: 36rpx 36rpx 0 0;
  padding-bottom: 0;
  animation: yb-up .28s cubic-bezier(.32, .72, 0, 1);
  max-height: 88vh;
  /* 键盘弹起时弹层要整体挪到键盘上方，高度上限也得跟着让出来，
     否则它会被"抬上去"却仍然高过可视区，顶部内容够不着。 */
  max-height: calc(88vh - var(--kb-lift, 0px));
  display: flex;
  flex-direction: column;
  overflow: hidden;
  /* 🔴 盒模型（2026-09-20 真机截图后补）
     小程序默认 box-sizing: content-box，而弹层里 .sheet-bd / .sheet-ft
     / .chat-input-bar 都是「flex 子项 + 左右 32rpx 内边距」：被拉伸到 100% 宽之后，
     内边距又额外加一遍，总宽超出 64rpx。文字左对齐的弹层看不出来（右边只多一片空白），
     但**对话气泡用 max-width 往右撑就露馅** —— 真机截图里 AI 气泡和用户气泡右边
     都被切掉一截，就是它干的。
     ⚠️ 别想着用 `.sheet *` 一次罩住所有后代：**wxss 不支持 `*` 通配符**，
     写了直接编译失败（2026-09-20 已经栽过一次，模拟器报「编译 .wxss 文件错误」）。
     要加就在每个容器上显式写，下面 .sheet-bd / .sheet-ft / .chat-input-bar 都是这么办的。 */
  box-sizing: border-box;
}
.sheet-handle {
  width: 72rpx;
  height: 8rpx;
  border-radius: 4rpx;
  background: var(--line);
  margin: 16rpx auto 0;
  flex-shrink: 0;
}
.sheet-hd {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 32rpx 20rpx;
  flex-shrink: 0;
}
.sheet-title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--t1);
}
.sheet-close {
  width: 64rpx;
  height: 64rpx;
  margin-right: -12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}
.sheet-close::before,
.sheet-close::after {
  content: "";
  position: absolute;
  width: 30rpx;
  height: 3rpx;
  border-radius: 2rpx;
  background: var(--t4);
}
.sheet-close::before { transform: rotate(45deg); }
.sheet-close::after { transform: rotate(-45deg); }
.sheet-bd {
  padding: 0 32rpx;
  flex: 1;
  min-height: 0;
  /* 宽度含内边距。不写这行，被拉伸到 100% 后 32rpx 又额外加上去，右边溢出 */
  box-sizing: border-box;
}
.sheet-ft {
  display: flex;
  padding: 20rpx 32rpx 28rpx;
  flex-shrink: 0;
  box-sizing: border-box;
}
.sheet-ft .btn {
  flex: 1;
}
.sheet-ft .btn + .btn {
  margin-left: 20rpx;
}

/* ---------- 11. 键值信息块 ---------- */
.kv {
  background: var(--fill);
  border-radius: var(--r-md);
  padding: 8rpx 24rpx;
  margin-bottom: 24rpx;
}
.kv-row {
  display: flex;
  align-items: flex-start;
  padding: 18rpx 0;
  border-bottom: 1rpx solid rgba(16, 24, 40, .05);
}
.kv-row:last-child {
  border-bottom: none;
}
.kv-k {
  width: 130rpx;
  flex-shrink: 0;
  font-size: 26rpx;
  color: var(--t3);
}
.kv-v {
  flex: 1;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--t1);
  word-break: break-all;
}

/* ---------- 12. 统计分栏 ---------- */
.stat-grid {
  display: flex;
}
.stat-col {
  flex: 1;
  min-width: 0;
}
.stat-col + .stat-col {
  margin-left: 20rpx;
}
.stat-k {
  font-size: 25rpx;
  color: var(--t3);
  margin-bottom: 10rpx;
}
.stat-v {
  font-size: 42rpx;
  font-weight: 700;
}
.stat-line {
  width: 2rpx;
  background: var(--line);
  margin: 8rpx 36rpx;
}

/* ---------- 13. 骨架屏（替代整页白屏） ---------- */
@keyframes yb-skeleton {
  0% { opacity: 1; }
  50% { opacity: .45; }
  100% { opacity: 1; }
}
.skeleton-line {
  height: 28rpx;
  border-radius: 6rpx;
  background: var(--fill);
  animation: yb-skeleton 1.2s ease-in-out infinite;
}

/* ---------- 13.5 错误状态（统一错误展示 + 重试按钮） ---------- */
.error-state {
  padding: 88rpx 32rpx;
  text-align: center;
}
.error-ico {
  width: 88rpx;
  height: 88rpx;
  display: block;
  margin: 0 auto 24rpx;
  opacity: .45;
}
.error-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--t2);
}
.error-desc {
  margin-top: 10rpx;
  font-size: 26rpx;
  color: var(--t3);
  line-height: 1.6;
}
.error-action {
  display: inline-flex;
  align-items: center;
  height: 88rpx;
  padding: 0 44rpx;
  margin-top: 28rpx;
  border-radius: var(--r-full);
  background: var(--brand-btn);
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
}
.error-action:active {
  transform: scale(0.96);
  opacity: 0.9;
}

/* ---------- 14. 动效 ---------- */
@keyframes yb-fade {
  from { opacity: 0; }
  to { opacity: 1; }
}
@keyframes yb-up {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}
@keyframes yb-pop {
  from { opacity: 0; transform: scale(.94); }
  to { opacity: 1; transform: scale(1); }
}

/* ---------- 15. 响应式：大屏（平板 / 折叠屏展开）限制内容宽度 ---------- */
/* rpx 按屏宽等比放大，不做限制会导致 iPad 上字号巨大、行宽过长难以扫读 */
@media (min-width: 520px) {
  .container {
    max-width: 760px;
    margin-left: auto;
    margin-right: auto;
  }
  .sheet {
    max-width: 760px;
    margin-left: auto;
    margin-right: auto;
    left: 0;
    right: 0;
  }
}

/* ---------- 16. 工具类 ---------- */
.flex { display: flex; }
.flex-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.flex-center {
  display: flex;
  align-items: center;
  justify-content: center;
}
.items-center { align-items: center; }
.flex-1 { flex: 1; min-width: 0; }
.mt-8 { margin-top: 8rpx; }
.mt-16 { margin-top: 16rpx; }
.mt-24 { margin-top: 24rpx; }
.mb-16 { margin-bottom: 16rpx; }
.mb-24 { margin-bottom: 24rpx; }
.t-sm { font-size: 26rpx; }
.t-xs { font-size: 24rpx; }
.t-bold { font-weight: 600; }
/* 页面底部留白：二级页/列表页末尾统一用它收尾（往来、往来详情、成员管理三页共用） */
.bottom-space { height: 40rpx; }
.divider {
  height: 1rpx;
  background: var(--line);
  margin: 24rpx 0;
}
.ellipsis {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.tap-dim:active {
  opacity: .7;
}
/* ---------- 13. 通用工具类 ---------- */
/* 这三样被 3 个以上页面用到，之前每个页面各抄一份（.line1 抄了 2 次、.ph 只有 1 个页面有，
   另外 3 个页面的输入框占位符颜色其实是失效的）。放在这里，全站才真的一致。 */
.line1 {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
/* 输入框占位符。用 placeholder-class="ph" 引它 ——
   注意小程序**没有** ::placeholder 伪元素，占位符只能靠这个类。 */
.ph {
  color: var(--t4);
  font-size: 27rpx;
}

/* 表单输入框（2026-09-22 收口）。之前 4 个页面各抄一份，还抄歪了两份：
     记账页 height:96rpx / 我的页 height:88rpx  → 正常
     往来页、成员管理 只写了 padding: 24rpx，**没写 height** → 文字被垂直裁掉
   根因：微信 `<input>` 有约 64rpx 的**组件默认高度**，padding 上下各吃一份，
   只剩十几 rpx 去装 28rpx 的字 —— 下半个字就没了。
   用户看着像"字号不对"，其实是盒子太矮（调字号是治错了病）。
   88rpx = 44px，同时满足全站"触控区 ≥88rpx"的规范。 */
.f-input {
  width: 100%;
  height: 88rpx;
  padding: 0 24rpx;
  box-sizing: border-box;
  border-radius: var(--r-md);
  background: var(--fill);
  font-size: 29rpx;
  color: var(--t1);
}

/* ---------- 14. 区块头（列表/表格上方的小标题行） ---------- */
.list-hd {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding: 20rpx 4rpx 12rpx;
}
.list-hd-t {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--t1);
}
/* 标题后面那句小提示（「点某天看明细」）。压低存在感，只在需要时被看见 */
.list-hd-l {
  display: flex;
  align-items: baseline;
  min-width: 0;
}
.list-hd-hint {
  margin-left: 14rpx;
  font-size: 28rpx;
  font-weight: 600;
  /* 2026-09-22 修对比度：原来是白字压 #FF6B35，只有 2.81:1 ——
     而「#FF6B35 禁止承载文字」正是本项目自己写在 custom-tab-bar/index.wxss 注释里的规则，
     这里等于破了自己的例（真机截图里"左滑可改可删""点这里展开"就是这个样子）。
     改成浅橙底 + 品牌橙字：5.4:1 ✓，同时也和"分享"等次要按钮的浅橙语言统一。 */
  color: var(--brand-ink);
  background: var(--brand-weak);
  border: 1rpx solid var(--brand-line);
  padding: 8rpx 20rpx;
  border-radius: 24rpx;
}
/* 右侧的次要动作（「识别有误？改一下」）。上下给足内边距，撑到 88rpx 触控线 */
.list-hd-reset {
  font-size: 26rpx;
  color: var(--brand-ink);
  padding: 26rpx 0 26rpx 24rpx;
}
.list-hd-reset:active {
  opacity: .6;
}

/* ---------- 品牌区（注册页 bind-phone / 登录页 login 共用） ----------
   2026-09-20 从 bind-phone.wxss 提上来：这两页是同一个场景（用户第一次进来 /
   登录没连上要重试），视觉必须完全一致 —— 各写一份迟早会长歪。
   放在这里而不是各自复制，也符合"一个类被 ≥2 个页面用到就住在 app.wxss"。 */
.brand-page {
  min-height: 100vh;
  padding: 0 40rpx;
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom, 0px));
  background: var(--bg);
}
.brand {
  padding: 84rpx 0 52rpx;
  text-align: center;
}
.brand-mark {
  width: 152rpx;
  height: 152rpx;
  margin: 0 auto 28rpx;
  border-radius: 44rpx;
  /* 双声明做渐进增强：不支持 var() 时退回品牌实底色（白 logo 同样达标），
     避免 var 解析失败变成透明底 → 白图标压白底彻底隐形。与项目里 env() 的写法一致。 */
  background: #C9451A;
  background: var(--brand-grad);
  box-shadow: 0 20rpx 40rpx -16rpx rgba(201, 69, 26, .55);
  display: flex;
  align-items: center;
  justify-content: center;
}
.brand-mark-ico {
  width: 86rpx;
  height: 86rpx;
}
.brand-name {
  font-size: 50rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  color: var(--t1);
  line-height: 1.25;
}
/* 核心主张：整页最重要的一句话，给品牌橙、给粗体、给独立的呼吸空间 */
.brand-slogan {
  margin-top: 18rpx;
  font-size: 33rpx;
  font-weight: 600;
  letter-spacing: .6rpx;
  color: var(--brand-ink);
  line-height: 1.4;
}
.brand-sub {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: var(--t3);
}
/* 品牌区下方的大按钮 + 退路链（两页共用同一套节奏） */
.brand-cta {
  margin-top: 40rpx;
}
.brand-skip {
  margin-top: 28rpx;
  padding: 24rpx 0;
  text-align: center;
  font-size: 27rpx;
  color: var(--t3);
}
.brand-skip:active {
  opacity: .6;
}
/* 24rpx 是字号下限（12px）；颜色用 --t3 而不是 --t4 ——
   这句话是要被读的（解释为什么到了这一页），不是装饰。 */
.brand-note {
  margin-top: 16rpx;
  text-align: center;
  font-size: 24rpx;
  color: var(--t3);
  line-height: 1.6;
}

/* ---------- 跨页面共用的小组件（2026-09-20 从各页面提上来） ----------
   判据很严：**只收那些在两个页面里逐字相同的定义**
   （用 _verify/dup-classes.js 逐字比对过，属性顺序不同、内容相同也算）。
   只要有一丁点差异 —— 哪怕只差 1rpx —— 就一律留在页面里：
   那多半是有意的规格差异（同一个卡片在记账页是 96rpx、在报表页是 76rpx），
   合并会把其中一个页面改样。剩下的差异清单见审查报告。 */

/* 表单块：记账页的「改一下」和我的页的「改店名」共用同一套 */
.f-block {
  margin-bottom: 28rpx;
}
.f-label {
  font-size: 28rpx;
  color: var(--t3);
  margin-bottom: 12rpx;
}
/* 必填星号（往来页 / 成员管理页共用） */
.f-required {
  color: var(--expense);
  font-size: 28rpx;
}
/* 区块小标题（往来详情 / 成员管理共用）。
   ⚠️ 我的页里另有一份同名的 .section-title，**不要合并**：那一页是通栏卡片布局，
   需要自带左右 36rpx 内边距；这两页的 .container 已经给了 28rpx，再补就会缩进过头。
   同类情况见 `.me-avatar` 与 `.info-avatar`（同名不同上下文，别一刀切）。 */
.section-title {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--t3);
  padding: 32rpx 0 16rpx;
  letter-spacing: 1rpx;
}

/* 采购单据里的品名与尾部留白（核对页 / 列表页共用） */
.po-name {
  font-size: 31rpx;
  font-weight: 600;
  color: var(--t1);
}
.po-tail {
  height: 24rpx;
}

/* 日期分组：记账页与查询页的日期行 */
.day-sum {
  font-size: 24rpx;
  color: var(--t3);
}

/* 往来卡里的小字（金额下面的说明） */
.debt-s {
  font-size: 24rpx;
  color: var(--t4);
}

/* 打勾圆点：注册页的"为什么值得"和记账页的同款列表共用 */
.mk {
  width: 28rpx;
  height: 28rpx;
  flex: none;
  margin: 8rpx 12rpx 0 0;
  position: relative;
  border-radius: 50%;
  background: var(--income-weak);
}
.mk::after {
  content: "";
  position: absolute;
  left: 7rpx;
  top: 7rpx;
  width: 11rpx;
  height: 6rpx;
  border-left: 3rpx solid var(--income);
  border-bottom: 3rpx solid var(--income);
  transform: rotate(-45deg);
}

/* ══════════ 语音输入条（全站公共组件）══════════
   2026-09-20 从 pages/advisor 抽出来 —— 老板要求记账页和参谋页用同一套。
   结构固定为三件：[+] [🎤 输入框] [发送]
     · 点「+」弹上传面板（拍照 / 相册 / 传文件），浮层用 .ibar-upload
     · 话筒在输入框内；**按住输入框说话、松手提交，单击仍是聚焦打字**
       （两页的"提交"含义不同：记账页=入账，参谋页=提问，由页面自己决定）
   ⚠️ .ibar-upload 是 absolute，靠 .ibar 的 position:relative 定位 —— 两者必须成对出现。
   ⚠️ 类名以 ibar- 开头，别和其他页面的 class 撞。 */
.ibar {
  display: flex;
  align-items: center;
  /* 左右内边距收到 20rpx：输入框要尽量宽（老板反馈换新输入条后"太窄"）；
     上下收到 18rpx：整条做薄、往下贴，给上面的追问框让地方 */
  padding: 18rpx 28rpx;
  padding-bottom: calc(18rpx + env(safe-area-inset-bottom, 0px));
  border-top: 1rpx solid var(--line);
  flex-shrink: 0;
  /* 🔴 必须有：上传浮层 .ibar-upload 是 absolute 定位，靠这个变成"相对输入条"算 bottom。
     2026-09-20 漏了这行，浮层的 bottom:calc(100%+16rpx) 就一路往上找到 .sheet（fixed），
     100% 变成整个弹层的高度（80vh）—— 浮层被推到屏幕外，表现就是"点 + 没反应"。
     （其实是渲染了，只是长在看不见的地方。） */
  position: relative;
  /* 宽度含内边距：不带这行，被拉伸到 100% 后左右各多 24rpx，输入条右边被切 */
  box-sizing: border-box;
}

/* ══════ 「+」按钮 ══════
   老板要求：左侧只留一个 +。单手好按。
   2026-09-20 收到 72rpx：把宽度让给输入框（老板反馈输入框太窄）；
   09-21 再收到 64rpx + 加号改品牌色——配合浅橙输入框，整条操作区更醒目。 */
.ibar-plus {
  width: 88rpx;
  height: 112rpx;
  flex: none;
  margin-right: 12rpx;
  border-radius: var(--r-full);
  background: var(--brand-weak);
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}
.ibar-plus:active,
.ibar-plus-hover {
  background: rgba(228, 85, 29, .15);
}
.ibar-plus-ico {
  width: 36rpx;
  height: 36rpx;
  position: relative;
}
.ibar-plus-ico::before,
.ibar-plus-ico::after {
  content: "";
  position: absolute;
  left: 50%;
  top: 50%;
  background: var(--brand-ink);
  border-radius: 2rpx;
  transform: translate(-50%, -50%);
}
.ibar-plus-ico::before {
  width: 36rpx;
  height: 5rpx;
}
.ibar-plus-ico::after {
  width: 5rpx;
  height: 36rpx;
}

/* ══════ 输入框（话筒在框内）══════
   2026-09-21 方案A（老板确认）：浅灰底压在白色底栏上"不亮堂、不醒目"，
   改成**品牌浅橙底** + 话筒图标品牌色 + 高度 96→112rpx，输入区更大更亮眼；
   话筒图标换 ic-mic-o.svg（品牌深橙），CI 上用 ic-mic-d.svg（深灰）已不用。
   这个 view 同时是"按住说话"的触摸区，所以它必须够大、好按。 */
.ibar-field {
  flex: 1;
  min-width: 0;
  height: 112rpx;
  display: flex;
  align-items: center;
  padding: 0 28rpx;
  margin-right: 12rpx;
  border-radius: var(--r-full);
  background: var(--brand-weak);
  box-sizing: border-box;
  /* 录音时整框变品牌色 —— 比只改图标更醒目，老板一眼知道"它在听" */
  transition: background .12s ease;
}
.ibar-field.is-rec {
  background: var(--brand-btn);
}
.ibar-field-ico {
  width: 44rpx;
  height: 44rpx;
  flex: none;
  margin-right: 16rpx;
}
.ibar-input {
  flex: 1;
  min-width: 0;
  height: 112rpx;
  font-size: 32rpx;
  color: var(--t1);
}
.ibar-send {
  height: 112rpx;
  padding: 0 28rpx;
  margin-left: 0;
  border-radius: var(--r-full);
  background: var(--brand-btn);
  color: #fff;
  font-size: 26rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  flex-shrink: 0;
  box-sizing: border-box;
}
.ibar-send:active {
  background: var(--brand-btn-press);
}
.ibar-send.is-disabled {
  opacity: .4;
}

/* ══════ 上传面板（点「+」弹出）══════
   在输入条上方居中的小浮层。用图标宫格，和记账页的加号面板同一套视觉语言 ——
   老板明确说过要图标、不要 wx.showActionSheet 那种文字列表。 */
.ibar-upload {
  position: absolute;
  left: 0;
  right: 0;
  /* 100% = 输入条自身高度（浮层是 .ibar 的子元素） */
  bottom: calc(100% + 16rpx);
  display: flex;
  flex-direction: column;
  padding: 12rpx;
  border-radius: var(--r-lg);
  background: var(--card);
  box-shadow: 0 12rpx 40rpx -12rpx rgba(16, 24, 40, .28);
  box-sizing: border-box;
  z-index: 20;
}
.ibar-up-cell {
  display: flex;
  align-items: center;
  min-height: 108rpx;      /* 触控下限 88rpx，留点余量 */
  padding: 0 20rpx;
  border-radius: var(--r-md);
}
.ibar-up-cell:active,
.ibar-up-hover {
  background: var(--fill);
}
.ibar-up-ico {
  width: 76rpx;
  height: 76rpx;
  flex: none;
  margin-right: 20rpx;
  border-radius: var(--r-md);
  background: var(--brand-weak);
  display: flex;
  align-items: center;
  justify-content: center;
}
.ibar-up-img {
  width: 44rpx;
  height: 44rpx;
}
.ibar-up-t {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--t1);
}
.ibar-up-close {
  margin-top: 8rpx;
  padding: 20rpx 0 8rpx;
  text-align: center;
  font-size: 27rpx;
  color: var(--t3);
  border-top: 1rpx solid var(--line);
}
.ibar-up-close:active {
  opacity: .6;
}

/* ══════════ AI 追问入口卡（全站公共组件）══════════
   2026-09-22 从 pages/advisor 提到这里 —— 参谋入口现在有两处：
     · 报表页结余卡下方 → navigateTo 进参谋页（看完成绩接着追问，语义最顺）
     · 参谋页 hero 下方   → 就地开对话弹层
   两处必须是同一张卡，所以"长什么样"住在公共层，页面只留差异。

   2026-09-20 老板要求"做大、做醒目"：108rpx→152rpx 高、图标 64→88rpx、
   标题 34rpx、箭头放大成 56rpx 实心圆。浅橙底 + 深橙圆那一套跟全站一致。
   形态上刻意做成「一条」而不是「又一张卡」：卡片是"看"的，条是"点/说"的。 */
.ask-entry {
  display: flex;
  align-items: center;
  min-height: 152rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  background: linear-gradient(120deg, #FFEDE2 0%, #FFFBF8 100%);
  border-radius: var(--r-lg);
  box-shadow: var(--sh-card);
}
.ask-entry:active {
  background: #FFE0CC;
}
/* 深橙圆底 + 白图标：ic-sparkle.svg 原是灰描边（#98A2B3），
   放这个底上等于隐形 → 用白色版 ic-sparkle-w.svg（项目里已栽过两次同类坑） */
.ask-ico {
  width: 88rpx;
  height: 88rpx;
  flex: none;
  margin-right: 24rpx;
  border-radius: 50%;
  background: var(--brand-btn);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 20rpx -8rpx rgba(201, 69, 26, .55);
}
.ask-ico-img {
  width: 48rpx;
  height: 48rpx;
}
.ask-main {
  flex: 1;
  min-width: 0;
}
.ask-t {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--brand-ink);
}
.ask-d {
  margin-top: 8rpx;
  font-size: 26rpx;
  color: var(--t3);
}
/* 实心圆箭头 —— 裸 › 太轻，会被当成装饰而不是按钮 */
.ask-go {
  position: relative;
  width: 56rpx;
  height: 56rpx;
  flex: none;
  margin-left: 20rpx;
  border-radius: 50%;
  background: var(--brand-btn);
}
.ask-go::after {
  content: "";
  position: absolute;
  left: 21rpx;
  top: 19rpx;
  width: 15rpx;
  height: 15rpx;
  border-top: 4rpx solid #fff;
  border-right: 4rpx solid #fff;
  transform: rotate(45deg);
}

/* ══════════ 分享报表弹层（全站公共组件）══════════
   2026-09-22 合并：原来 pages/record 与 pages/summary **各写了一份**共 10 个 .sh-* 规则。
   合并前逐条比对，其中 6 个已经漂移 —— 一个用 var(--t3)、一个用 #667085；
   一个有 line-height、一个没有；图标圆角一个 18rpx、一个 var(--r-md)。
   这正是"同一个东西写两遍"的典型代价：改一处忘一处，两页慢慢长得不一样。
   现在合并到公共层，取更规范的那一份（用令牌、带 line-height）。
   判据沿用项目约定：一个类被 ≥2 个页面用到 → 就该住在 app.wxss。

   注意：两页的**选项数量**仍然不同（记账页 2 项、报表页 3 项），
   所以标记留在各自页面里 —— 这里只管"长什么样"，与 .ibar-* 的分工一致。 */
.sh-note {
  padding: 2rpx 0 18rpx;
  font-size: 25rpx;
  color: var(--t3);
}
.sh-opt {
  display: flex;
  align-items: center;
  min-height: 108rpx;
  padding: 22rpx 0;
  border-bottom: 1rpx solid var(--line);
}
.sh-opt.is-busy {
  opacity: .45;
}
/* 分享页面那一项是个原生 button（只有 open-type="share" 才能拉起微信转发面板），
   所以要把它复位成普通一行的样子：button 自带的白底 / 边框 / 居中都要清掉。 */
.sh-opt-btn {
  display: flex;
  align-items: center;
  width: 100%;
  background: transparent;
  border-radius: 0;
  font-size: inherit;
  font-weight: inherit;
  line-height: inherit;
  color: inherit;
  text-align: left;
}
.sh-ico {
  width: 72rpx;
  height: 72rpx;
  flex: none;
  margin-right: 24rpx;
  border-radius: var(--r-md);
  background: var(--brand-weak);
  display: flex;
  align-items: center;
  justify-content: center;
}
/* 主路径的图标底用实心橙：ic-brand.svg 本身是纯白图标（设计给深底用的），
   配浅底会白压浅、等于隐形。
   写成**复合选择器**而不是单独的类 —— 同权重下靠源码顺序决定胜负太脆
   （第一版就栽在这：.sh-ico-key 写在 .sh-ico 前面，橙底被浅底盖掉，图标直接看不见了）。
   把意图写进选择器，谁前谁后都不受影响。 */
.sh-ico.sh-ico-key {
  background: var(--brand-btn);
}
.sh-ico-img {
  width: 40rpx;
  height: 40rpx;
}
.sh-main {
  flex: 1;
  min-width: 0;
}
.sh-t {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--t1);
}
.sh-d {
  margin-top: 4rpx;
  font-size: 24rpx;
  line-height: 1.5;
  color: var(--t3);
}

/* ════════════════════════════════════════════════════════════════
   易帮账本 v3 · 时尚前卫微质感组件（追加）
   说明：v2 已有的 .card / .btn / .row / .empty 等不动；本段只新增
   「v3 视觉语言专用」类名。页面想升级就在原类上叠 v3- 前缀类：
       <view class="card v3-hero">     hero 渐变卡
       <view class="card v3-glass">    Glass 玻璃感卡
       <view class="money-lg v3-num">  大金额 tabular-nums
   不动旧类名 → 不破现有 20 个页面。
   ════════════════════════════════════════════════════════════════ */

/* ---------- v3-1. 字号工具（金额 / 标题） ---------- */
.v3-num {
  font-family: "DIN Alternate", "SF Pro Display", "Helvetica Neue", sans-serif;
  font-variant-numeric: tabular-nums;
  font-feature-settings: "tnum" 1;
  letter-spacing: -.02em;
}
.v3-num-xl { font-size: var(--fs-num-xl); font-weight: 700; line-height: 1.05; letter-spacing: -.03em; }
.v3-num-lg { font-size: var(--fs-num-lg); font-weight: 700; line-height: 1.1; letter-spacing: -.02em; }

/* ---------- v3-2. Hero 卡（顶部余额 / 报表主金额） ---------- */
.v3-hero {
  position: relative;
  overflow: hidden;
  background: var(--brand-aurora);
  border-radius: var(--r-lg);
  color: #FFFFFF;
  padding: 56rpx 40rpx 48rpx;
  box-shadow: var(--sh-lift);
}
/* Hero 内的暖橙光斑 —— 让 hero 看起来"在发光"，不要平铺色 */
.v3-hero::before {
  content: "";
  position: absolute;
  inset: -40rpx -40rpx auto auto;
  width: 320rpx;
  height: 320rpx;
  background: radial-gradient(closest-side, rgba(255, 176, 136, .55), transparent 70%);
  pointer-events: none;
}
.v3-hero::after {
  content: "";
  position: absolute;
  inset: auto auto -80rpx -60rpx;
  width: 260rpx;
  height: 260rpx;
  background: radial-gradient(closest-side, rgba(255, 217, 198, .40), transparent 70%);
  pointer-events: none;
}
.v3-hero-label {
  font-size: var(--fs-sm);
  letter-spacing: 2rpx;
  color: rgba(255, 255, 255, .78);
}
.v3-hero-bar {
  margin-top: 24rpx;
  height: 8rpx;
  border-radius: var(--r-full);
  background: rgba(255, 255, 255, .22);
  overflow: hidden;
}
.v3-hero-bar > view,
.v3-hero-bar-i {
  display: block;
  height: 100%;
  background: #FFFFFF;
  border-radius: var(--r-full);
}

/* ---------- v3-3. Glass 玻璃感（半年报 / 招商卡片 / 概览悬浮） ----------
   仅占位使用。玻璃效果需要 iOS/Android WebView 支持 backdrop-filter，
   不可用时退回浅橙底（双声明渐进增强）。 */
.v3-glass {
  background: var(--glass-bg);
  -webkit-backdrop-filter: saturate(180%) blur(20rpx);
  backdrop-filter: saturate(180%) blur(20rpx);
  border: 1rpx solid var(--glass-bd);
  border-radius: var(--r-lg);
  box-shadow: var(--sh-card);
}
.v3-glass-fallback {
  background: var(--brand-weak);
  border: 1rpx solid var(--brand-line);
  border-radius: var(--r-lg);
  box-shadow: var(--sh-card);
}

/* ---------- v3-4. 按钮升级（按钮配色） ---------- */
/* 主按钮 v3 版：暖橙微光 + 微微抬升 */
.v3-btn-primary {
  background: var(--brand-btn);
  color: #FFFFFF;
  border-radius: var(--r-full);
  font-size: var(--fs-h3);
  font-weight: 600;
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: var(--sh-glow);
  transition: transform .16s ease, background-color .16s ease, box-shadow .16s ease;
}
.v3-btn-primary:active {
  background: var(--brand-press);
  transform: scale(.98);
  box-shadow: 0 6rpx 16rpx -8rpx rgba(201, 69, 26, .25);
}
/* Ghost 浅描边按钮 v3 版：暖橙底 + 深橙文字 + 微光 */
.v3-btn-ghost {
  background: var(--brand-weak);
  color: var(--brand-ink);
  border: 1rpx solid var(--brand-line);
  border-radius: var(--r-full);
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--fs-h3);
  font-weight: 600;
  transition: transform .16s ease, background-color .16s ease;
}
.v3-btn-ghost:active {
  background: #FFE0CC;
  transform: scale(.98);
}

/* ---------- v3-5. 输入条升级（粘性输入 / 语音按钮） ---------- */
.v3-input {
  display: flex;
  align-items: center;
  height: 112rpx;
  padding: 0 28rpx;
  border-radius: var(--r-full);
  background: var(--brand-weak);
  border: 1rpx solid var(--brand-line);
  box-sizing: border-box;
  transition: background .12s ease, border-color .12s ease;
}
.v3-input.is-rec {
  background: var(--brand-btn);
  border-color: var(--brand-btn);
}
.v3-input-ico {
  width: 44rpx;
  height: 44rpx;
  flex: none;
  margin-right: 16rpx;
}
.v3-input-text {
  flex: 1;
  min-width: 0;
  font-size: var(--fs-h3);
  color: var(--t1);
}
.v3-input-text.is-placeholder {
  color: var(--t4);
}

/* ---------- v3-6. 流水卡（v3 row）---------- */
.v3-row {
  display: flex;
  align-items: center;
  min-height: 120rpx;
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--line);
}
.v3-row:last-child { border-bottom: none; }
.v3-row-tap:active { background: var(--fill); }
.v3-row-tag {
  width: 8rpx;
  height: 56rpx;
  border-radius: var(--r-full);
  margin-right: 24rpx;
  flex: none;
}
.v3-row-tag-income { background: var(--income); }
.v3-row-tag-expense { background: var(--expense); }
.v3-row-tag-warn { background: var(--warn); }
.v3-row-tag-info { background: var(--info); }

.v3-row-main { flex: 1; min-width: 0; }
.v3-row-title {
  font-size: var(--fs-h3);
  font-weight: 600;
  color: var(--t1);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.v3-row-sub {
  margin-top: 6rpx;
  font-size: var(--fs-sm);
  color: var(--t3);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.v3-row-val {
  margin-left: 24rpx;
  flex: none;
  text-align: right;
  font-family: "DIN Alternate", "SF Pro Display", sans-serif;
  font-variant-numeric: tabular-nums;
  font-size: 36rpx;
  font-weight: 700;
}
.v3-row-val-income { color: var(--income); }
.v3-row-val-expense { color: var(--expense); }

/* ---------- v3-7. AI 入口卡升级 ---------- */
.v3-ask {
  display: flex;
  align-items: center;
  min-height: 168rpx;
  padding: 36rpx 36rpx;
  background: var(--brand-mesh);
  border-radius: var(--r-lg);
  box-shadow: var(--sh-glow);
  color: #FFFFFF;
  position: relative;
  overflow: hidden;
}
.v3-ask::after {
  content: "";
  position: absolute;
  right: -60rpx;
  top: -60rpx;
  width: 240rpx;
  height: 240rpx;
  background: radial-gradient(closest-side, rgba(255, 255, 255, .25), transparent 70%);
  pointer-events: none;
}
.v3-ask-ico {
  width: 96rpx;
  height: 96rpx;
  flex: none;
  margin-right: 24rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, .20);
  display: flex;
  align-items: center;
  justify-content: center;
}
.v3-ask-main { flex: 1; min-width: 0; }
.v3-ask-t {
  font-size: 36rpx;
  font-weight: 700;
  letter-spacing: .5rpx;
}
.v3-ask-d {
  margin-top: 8rpx;
  font-size: var(--fs-sm);
  color: rgba(255, 255, 255, .82);
}
.v3-ask-go {
  width: 64rpx;
  height: 64rpx;
  flex: none;
  margin-left: 20rpx;
  border-radius: 50%;
  background: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 16rpx -8rpx rgba(0, 0, 0, .25);
}

/* ---------- v3-8. 段标 / 微章（Tab 选中 / 状态点） ---------- */
.v3-badge {
  display: inline-flex;
  align-items: center;
  height: 44rpx;
  padding: 0 16rpx;
  border-radius: var(--r-full);
  background: var(--brand-weak);
  color: var(--brand-ink);
  font-size: var(--fs-xs);
  font-weight: 600;
}
.v3-badge-income { background: var(--income-weak); color: var(--income); }
.v3-badge-expense { background: var(--expense-weak); color: var(--expense); }

/* ---------- v3-9. 报表区专用 ---------- */
.v3-stat-grid {
  display: flex;
  gap: 20rpx;
}
.v3-stat-card {
  flex: 1;
  min-width: 0;
  padding: 28rpx 24rpx;
  border-radius: var(--r-md);
  background: var(--card);
  border: 1rpx solid var(--line);
  box-shadow: var(--sh-card);
}
/* v3 改：浅绿/浅红底加深一档，跟主色视觉重量匹配 */
.v3-stat-card.is-income {
  background: var(--income-weak);
  border-color: transparent;
}
.v3-stat-card.is-income .v3-stat-v { color: var(--income); }
.v3-stat-card.is-expense {
  background: var(--expense-weak);
  border-color: transparent;
}
.v3-stat-card.is-expense .v3-stat-v { color: var(--expense); }
.v3-stat-k { font-size: var(--fs-sm); color: var(--t3); }
.v3-stat-v {
  margin-top: 10rpx;
  font-family: "DIN Alternate", sans-serif;
  font-variant-numeric: tabular-nums;
  font-size: 44rpx;
  font-weight: 700;
  color: var(--t1);
}

/* ---------- v3-10. 动效 ---------- */
@keyframes v3-pop {
  from { opacity: 0; transform: translateY(8rpx) scale(.98); }
  to   { opacity: 1; transform: translateY(0)    scale(1); }
}
.v3-pop { animation: v3-pop .28s cubic-bezier(.32, .72, 0, 1) both; }

/* ---------- v3-11. 暗色模式（占位接口，未来启用）----------
   项目现在不强制暗色模式，这里只占位：未来 rpx ≥ 20:00 / 系统暗色 时切换。
   现阶段仅以媒体查询做"系统暗色"探测，给后续留好接入点。 */
@media (prefers-color-scheme: dark) {
  /* 暂未启用，避免与现网主题打架；保留注释示意。 */
}
