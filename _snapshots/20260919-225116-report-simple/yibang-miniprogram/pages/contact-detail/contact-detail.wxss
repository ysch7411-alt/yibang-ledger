/* pages/contact-detail/contact-detail.wxss */

.ct-head {
  display: flex;
  align-items: center;
  padding: 28rpx 4rpx 24rpx;
}
.ct-avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: var(--brand-weak);
  color: var(--brand-ink);
  font-size: 38rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 22rpx;
  flex-shrink: 0;
}
.ct-info {
  flex: 1;
  min-width: 0;
}
.ct-name {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--t1);
}
.ct-phone {
  margin-top: 6rpx;
  font-size: 25rpx;
  color: var(--t3);
}

/* 余额是这张页面的主角，给足字号与留白 */
.ct-hero {
  text-align: center;
  padding: 40rpx 32rpx 36rpx;
}
.ct-hero-k {
  font-size: 26rpx;
  color: var(--t3);
}
.ct-hero-v {
  margin: 14rpx 0 10rpx;
  font-size: 76rpx;
  font-weight: 700;
  line-height: 1.1;
}
.ct-hero-d {
  font-size: 24rpx;
  color: var(--t4);
}

.ct-list-hd {
  padding: 32rpx 0 20rpx;
}
.ct-day {
  padding: 16rpx 0 8rpx;
}
.ct-day-t {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--t3);
}
.ct-line {
  display: flex;
  align-items: center;
}
.ct-content {
  margin-left: 12rpx;
  flex: 1;
  min-width: 0;
  font-size: 29rpx;
  color: var(--t1);
}
