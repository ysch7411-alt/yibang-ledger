<!--pages/contact-detail/contact-detail.wxml-->
<view class="container container-page container-cta">
  <!-- 原实现的页面内「返回」按钮与系统导航栏返回键重复，已移除；客户名交给导航栏标题承载 -->

  <view class="ct-head">
    <view class="ct-avatar">{{initial}}</view>
    <view class="ct-info">
      <view class="ct-name">{{contact.name || '往来对象'}}</view>
      <view class="ct-phone">{{contact.phone || '未填手机号'}}</view>
    </view>
    <view class="tag {{isReceivable ? 'tag-income' : 'tag-expense'}}">
      {{isReceivable ? '客户' : '供应商'}}
    </view>
  </view>

  <view class="card ct-hero">
    <view class="ct-hero-k">{{isReceivable ? '还欠我' : '我还欠'}}</view>
    <view class="ct-hero-v num {{isReceivable ? 'c-income' : 'c-expense'}}">¥{{balanceText}}</view>
    <view class="ct-hero-d">近 {{recordList.length}} 笔往来</view>
  </view>

  <view class="card card-flush">
    <view class="ct-list-hd">
      <text class="card-title">往来明细</text>
    </view>

    <view wx:if="{{loading}}">
      <view class="skeleton-line" style="width: 52%;"></view>
      <view class="skeleton-line mt-24" style="width: 74%;"></view>
    </view>

    <view wx:elif="{{recordList.length === 0}}" class="empty">
      <image class="empty-ico" src="/images/ic-empty.svg" mode="aspectFit" />
      <view class="empty-title">还没有往来记录</view>
      <view class="empty-desc">记一笔带对方名字的账，这里就会自动归集</view>
    </view>

    <block wx:else>
      <block wx:for="{{sections}}" wx:key="key">
        <view class="ct-day">
          <text class="ct-day-t">{{item.label}}</text>
        </view>
        <view wx:for="{{item.items}}" wx:for-item="r" wx:key="id" class="row">
          <view class="row-main">
            <view class="ct-line">
              <text class="tag {{r._tagCls}}">{{r._typeText}}</text>
              <text class="ct-content ellipsis">{{r.content || '未填写事由'}}</text>
            </view>
            <view class="row-sub">{{r._time}}</view>
          </view>
          <view class="row-val num {{r._cls}}">{{r._amount}}</view>
        </view>
      </block>
    </block>
  </view>
</view>

<view class="bottom-bar">
  <view class="btn btn-primary" bindtap="shareReconciliation">分享对账单</view>
</view>
