/* pages/report-view/report-view.wxss —— 别人分享给我的报表 */
/* 它是给人看的门面：收到的人可能从没听说过这个产品，
   所以这里比内页更克制 —— 层级浅、留白足、只有一个行动点。 */

/* 顶部抬头：谁家的账、什么报表、哪段时间 —— 对方第一眼要知道的三件事 */
.rv-head {
  padding: 28rpx 4rpx 24rpx;
}
.rv-shop {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--t1);
  line-height: 1.3;
}
.rv-label {
  display: inline-flex;
  align-items: center;
  height: 44rpx;
  padding: 0 18rpx;
  margin-top: 12rpx;
  border-radius: var(--r-full);
  background: var(--brand-weak);
  color: var(--brand-ink);
  font-size: 24rpx;
  font-weight: 600;
}
.rv-range {
  margin-top: 12rpx;
  font-size: 25rpx;
  color: var(--t3);
}

/* 汇总卡：结余是这一页的主角，字号拉开 */
.rv-sum {
  padding: 32rpx 32rpx 26rpx;
}
.rv-sum-k {
  font-size: 25rpx;
  color: var(--t3);
}
.rv-sum-v {
  margin-top: 4rpx;
  font-size: 62rpx;
  font-weight: 700;
  line-height: 1.12;
  letter-spacing: -.5rpx;
}
.rv-grid {
  margin-top: 22rpx;
  margin-bottom: 0;
}

/* 明细 */
.rv-hd {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding: 20rpx 4rpx 12rpx;
}
.rv-hd-t {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--t1);
}
.rv-hd-n {
  font-size: 25rpx;
  color: var(--t3);
}
.rv-row {
  display: flex;
  align-items: center;
  min-height: 108rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--line);
}
.rv-row:last-child {
  border-bottom: none;
}
.rv-row-main {
  flex: 1;
  min-width: 0;
}
.rv-row-t {
  font-size: 29rpx;
  font-weight: 600;
  color: var(--t1);
}
.rv-row-s {
  margin-top: 4rpx;
  font-size: 24rpx;
  color: var(--t3);
}
.rv-row-v {
  flex: none;
  margin-left: 20rpx;
  font-size: 30rpx;
  font-weight: 700;
  text-align: right;
}

/* 明细被截断时的说明：别让对方以为这就是全部 */
.rv-trunc {
  padding: 4rpx 8rpx 0;
  font-size: 23rpx;
  color: var(--t3);
  text-align: center;
}

/* 只读 + 有效期。这两件事必须写得直白 —— 对方最可能问的就是"我能改吗""什么时候过期" */
.rv-note {
  margin: 28rpx 4rpx 0;
  padding: 20rpx 24rpx;
  border-radius: var(--r-md);
  background: var(--fill);
  font-size: 24rpx;
  line-height: 1.7;
  color: var(--t2);
}
.rv-note text {
  display: block;
}

/* 唯一的行动点，克制一点 */
.rv-cta {
  margin-top: 24rpx;
  padding: 30rpx 32rpx;
  background: linear-gradient(160deg, #FFFFFF 0%, #FFF8F4 100%);
}
.rv-cta-t {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--t1);
}
.rv-cta-d {
  margin-top: 8rpx;
  font-size: 25rpx;
  line-height: 1.6;
  color: var(--t3);
}
.rv-cta-btn {
  display: inline-flex;
  align-items: center;
  height: 88rpx;
  padding: 0 44rpx;
  margin-top: 22rpx;
  border-radius: var(--r-full);
  background: var(--brand-btn);
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
}
.rv-cta-btn:active {
  background: var(--brand-btn-press);
}

.rv-by {
  margin-top: 24rpx;
  font-size: 22rpx;
  color: var(--t4);
  text-align: center;
}

/* 异常态一律复用全站的 .empty（图标 + 标题 + 说明 + 行动），
   不另造一套 —— 对方无论从哪个页面进来，看到的空状态都长一样。 */

.rv-tail {
  height: 24rpx;
}
