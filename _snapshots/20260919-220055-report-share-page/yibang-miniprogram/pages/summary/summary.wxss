/* pages/summary/summary.wxss */

.sum-tail {
  height: 40rpx;
}
.pad {
  padding: 24rpx 0;
}

/* ---------- 分段控件（今日 / 本月、客户 / 供应商 共用一套） ---------- */
.seg {
  display: flex;
  background: var(--fill);
  border-radius: var(--r-full);
  padding: 6rpx;
}
.seg-block {
  margin-bottom: 24rpx;
}
.seg-item {
  flex: 1;
  height: 68rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--r-full);
  font-size: 27rpx;
  color: var(--t3);
  transition: background-color .18s ease, color .18s ease;
}
.seg-item.on {
  background: #fff;
  color: var(--t1);
  font-weight: 600;
  box-shadow: 0 2rpx 8rpx rgba(16, 24, 40, .08);
}

/* ---------- 汇总卡 ---------- */
.sum-card {
  padding: 24rpx 32rpx 28rpx;
}
.sum-hero {
  text-align: center;
  padding: 32rpx 0 28rpx;
}
.sum-hero-k {
  display: block;
  font-size: 25rpx;
  color: var(--t3);
  margin-bottom: 10rpx;
}
.sum-hero-v {
  font-size: 72rpx;
  font-weight: 700;
}
.sum-ft {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 28rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid var(--line);
}
.sum-count {
  font-size: 25rpx;
  color: var(--t3);
}
.sum-share {
  /* 原来 64rpx（32px）——不到 44px 的触控下限。这个按钮正是老板要点的那个，
     顺手提到 88rpx。 */
  min-height: 88rpx;
  padding: 0 36rpx;
  border-radius: var(--r-full);
  background: var(--brand-weak);
  color: var(--brand-ink);
  font-size: 27rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
}
.sum-share:active {
  opacity: .75;
}

/* ---------- 往来总览 ---------- */
.debt-hd {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}
.debt-body {
  display: flex;
  align-items: stretch;
  padding-top: 16rpx;
}
.debt-col {
  flex: 1;
  min-width: 0;
  text-align: center;
}
.debt-k {
  font-size: 25rpx;
  color: var(--t3);
}
.debt-v {
  margin: 10rpx 0 6rpx;
  font-size: 48rpx;
  font-weight: 700;
}
.debt-s {
  font-size: 24rpx;
  color: var(--t4);
}
.debt-line {
  width: 2rpx;
  background: var(--line);
  margin: 8rpx 16rpx;
}

/* ---------- 往来行：圆形首字，替代纯文字列表（一眼区分对象） ---------- */
.ct-avatar {
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  background: var(--brand-weak);
  color: var(--brand-ink);
  font-size: 30rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 22rpx;
  flex-shrink: 0;
}

/* ---------- 报表图：离屏画布 ---------- */
/* 必须真实存在且可渲染：2d canvas 用 display:none 拿不到 node，画不出来。
   所以是挪到屏幕外，不是藏起来。 */
.rep-canvas {
  position: fixed;
  left: -9999px;
  top: 0;
  z-index: -1;
}

/* ---------- 分享报表弹层 ---------- */
.sh-note {
  padding: 2rpx 0 18rpx;
  font-size: 25rpx;
  color: var(--t3);
}
.sh-opt {
  display: flex;
  align-items: center;
  min-height: 108rpx;
  padding: 22rpx 0;
  border-bottom: 1rpx solid var(--line);
}
.sh-opt:last-child {
  border-bottom: none;
}
.sh-opt:active {
  opacity: .6;
}
.sh-opt.is-busy {
  opacity: .45;
}
/* 分享页面那一项是个原生 button（只有 open-type="share" 才能拉起微信转发面板），
   所以要把它复位成普通一行的样子。button 自带的白底/边框/居中都要清掉。 */
.sh-opt-btn {
  display: flex;
  align-items: center;
  width: 100%;
  background: transparent;
  border-radius: 0;
  font-size: inherit;
  font-weight: inherit;
  line-height: inherit;
  color: inherit;
  text-align: left;
}
.sh-opt-btn::after {
  border: none;
}
/* 主路径的图标底用实心橙：ic-brand.svg 本身是**纯白**图标（设计给深底用的），
   配下面那个浅底会白压浅、等于隐形。
   写成复合选择器而不是单独的类 —— 同权重下靠源码顺序决定胜负太脆
   （第一版就栽在这：.sh-ico-key 写在 .sh-ico 前面，橙底被浅底盖掉，图标直接看不见了）。
   把意图写进选择器，谁前谁后都不受影响。 */
.sh-ico.sh-ico-key {
  background: var(--brand-btn);
}
.sh-ico {
  width: 72rpx;
  height: 72rpx;
  flex: none;
  margin-right: 24rpx;
  border-radius: var(--r-md);
  background: var(--brand-weak);
  display: flex;
  align-items: center;
  justify-content: center;
}
.sh-ico-img {
  width: 40rpx;
  height: 40rpx;
}
.sh-main {
  flex: 1;
  min-width: 0;
}
.sh-t {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--t1);
}
.sh-d {
  margin-top: 4rpx;
  font-size: 24rpx;
  line-height: 1.5;
  color: var(--t3);
}
