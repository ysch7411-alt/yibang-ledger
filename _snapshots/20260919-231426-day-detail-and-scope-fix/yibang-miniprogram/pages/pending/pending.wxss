/* pages/pending/pending.wxss */

.pd-card {
  padding: 28rpx 32rpx 24rpx;
}
.pd-hd {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.pd-who {
  display: flex;
  align-items: center;
  min-width: 0;
}
.av {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: var(--brand-weak);
  color: var(--brand-ink);
  font-size: 30rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 18rpx;
  flex-shrink: 0;
}
.pd-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--t1);
}
.pd-time {
  margin-top: 4rpx;
  font-size: 24rpx;
  color: var(--t4);
}

/* 金额做成这块卡片的视觉焦点：审核时最需要确认的就是这个数 */
.pd-amount {
  display: flex;
  align-items: baseline;
  padding: 24rpx 0 20rpx;
}
.pd-amount-sym {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--t2);
  margin-right: 8rpx;
}
.pd-amount-v {
  font-size: 60rpx;
  font-weight: 700;
  color: var(--t1);
}

.pd-actions {
  display: flex;
  margin-top: 4rpx;
}
.pd-actions .btn {
  flex: 1;
}
.pd-actions .btn + .btn {
  margin-left: 20rpx;
}
