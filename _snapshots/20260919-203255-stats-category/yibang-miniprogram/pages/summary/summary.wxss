/* pages/summary/summary.wxss */

.sum-tail {
  height: 40rpx;
}
.pad {
  padding: 24rpx 0;
}

/* ---------- 分段控件（今日 / 本月、客户 / 供应商 共用一套） ---------- */
.seg {
  display: flex;
  background: var(--fill);
  border-radius: var(--r-full);
  padding: 6rpx;
}
.seg-block {
  margin-bottom: 24rpx;
}
.seg-item {
  flex: 1;
  height: 68rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--r-full);
  font-size: 27rpx;
  color: var(--t3);
  transition: background-color .18s ease, color .18s ease;
}
.seg-item.on {
  background: #fff;
  color: var(--t1);
  font-weight: 600;
  box-shadow: 0 2rpx 8rpx rgba(16, 24, 40, .08);
}

/* ---------- 汇总卡 ---------- */
.sum-card {
  padding: 24rpx 32rpx 28rpx;
}
.sum-hero {
  text-align: center;
  padding: 32rpx 0 28rpx;
}
.sum-hero-k {
  display: block;
  font-size: 25rpx;
  color: var(--t3);
  margin-bottom: 10rpx;
}
.sum-hero-v {
  font-size: 72rpx;
  font-weight: 700;
}
.sum-ft {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 28rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid var(--line);
}
.sum-count {
  font-size: 25rpx;
  color: var(--t3);
}
.sum-share {
  height: 64rpx;
  padding: 0 32rpx;
  border-radius: var(--r-full);
  background: var(--brand-weak);
  color: var(--brand-ink);
  font-size: 26rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
}
.sum-share:active {
  opacity: .75;
}

/* ---------- 往来总览 ---------- */
.debt-hd {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}
.debt-body {
  display: flex;
  align-items: stretch;
  padding-top: 16rpx;
}
.debt-col {
  flex: 1;
  min-width: 0;
  text-align: center;
}
.debt-k {
  font-size: 25rpx;
  color: var(--t3);
}
.debt-v {
  margin: 10rpx 0 6rpx;
  font-size: 48rpx;
  font-weight: 700;
}
.debt-s {
  font-size: 24rpx;
  color: var(--t4);
}
.debt-line {
  width: 2rpx;
  background: var(--line);
  margin: 8rpx 16rpx;
}

/* ---------- 往来行：圆形首字，替代纯文字列表（一眼区分对象） ---------- */
.ct-avatar {
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  background: var(--brand-weak);
  color: var(--brand-ink);
  font-size: 30rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 22rpx;
  flex-shrink: 0;
}
