<!--pages/bind-phone/bind-phone.wxml-->
<!-- 绑定手机号：**不是注册门槛**，用户可以随时「先不绑，直接用」。
     这是微信合规要求 —— 不能在用户还没用上功能时强制授权手机号。 -->
<view class="reg">

  <view class="brand">
    <view class="brand-mark">
      <image class="brand-mark-ico" src="/images/ic-brand.svg" mode="aspectFit" />
    </view>
    <view class="brand-name">绑定手机号</view>
    <view class="brand-slogan">{{bound ? '已绑定，换手机也能找回' : '换手机也能把账本找回来'}}</view>
    <view class="brand-sub">{{bound ? bound : '不绑也能用，这一步只是为了以后更方便'}}</view>
  </view>

  <!-- 已绑定：只显示状态，不再要求操作 -->
  <view wx:if="{{bound}}" class="card bp-done">
    <view class="bp-done-tick"></view>
    <view class="bp-done-main">
      <view class="bp-done-t">这个微信号已经绑定手机号</view>
      <view class="bp-done-d">换手机时用微信登录，账本会自动找回来</view>
    </view>
  </view>

  <block wx:else>
    <view class="card pain-card">
      <view class="card-hd">
        <text class="card-title">为什么值得绑一下</text>
      </view>
      <block wx:for="{{values}}" wx:key="text" wx:for-item="p">
        <view class="pain">
          <view class="pain-ico">
            <image class="pain-ico-img" src="{{p.icon}}" mode="aspectFit" />
          </view>
          <view class="pain-line">
            <view class="mk"></view>
            <text class="pain-t">{{p.text}}</text>
          </view>
        </view>
      </block>
    </view>

    <view class="reg-block">
      <view class="err" wx:if="{{errorTip}}">{{errorTip}}</view>

      <!-- 协议放在按钮之前：先勾选 → 按钮亮起 → 顺手点 -->
      <view class="agree" bindtap="toggleAgree">
        <view class="agree-box {{agreed ? 'on' : ''}}"></view>
        <view class="agree-txt">
          我已阅读并同意
          <text class="agree-link" catchtap="openTerms">《服务说明与隐私告知》</text>
        </view>
      </view>

      <button
        wx:if="{{agreed}}"
        class="btn btn-primary reg-btn"
        open-type="getPhoneNumber"
        disabled="{{busy}}"
        bindgetphonenumber="onGetPhone"
      >{{busy ? '正在绑定…' : '一键绑定手机号'}}</button>
      <view wx:else class="btn reg-btn reg-btn-off" bindtap="needAgree">一键绑定手机号</view>
    </view>
  </block>

  <!-- 合规要求：必须留一条「不绑定也能用」的退路 -->
  <view class="bp-skip" bindtap="skip">先不绑，直接用</view>

  <view class="foot">
    <view>不读取通讯录，不读取相册，不发送营销短信</view>
    <view>照片与录音只在你主动使用时上传，用于当次识别</view>
  </view>
</view>

<view class="sheet-mask" wx:if="{{showTerms}}" bindtap="closeTerms"></view>
<view class="sheet reg-sheet" wx:if="{{showTerms}}">
  <view class="sheet-handle"></view>
  <view class="sheet-hd">
    <text class="sheet-title">服务说明与隐私告知</text>
    <view class="sheet-close" bindtap="closeTerms"></view>
  </view>
  <scroll-view class="sheet-bd" scroll-y>
    <block wx:for="{{terms}}" wx:key="t" wx:for-item="it">
      <view class="term">
        <view class="term-t">{{it.t}}</view>
        <view class="term-d">{{it.d}}</view>
      </view>
    </block>
    <view class="term-note">完整条款以小程序的《用户隐私保护指引》为准，可在微信「小程序详情页 → 更多资料」查看。首次授权时微信也会弹出官方隐私授权窗口。</view>
    <view class="sheet-gap"></view>
  </scroll-view>
  <view class="sheet-ft">
    <view class="btn btn-primary" catchtap="agreeAndClose">同意并继续</view>
  </view>
</view>
