/* pages/search/search.wxss */

.search-tail {
  height: 40rpx;
}

/* ---------- 搜索框 ---------- */
.search-bar {
  display: flex;
  align-items: center;
  height: 96rpx;
  padding: 0 28rpx;
  margin-bottom: 20rpx;
  background: #fff;
  border-radius: var(--r-full);
  box-shadow: var(--sh-card);
}
.search-ico {
  width: 36rpx;
  height: 36rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}
.search-input {
  flex: 1;
  min-width: 0;
  font-size: 29rpx;
  color: var(--t1);
}
/* 用两条旋转线绘制「✕」，不依赖字体字形 */
.search-clear {
  position: relative;
  width: 56rpx;
  height: 56rpx;
  margin-right: -12rpx;
  flex-shrink: 0;
  border-radius: 50%;
}
.search-clear:active {
  background: var(--fill);
}
.search-clear::before,
.search-clear::after {
  content: "";
  position: absolute;
  left: 50%;
  top: 50%;
  width: 26rpx;
  height: 3rpx;
  border-radius: 2rpx;
  background: var(--t4);
  transform: translate(-50%, -50%) rotate(45deg);
}
.search-clear::after {
  transform: translate(-50%, -50%) rotate(-45deg);
}

/* 分段控件统一用 app.wxss 的 .seg / .seg-i / .is-on（这里原来还有第 5 份旧版副本） */

/* ---------- AI 入口 ---------- */
.ai-entry {
  display: flex;
  align-items: center;
  padding: 24rpx 28rpx;
  background: linear-gradient(120deg, #FFF7F2 0%, #FFFDFC 100%);
  border: 1rpx solid var(--brand-line);
  border-radius: var(--r-lg);
  margin-bottom: 24rpx;
}
.ai-entry:active {
  opacity: .8;
}
.ai-entry-ico {
  width: 44rpx;
  height: 44rpx;
  margin-right: 20rpx;
}
.ai-entry-txt {
  flex: 1;
  min-width: 0;
}
.ai-entry-title {
  font-size: 29rpx;
  font-weight: 600;
  color: var(--brand-ink);
}
.ai-entry-desc {
  margin-top: 4rpx;
  font-size: 24rpx;
  color: var(--t3);
}

/* ---------- 结果头 ---------- */
/* .list-hd / .list-hd-t / .list-hd-reset 已提到 app.wxss（这里是第 4 份副本，删掉） */

/* ---------- 日期分组 ---------- */
.day-hd {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding: 4rpx 4rpx 14rpx;
}
.day-label {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--t2);
}
.day-sum {
  font-size: 24rpx;
  color: var(--t3);
}
.rec-line {
  display: flex;
  align-items: center;
}
.rec-name {
  margin-left: 12rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--t1);
  flex: 1;
  min-width: 0;
}

/* 关键字高亮：底色 + 加深文字，扫结果时能立刻定位命中位置 */
.hl {
  background: #FFE9DC;
  color: var(--brand-ink);
  border-radius: 4rpx;
  padding: 0 2rpx;
}

/* ---------- AI 对话 ---------- */
.chat-sheet {
  height: 80vh;
}
.chat-body {
  flex: 1;
  min-height: 0;
  padding: 8rpx 32rpx;
}
.chat-hello {
  padding: 40rpx 0 20rpx;
  text-align: center;
}
.chat-asks {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 24rpx;
}
.chat-ask {
  width: 100%;
  padding: 24rpx 28rpx;
  margin-bottom: 16rpx;
  border-radius: var(--r-md);
  background: var(--fill);
  font-size: 27rpx;
  color: var(--t2);
  text-align: left;
}
.chat-ask:active {
  background: #E7EBF0;
}
.chat-item {
  margin-bottom: 24rpx;
  display: flex;
}
.chat-item.user {
  justify-content: flex-end;
}
/* AI 气泡沿用基础样式，这里显式声明左对齐，避免依赖默认值 */
.chat-item.ai {
  justify-content: flex-start;
}
.chat-bubble {
  max-width: 78%;
  padding: 22rpx 28rpx;
  border-radius: 22rpx;
  font-size: 28rpx;
  line-height: 1.6;
  background: var(--fill);
  color: var(--t1);
  border-bottom-left-radius: 6rpx;
  word-break: break-all;
}
.chat-item.user .chat-bubble {
  background: var(--brand-btn);
  color: #fff;
  border-bottom-left-radius: 22rpx;
  border-bottom-right-radius: 6rpx;
}
.chat-bubble-thinking {
  color: var(--t3);
}
.chat-pad {
  height: 20rpx;
}
.chat-input-bar {
  display: flex;
  align-items: center;
  padding: 20rpx 32rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom, 0px));
  border-top: 1rpx solid var(--line);
  flex-shrink: 0;
}
.chat-input {
  flex: 1;
  min-width: 0;
  height: 84rpx;
  padding: 0 28rpx;
  border-radius: var(--r-full);
  background: var(--fill);
  font-size: 28rpx;
  color: var(--t1);
}
.chat-send {
  height: 84rpx;
  padding: 0 36rpx;
  margin-left: 16rpx;
  border-radius: var(--r-full);
  background: var(--brand-btn);
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  flex-shrink: 0;
}
.chat-send:active {
  background: var(--brand-btn-press);
}
.chat-send.is-disabled {
  opacity: .4;
}

/* 采购单入口：一行，不抢搜索框的视觉重心 */
.po-entry {
  display: flex;
  align-items: center;
  min-height: 108rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 24rpx;
  background: var(--card);
  border-radius: var(--r-lg);
  box-shadow: var(--sh-card);
}
.po-entry-ico {
  width: 72rpx;
  height: 72rpx;
  flex: none;
  margin-right: 22rpx;
  border-radius: var(--r-md);
  background: var(--brand-weak);
  display: flex;
  align-items: center;
  justify-content: center;
}
.po-entry-ico-img {
  width: 42rpx;
  height: 42rpx;
}
.po-entry-main {
  flex: 1;
  min-width: 0;
}
.po-entry-t {
  font-size: 31rpx;
  font-weight: 600;
  color: var(--t1);
}
.po-entry-d {
  margin-top: 6rpx;
  font-size: 25rpx;
  color: var(--t3);
}

/* ---------- 列表底部的"还有没有更多" ---------- */
/* 不能让用户以为"就这么多"，也不能让他一直往下拽却没有新内容 */
.sm-more {
  padding: 32rpx 0 8rpx;
  text-align: center;
  font-size: 24rpx;
  color: var(--t3);
}
