<!--custom-tab-bar/index.wxml-->
<view class="tabbar">
  <view class="tabbar-inner">
    <view
      wx:for="{{list}}"
      wx:key="pagePath"
      class="tab {{selected === index ? 'on' : ''}}"
      data-path="{{item.pagePath}}"
      data-index="{{index}}"
      bindtap="onTap"
      hover-class="tab-hover"
      hover-stay-time="80"
    >
      <image class="tab-ico" src="{{selected === index ? item.iconOn : item.icon}}" mode="aspectFit" />
      <view class="tab-txt">{{item.text}}</view>
    </view>
  </view>
</view>
