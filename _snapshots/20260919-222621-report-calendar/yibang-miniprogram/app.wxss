/* ============================================================
   app.wxss —— 易帮账本 设计系统 v2
   目标用户：中小门店老板（40-60 岁、非财务专业、店内光线复杂）
   设计原则：字大、点大、对比足、层级浅、语音优先
   ============================================================ */

/* ---------- 1. 设计令牌（Design Tokens） ---------- */
page {
  /* 品牌 —— 亮橙仅用于图形/填充/图标；文字与按钮使用可读性达标的深橙 */
  --brand: #FF6B35;
  --brand-btn: #C9451A;      /* 白字对比度 4.75:1 ✓ WCAG AA */
  --brand-btn-press: #B03C10;
  --brand-ink: #B93F14;      /* 橙字白底 5.4:1 ✓ */
  --brand-weak: #FFF4EE;
  --brand-line: #FFD9C6;

  /* 账目语义色（全部 ≥4.4:1，深色底也能看清） */
  --income: #0B7A43;         /* 收入 / 回款 */
  --income-weak: #E8F5EC;
  --expense: #D92D20;        /* 支出 / 付款 */
  --expense-weak: #FDECEA;
  --warn: #B54708;           /* 应收 / 待办 */
  --warn-weak: #FFF6E5;
  --info: #175CD3;           /* 应付 / 中性提示 */
  --info-weak: #EDF3FF;

  /* 中性色阶（统一一套灰，替换原先散落的 #999/#bbb/#ccc/#666） */
  --t1: #101828;             /* 主文字 15.9:1 */
  --t2: #344054;             /* 次文字 10.4:1 */
  --t3: #667085;             /* 辅助文字 5.0:1（正文灰的下限） */
  --t4: #98A2B3;             /* 仅占位符/装饰，不承载信息 */
  --line: #EDF0F3;
  --fill: #F2F4F7;
  --bg: #F6F7F9;
  --card: #FFFFFF;

  /* 圆角 / 阴影 / 尺寸 */
  --r-sm: 10rpx;
  --r-md: 18rpx;
  --r-lg: 28rpx;
  --r-full: 999rpx;
  --sh-card: 0 2rpx 6rpx rgba(16, 24, 40, .03), 0 12rpx 32rpx -14rpx rgba(16, 24, 40, .12);
  --sh-float: 0 10rpx 30rpx -8rpx rgba(16, 24, 40, .22);
  --tabbar-h: 108rpx;

  background: var(--bg);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
  line-height: 1.55;
  color: var(--t1);
  -webkit-font-smoothing: antialiased;
}

/* ---------- 2. 布局骨架 ---------- */
.container {
  padding: 0 28rpx;
  /* 双声明做渐进增强：不支持 env() 的旧 WebView 用上一行，支持的用下一行 */
  padding-bottom: calc(var(--tabbar-h) + 60rpx);
  padding-bottom: calc(var(--tabbar-h) + 60rpx + env(safe-area-inset-bottom, 0px));
}
/* 二级页（navigateTo 打开的页面）没有 TabBar，不需要预留它的高度 */
.container-page {
  padding-bottom: 72rpx;
  padding-bottom: calc(72rpx + env(safe-area-inset-bottom, 0px));
}
/* 底部有固定操作条时再额外留出空间 */
.container-cta {
  padding-bottom: 190rpx;
  padding-bottom: calc(190rpx + env(safe-area-inset-bottom, 0px));
}
/* 固定在底部的操作条 */
.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 900;
  display: flex;
  align-items: center;
  padding: 20rpx 28rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom, 0px));
  background: rgba(255, 255, 255, .97);
  border-top: 1rpx solid var(--line);
  box-shadow: 0 -8rpx 24rpx -18rpx rgba(16, 24, 40, .35);
}
.bottom-bar .btn {
  flex: 1;
}

/* 页面头：左对齐，替代原先“居中大标题”（居中标题 + 原生导航栏 = 信息重复 + 弱层次） */
.page-head {
  padding: 32rpx 4rpx 24rpx;
}
.page-title {
  font-size: 44rpx;
  font-weight: 700;
  color: var(--t1);
  line-height: 1.3;
}
.page-sub {
  margin-top: 8rpx;
  font-size: 26rpx;
  color: var(--t3);
}

/* ---------- 3. 卡片 ---------- */
.card {
  background: var(--card);
  border-radius: var(--r-lg);
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--sh-card);
}
.card-flush {
  padding: 8rpx 32rpx;
}
.card-hd {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}
.card-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--t1);
}
.card-more {
  font-size: 26rpx;
  color: var(--t3);
}

/* ---------- 4. 按钮 ---------- */
.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 96rpx;
  border-radius: var(--r-full);
  font-size: 32rpx;
  font-weight: 600;
  transition: transform .16s ease, background-color .16s ease, opacity .16s ease;
}
.btn-primary {
  background: var(--brand-btn);
  color: #fff;
  box-shadow: 0 8rpx 20rpx -8rpx rgba(201, 69, 26, .6);
}
.btn-primary:active {
  background: var(--brand-btn-press);
  transform: scale(.97);
}
.btn-ghost {
  background: var(--fill);
  color: var(--t2);
}
.btn-ghost:active {
  background: #E7EBF0;
  transform: scale(.97);
}
.btn-outline {
  background: transparent;
  color: var(--brand-ink);
  border: 2rpx solid var(--brand-line);
}
/* 危险操作（删除、注销）。用语义红：跟「支出」是同一套颜色语言，
   老板看到红就知道这一步不可逆。白字对比度 4.83:1 ✓ */
.btn-danger {
  background: var(--expense);
  color: #fff;
  box-shadow: 0 8rpx 20rpx -8rpx rgba(217, 45, 32, .55);
}
.btn-danger:active {
  background: #B42318;
  transform: scale(.97);
}
.btn-sm {
  height: 76rpx;
  font-size: 28rpx;
}
.btn-block {
  width: 100%;
}
.btn[disabled],
.btn.is-disabled {
  opacity: .45;
}

/* 原生 button 复位（pending 等页仍在用 button） */
button::after {
  border: none;
}
.btn-reset {
  padding: 0;
  margin: 0;
  line-height: inherit;
  background: transparent;
  border-radius: 0;
  font-size: inherit;
  color: inherit;
}
.btn-reset::after {
  border: none;
}

/* ---------- 5. 数字与金额 ---------- */
/* tabular-nums：等宽数字，让一列金额的小数点在竖直方向对齐，扫读效率显著提升 */
.num {
  font-family: "DIN Alternate", "SF Pro Display", "Helvetica Neue", sans-serif;
  font-variant-numeric: tabular-nums;
  font-feature-settings: "tnum" 1;
  letter-spacing: -.02em;
}
.money-lg {
  font-size: 64rpx;
  font-weight: 700;
  line-height: 1.15;
}
.money-md {
  font-size: 44rpx;
  font-weight: 700;
  line-height: 1.2;
}
.money-sm {
  font-size: 32rpx;
  font-weight: 600;
}
.c-income {
  color: var(--income);
}
.c-expense {
  color: var(--expense);
}
.c-warn {
  color: var(--warn);
}
.c-info {
  color: var(--info);
}
.c-brand {
  color: var(--brand-ink);
}
.c-t1 { color: var(--t1); }
.c-t2 { color: var(--t2); }
.c-t3 { color: var(--t3); }

/* ---------- 6. 通用列表行 ---------- */
.list {
  padding: 4rpx 32rpx;
}
.row {
  display: flex;
  align-items: center;
  min-height: 108rpx;
  padding: 22rpx 0;
  border-bottom: 1rpx solid var(--line);
}
.row:last-child {
  border-bottom: none;
}
.row-tap:active {
  background: var(--fill);
}
.row-main {
  flex: 1;
  min-width: 0;
}
.row-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--t1);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.row-sub {
  margin-top: 6rpx;
  font-size: 25rpx;
  color: var(--t3);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.row-val {
  margin-left: 24rpx;
  flex-shrink: 0;
  text-align: right;
}
.row-arrow {
  margin-left: 16rpx;
  width: 16rpx;
  height: 16rpx;
  border-right: 3rpx solid var(--t4);
  border-top: 3rpx solid var(--t4);
  transform: rotate(45deg);
  flex-shrink: 0;
}
.row-ico {
  width: 72rpx;
  height: 72rpx;
  border-radius: var(--r-md);
  background: var(--fill);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
  margin-right: 24rpx;
  flex-shrink: 0;
}
.row-ico-img {
  width: 40rpx;
  height: 40rpx;
}

/* ---------- 7. 标签 ---------- */
.tag {
  display: inline-flex;
  align-items: center;
  height: 40rpx;
  padding: 0 14rpx;
  border-radius: 8rpx;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 1;
}
.tag-income { background: var(--income-weak); color: var(--income); }
.tag-expense { background: var(--expense-weak); color: var(--expense); }
.tag-warn { background: var(--warn-weak); color: var(--warn); }
.tag-info { background: var(--info-weak); color: var(--info); }
.tag-brand { background: var(--brand-weak); color: var(--brand-ink); }
.tag-gray { background: var(--fill); color: var(--t3); }

/* ---------- 8. 空状态（图标 + 说明 + 行动，替代纯文字） ---------- */
.empty {
  padding: 88rpx 32rpx;
  text-align: center;
}
.empty-ico {
  width: 88rpx;
  height: 88rpx;
  display: block;
  margin: 0 auto 24rpx;
  opacity: .45;
}
.empty-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--t2);
}
.empty-desc {
  margin-top: 10rpx;
  font-size: 26rpx;
  color: var(--t3);
  line-height: 1.6;
}
.empty-action {
  display: inline-flex;
  align-items: center;
  /* 原来 76rpx（38px），不到 44px 的触控下限。空状态里那个按钮往往正是唯一的出路，
     点不中等于把人堵在这儿 —— 按全站规则提到 88rpx。 */
  height: 88rpx;
  padding: 0 44rpx;
  margin-top: 28rpx;
  border-radius: var(--r-full);
  background: var(--brand-btn);
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
}

/* ---------- 9. 筛选 chip ---------- */
.chip-bar {
  display: flex;
  flex-wrap: wrap;
  margin: 0 -8rpx 24rpx;
}
.chip {
  height: 68rpx;
  padding: 0 28rpx;
  margin: 0 8rpx 16rpx;
  border-radius: var(--r-full);
  background: var(--card);
  color: var(--t2);
  font-size: 27rpx;
  display: flex;
  align-items: center;
  box-shadow: var(--sh-card);
}
.chip.is-on {
  background: var(--brand-btn);
  color: #fff;
  font-weight: 600;
}

/* ---------- 9b. 分段控件（同一份数据的几种看法，平级切换） ---------- */
/* 与 chip 的分工：chip 是「筛掉一部分」，seg 是「换个角度看同一批数据」——
   所以 seg 的选中态用浅底 + 深字，不用实心橙：它不改变数据范围，不该抢主按钮的位置。 */
.seg {
  display: flex;
  padding: 6rpx;
  margin-bottom: 24rpx;
  border-radius: var(--r-full);
  background: var(--fill);
}
.seg-i {
  flex: 1;
  min-width: 0;
  /* 原来 72rpx（36px），不到 44px 的触控下限。分段控件是整页最高频的开关，
     按全站规则提到 88rpx。 */
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--r-full);
  font-size: 28rpx;
  color: var(--t2);
  transition: background .16s ease, color .16s ease;
}
.seg-i.is-on {
  background: var(--card);
  color: var(--brand-ink);
  font-weight: 600;
  box-shadow: 0 2rpx 8rpx -2rpx rgba(16, 24, 40, .14);
}

/* ---------- 10. 底部弹层（统一替代居中弹窗，拇指可达） ---------- */
.sheet-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(16, 24, 40, .45);
  z-index: 1000;
  animation: yb-fade .2s ease;
}
.sheet {
  position: fixed;
  left: 0;
  right: 0;
  /* 自定义 tabBar 由框架渲染在页面内容之上，弹层写 bottom:0 会被它压住底部一截。
     当前所有用到 .sheet 的页面都是 TabBar 页，所以统一停在 tabBar 之上；
     tabBar 自身已含安全区内边距，这里不再重复加 padding-bottom。
     非 TabBar 页若要用，覆盖成 bottom: 0 即可。 */
  bottom: var(--tabbar-h);
  bottom: calc(var(--tabbar-h) + env(safe-area-inset-bottom, 0px));
  z-index: 1001;
  background: var(--card);
  border-radius: 32rpx 32rpx 0 0;
  padding-bottom: 0;
  animation: yb-up .26s cubic-bezier(.32, .72, 0, 1);
  max-height: 88vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}
.sheet-handle {
  width: 72rpx;
  height: 8rpx;
  border-radius: 4rpx;
  background: var(--line);
  margin: 16rpx auto 0;
  flex-shrink: 0;
}
.sheet-hd {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 32rpx 20rpx;
  flex-shrink: 0;
}
.sheet-title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--t1);
}
.sheet-close {
  width: 64rpx;
  height: 64rpx;
  margin-right: -12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}
.sheet-close::before,
.sheet-close::after {
  content: "";
  position: absolute;
  width: 30rpx;
  height: 3rpx;
  border-radius: 2rpx;
  background: var(--t4);
}
.sheet-close::before { transform: rotate(45deg); }
.sheet-close::after { transform: rotate(-45deg); }
.sheet-bd {
  padding: 0 32rpx;
  flex: 1;
  min-height: 0;
}
.sheet-ft {
  display: flex;
  padding: 20rpx 32rpx 28rpx;
  flex-shrink: 0;
}
.sheet-ft .btn {
  flex: 1;
}
.sheet-ft .btn + .btn {
  margin-left: 20rpx;
}

/* ---------- 11. 键值信息块 ---------- */
.kv {
  background: var(--fill);
  border-radius: var(--r-md);
  padding: 8rpx 24rpx;
  margin-bottom: 24rpx;
}
.kv-row {
  display: flex;
  align-items: flex-start;
  padding: 18rpx 0;
  border-bottom: 1rpx solid rgba(16, 24, 40, .05);
}
.kv-row:last-child {
  border-bottom: none;
}
.kv-k {
  width: 130rpx;
  flex-shrink: 0;
  font-size: 26rpx;
  color: var(--t3);
}
.kv-v {
  flex: 1;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--t1);
  word-break: break-all;
}

/* ---------- 12. 统计分栏 ---------- */
.stat-grid {
  display: flex;
}
.stat-col {
  flex: 1;
  min-width: 0;
}
.stat-col + .stat-col {
  margin-left: 20rpx;
}
.stat-k {
  font-size: 25rpx;
  color: var(--t3);
  margin-bottom: 10rpx;
}
.stat-v {
  font-size: 42rpx;
  font-weight: 700;
}
.stat-line {
  width: 2rpx;
  background: var(--line);
  margin: 8rpx 36rpx;
}

/* ---------- 13. 骨架屏（替代整页白屏） ---------- */
@keyframes yb-skeleton {
  0% { opacity: 1; }
  50% { opacity: .45; }
  100% { opacity: 1; }
}
.skeleton-line {
  height: 28rpx;
  border-radius: 6rpx;
  background: var(--fill);
  animation: yb-skeleton 1.2s ease-in-out infinite;
}

/* ---------- 14. 动效 ---------- */
@keyframes yb-fade {
  from { opacity: 0; }
  to { opacity: 1; }
}
@keyframes yb-up {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}
@keyframes yb-pop {
  from { opacity: 0; transform: scale(.94); }
  to { opacity: 1; transform: scale(1); }
}

/* ---------- 15. 响应式：大屏（平板 / 折叠屏展开）限制内容宽度 ---------- */
/* rpx 按屏宽等比放大，不做限制会导致 iPad 上字号巨大、行宽过长难以扫读 */
@media (min-width: 520px) {
  .container {
    max-width: 760px;
    margin-left: auto;
    margin-right: auto;
  }
  .sheet {
    max-width: 760px;
    margin-left: auto;
    margin-right: auto;
    left: 0;
    right: 0;
  }
}

/* ---------- 16. 工具类 ---------- */
.flex { display: flex; }
.flex-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.flex-center {
  display: flex;
  align-items: center;
  justify-content: center;
}
.items-center { align-items: center; }
.flex-1 { flex: 1; min-width: 0; }
.mt-8 { margin-top: 8rpx; }
.mt-16 { margin-top: 16rpx; }
.mt-24 { margin-top: 24rpx; }
.mb-16 { margin-bottom: 16rpx; }
.mb-24 { margin-bottom: 24rpx; }
.t-sm { font-size: 26rpx; }
.t-xs { font-size: 24rpx; }
.t-bold { font-weight: 600; }
.divider {
  height: 1rpx;
  background: var(--line);
  margin: 24rpx 0;
}
.ellipsis {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.tap-dim:active {
  opacity: .7;
}
