/* pages/summary/summary.wxss */

.sum-tail {
  height: 40rpx;
}
.pad {
  padding: 24rpx 0;
}

/* 分段控件统一用 app.wxss 的 .seg / .seg-i / .is-on。
   这里原来还有一份 68rpx 的旧版本，同一个页面两套类名迟早长得不一样，已删除。 */

/* ---------- 汇总卡 ---------- */
.sum-card {
  padding: 24rpx 32rpx 28rpx;
}
.sum-hero {
  text-align: center;
  padding: 32rpx 0 28rpx;
}
.sum-hero-k {
  display: block;
  font-size: 25rpx;
  color: var(--t3);
  margin-bottom: 10rpx;
}
.sum-hero-v {
  font-size: 72rpx;
  font-weight: 700;
}
.sum-ft {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 28rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid var(--line);
}
.sum-count {
  font-size: 25rpx;
  color: var(--t3);
}
.sum-share {
  /* 原来 64rpx（32px）——不到 44px 的触控下限。这个按钮正是老板要点的那个，
     顺手提到 88rpx。 */
  min-height: 88rpx;
  padding: 0 36rpx;
  border-radius: var(--r-full);
  background: var(--brand-weak);
  color: var(--brand-ink);
  font-size: 27rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
}
.sum-share:active {
  opacity: .75;
}

/* ---------- 往来总览 ---------- */
.debt-hd {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}
.debt-body {
  display: flex;
  align-items: stretch;
  padding-top: 16rpx;
}
.debt-col {
  flex: 1;
  min-width: 0;
  text-align: center;
}
.debt-k {
  font-size: 25rpx;
  color: var(--t3);
}
.debt-v {
  margin: 10rpx 0 6rpx;
  font-size: 48rpx;
  font-weight: 700;
}
.debt-s {
  font-size: 24rpx;
  color: var(--t4);
}
.debt-line {
  width: 2rpx;
  background: var(--line);
  margin: 8rpx 16rpx;
}

/* ---------- 往来行：圆形首字，替代纯文字列表（一眼区分对象） ---------- */
.ct-avatar {
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  background: var(--brand-weak);
  color: var(--brand-ink);
  font-size: 30rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 22rpx;
  flex-shrink: 0;
}

/* ---------- 报表图：离屏画布 ---------- */
/* 必须真实存在且可渲染：2d canvas 用 display:none 拿不到 node，画不出来。
   所以是挪到屏幕外，不是藏起来。 */
.rep-canvas {
  position: fixed;
  left: -9999px;
  top: 0;
  z-index: -1;
}

/* ---------- 分享报表弹层 ---------- */
.sh-note {
  padding: 2rpx 0 18rpx;
  font-size: 25rpx;
  color: var(--t3);
}
.sh-opt {
  display: flex;
  align-items: center;
  min-height: 108rpx;
  padding: 22rpx 0;
  border-bottom: 1rpx solid var(--line);
}
.sh-opt:last-child {
  border-bottom: none;
}
.sh-opt:active {
  opacity: .6;
}
.sh-opt.is-busy {
  opacity: .45;
}
/* 分享页面那一项是个原生 button（只有 open-type="share" 才能拉起微信转发面板），
   所以要把它复位成普通一行的样子。button 自带的白底/边框/居中都要清掉。 */
.sh-opt-btn {
  display: flex;
  align-items: center;
  width: 100%;
  background: transparent;
  border-radius: 0;
  font-size: inherit;
  font-weight: inherit;
  line-height: inherit;
  color: inherit;
  text-align: left;
}
.sh-opt-btn::after {
  border: none;
}
/* 主路径的图标底用实心橙：ic-brand.svg 本身是**纯白**图标（设计给深底用的），
   配下面那个浅底会白压浅、等于隐形。
   写成复合选择器而不是单独的类 —— 同权重下靠源码顺序决定胜负太脆
   （第一版就栽在这：.sh-ico-key 写在 .sh-ico 前面，橙底被浅底盖掉，图标直接看不见了）。
   把意图写进选择器，谁前谁后都不受影响。 */
.sh-ico.sh-ico-key {
  background: var(--brand-btn);
}
.sh-ico {
  width: 72rpx;
  height: 72rpx;
  flex: none;
  margin-right: 24rpx;
  border-radius: var(--r-md);
  background: var(--brand-weak);
  display: flex;
  align-items: center;
  justify-content: center;
}
.sh-ico-img {
  width: 40rpx;
  height: 40rpx;
}
.sh-main {
  flex: 1;
  min-width: 0;
}
.sh-t {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--t1);
}
.sh-d {
  margin-top: 4rpx;
  font-size: 24rpx;
  line-height: 1.5;
  color: var(--t3);
}

/* ---------- 报表日历 ---------- */
.cal-card {
  padding: 24rpx 20rpx 18rpx;
}
.cal-hd {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 2rpx 0 14rpx;
}
.cal-nav {
  width: 88rpx;
  height: 88rpx;
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  font-size: 46rpx;
  line-height: 1;
  color: var(--t2);
}
.cal-nav:active {
  background: var(--fill);
}
/* 已经是当前月时，下一月不能点：让它看起来就是关掉的，而不是点了没反应 */
.cal-nav.is-off {
  color: var(--line);
}
.cal-nav.is-ghost {
  pointer-events: none;
}
.cal-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--t1);
}
.cal-week {
  display: flex;
  padding-bottom: 6rpx;
}
.cal-wd {
  flex: 1;
  text-align: center;
  font-size: 24rpx;
  color: var(--t3);
}
.cal-grid {
  display: flex;
  flex-wrap: wrap;
}
.cal-cell {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border-radius: var(--r-sm);
}
.cal-grid.is-day .cal-cell {
  width: 14.285%;
  height: 92rpx;
}
.cal-grid.is-month .cal-cell,
.cal-grid.is-year .cal-cell {
  width: 33.333%;
  height: 132rpx;
}
.cal-cell.is-blank {
  visibility: hidden;
}
.cal-n {
  font-size: 26rpx;
  font-weight: 500;
  color: var(--t1);
}
.cal-cell.is-today {
  background: var(--brand-weak);
}
.cal-cell.is-today .cal-n {
  color: var(--brand-ink);
  font-weight: 700;
}
.cal-cell.is-sel {
  background: var(--brand-btn);
}
.cal-cell.is-sel .cal-n,
.cal-cell.is-sel .cal-big-l,
.cal-cell.is-sel .cal-big-none {
  color: #fff;
}
/* 日视图的格子里只有日期 + 两条色条：7 列一格才 96rpx，金额塞进去只能是小字。
   色条本身不写数字，但哪天有进账、哪天有支出一眼就能看出来。 */
.cal-marks {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 10rpx;
  margin-top: 6rpx;
}
.cal-mark {
  width: 14rpx;
  height: 8rpx;
  margin: 0 3rpx;
  border-radius: 4rpx;
}
.mk-in {
  background: var(--income);
}
.mk-out {
  background: var(--expense);
}
.cal-cell.is-sel .mk-in,
.cal-cell.is-sel .mk-out {
  background: #fff;
}
/* 月/年视图格子大得下数字，就直接给收支，省得再点一下 */
.cal-big {
  margin-top: 4rpx;
  text-align: center;
}
.cal-big-l {
  display: block;
  font-size: 24rpx;
  line-height: 1.45;
}
.cal-big-none {
  font-size: 24rpx;
  color: var(--t4);
}
.cal-tip {
  padding: 26rpx 0 10rpx;
  text-align: center;
  font-size: 25rpx;
  color: var(--t3);
}
.cal-tip.is-bad {
  color: var(--expense);
}
.cal-now {
  margin-top: 10rpx;
  padding: 16rpx 0;
  text-align: center;
  font-size: 25rpx;
  color: var(--brand-ink);
}
.cal-now:active {
  opacity: .6;
}
/* 选中那一格的汇总 */
.cal-sel {
  margin-top: 14rpx;
  padding: 20rpx 24rpx;
  border-radius: var(--r-md);
  background: var(--fill);
}
.cal-sel-hd {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}
.cal-sel-d {
  font-size: 27rpx;
  font-weight: 600;
  color: var(--t1);
}
.cal-sel-v {
  font-size: 34rpx;
  font-weight: 700;
}
.cal-sel-ft {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--t3);
}
.cal-dot {
  margin: 0 10rpx;
  color: var(--line);
}

/* ---------- 汇总表（每日 / 每月，都不列明细） ---------- */
/* 只给结余一列上色：收入/支出两列的头已经写着字了，再上色只是噪声；
   而结余是有正负的，颜色在这里才真的承载信息。 */
.tbl-hd,
.tbl-r {
  display: flex;
  align-items: center;
}
.tbl-hd {
  padding-bottom: 12rpx;
  border-bottom: 1rpx solid var(--line);
}
.tbl-hd .tbl-c1,
.tbl-hd .tbl-c2,
.tbl-hd .tbl-c3,
.tbl-hd .tbl-c4 {
  font-size: 24rpx;
  color: var(--t3);
}
.tbl-r {
  min-height: 88rpx;
  border-bottom: 1rpx solid var(--line);
}
.tbl-r .tbl-c1 {
  font-size: 26rpx;
  color: var(--t1);
}
.tbl-r .tbl-c2,
.tbl-r .tbl-c3,
.tbl-r .tbl-c4 {
  font-size: 25rpx;
}
.tbl-c1 {
  flex: 1.15;
  min-width: 0;
}
.tbl-c2,
.tbl-c3,
.tbl-c4 {
  flex: 1;
  text-align: right;
}
.tbl-r.is-total {
  border-top: 2rpx solid var(--line);
  border-bottom: none;
}
.tbl-r.is-total .tbl-c1 {
  font-weight: 600;
}
.tbl-r.is-total .tbl-c2,
.tbl-r.is-total .tbl-c3,
.tbl-r.is-total .tbl-c4 {
  font-weight: 700;
}
.tbl-tip {
  padding: 40rpx 0;
  text-align: center;
  font-size: 25rpx;
  color: var(--t3);
}
.tbl-tip.is-bad {
  color: var(--expense);
}

/* ---------- 日历的收起/展开标题栏 ---------- */
/* 默认收起：日历很占屏，进报表页十次有九次只是想看今天的数。
   整行都可点，高度按触控下限给足。 */
.cal-toggle {
  display: flex;
  align-items: center;
  min-height: 108rpx;
  padding: 4rpx 4rpx 4rpx;
}
.cal-toggle-main {
  flex: 1;
  min-width: 0;
}
.cal-toggle-t {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--t1);
}
.cal-toggle-d {
  margin-top: 6rpx;
  font-size: 24rpx;
  line-height: 1.5;
  color: var(--t3);
}
/* 展开指示的小三角，跟采购单列表那个是同一套画法 */
.cal-caret {
  width: 16rpx;
  height: 16rpx;
  flex: none;
  margin-left: 20rpx;
  border-right: 3rpx solid var(--t4);
  border-bottom: 3rpx solid var(--t4);
  transform: rotate(45deg) translate(-3rpx, -3rpx);
  transition: transform .18s ease;
}
.cal-caret.up {
  transform: rotate(-135deg) translate(-3rpx, -3rpx);
}
.cal-card .seg {
  margin-top: 8rpx;
}
