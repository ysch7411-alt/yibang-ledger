<!--pages/search/search.wxml-->
<view class="container">
  <view class="page-head">
    <view class="page-title">查询</view>
    <view class="page-sub">任意查，随便核</view>
  </view>

  <!-- 采购单入口：拍过的送货单不在流水里，得有个地方能翻回来 -->
  <view class="po-entry" bindtap="goPurchase" hover-class="tap-dim">
    <view class="po-entry-ico">
      <image class="po-entry-ico-img" src="/images/ic-scan.svg" mode="aspectFit" />
    </view>
    <view class="po-entry-main">
      <view class="po-entry-t">采购单</view>
      <view class="po-entry-d">拍过的送货单都在这儿，明细随时翻</view>
    </view>
    <view class="row-arrow"></view>
  </view>

  <!-- 搜索框：带图标 + 一键清空 -->
  <view class="search-bar">
    <image class="search-ico" src="/images/tab-search.svg" mode="aspectFit" />
    <input
      class="search-input"
      value="{{keyword}}"
      placeholder="搜人名、事由、金额"
      placeholder-class="ph"
      confirm-type="search"
      bindinput="onInput"
      bindconfirm="noop"
    />
    <view wx:if="{{keyword}}" class="search-clear" bindtap="clearKeyword"></view>
  </view>

  <!-- 收支口径 -->
  <view class="seg seg-block">
    <view class="seg-item {{typeFilter === 'all' ? 'on' : ''}}" data-t="all" bindtap="pickType">全部</view>
    <view class="seg-item {{typeFilter === 'in' ? 'on' : ''}}" data-t="in" bindtap="pickType">只收入</view>
    <view class="seg-item {{typeFilter === 'out' ? 'on' : ''}}" data-t="out" bindtap="pickType">只支出</view>
  </view>

  <!-- 时间范围 -->
  <view class="chip-bar">
    <view
      wx:for="{{ranges}}"
      wx:key="key"
      class="chip {{range === item.key ? 'is-on' : ''}}"
      data-r="{{item.key}}"
      bindtap="pickRange"
    >{{item.text}}</view>
  </view>

  <!-- AI 入口：原先的右下悬浮胶囊会压住列表，改成不遮挡内容的一行入口卡 -->
  <view class="ai-entry" bindtap="openAi">
    <image class="ai-entry-ico" src="/images/ic-sparkle.svg" mode="aspectFit" />
    <view class="ai-entry-txt">
      <view class="ai-entry-title">问问 AI 生意参谋</view>
      <view class="ai-entry-desc">「这个月赚了多少」「谁欠我最多」</view>
    </view>
    <view class="row-arrow"></view>
  </view>

  <view class="list-hd">
    <text class="list-hd-t">共 {{total}} 条</text>
    <text wx:if="{{hasFilter}}" class="list-hd-reset" bindtap="resetFilter">清除筛选</text>
  </view>

  <view wx:if="{{loading}}" class="card">
    <view class="skeleton-line" style="width: 44%;"></view>
    <view class="skeleton-line mt-24" style="width: 72%;"></view>
    <view class="skeleton-line mt-16" style="width: 58%;"></view>
  </view>

  <view wx:elif="{{total === 0}}" class="card">
    <view class="empty">
      <image class="empty-ico" src="/images/ic-empty.svg" mode="aspectFit" />
      <view class="empty-title">没有找到符合条件的记录</view>
      <view class="empty-desc">{{keyword ? '换个说法试试，比如只搜人名或金额' : '这段时间还没有记录'}}</view>
      <view wx:if="{{hasFilter}}" class="empty-action" bindtap="resetFilter">清除筛选</view>
    </view>
  </view>

  <block wx:else>
    <block wx:for="{{sections}}" wx:key="key">
      <view class="day-hd">
        <text class="day-label">{{item.label}}</text>
        <text wx:if="{{item.hasSummary}}" class="day-sum">
          <text class="c-income">收 ¥{{item.incomeText}}</text>
          <text wx:if="{{item.hasExpense}}"> · <text class="c-expense">支 ¥{{item.expenseText}}</text></text>
        </text>
      </view>
      <view class="card card-flush">
        <view
          wx:for="{{item.items}}"
          wx:for-item="r"
          wx:key="id"
          class="row {{r.contact_id ? 'row-tap' : ''}}"
          data-id="{{r.contact_id}}"
          bindtap="goContact"
        >
          <view class="row-main">
            <view class="rec-line">
              <text class="tag {{r._tagCls}}">{{r._typeText}}</text>
              <text class="rec-name ellipsis">
                <text wx:for="{{r._titleNodes}}" wx:for-item="n" wx:key="index" class="{{n.hl ? 'hl' : ''}}">{{n.t}}</text>
              </text>
            </view>
            <view class="row-sub">
              <text wx:for="{{r._subNodes}}" wx:for-item="n" wx:key="index" class="{{n.hl ? 'hl' : ''}}">{{n.t}}</text>
            </view>
          </view>
          <view class="row-val num {{r._cls}}">{{r._amount}}</view>
        </view>
      </view>
    </block>
  </block>

  <view class="search-tail"></view>
</view>

<!-- AI 问答 -->
<view class="sheet-mask" wx:if="{{showAi}}" bindtap="closeAi" />
<view class="sheet chat-sheet" wx:if="{{showAi}}">
  <view class="sheet-handle"></view>
  <view class="sheet-hd">
    <text class="sheet-title">AI 生意参谋</text>
    <view class="sheet-close" bindtap="closeAi"></view>
  </view>

  <scroll-view scroll-y class="chat-body" scroll-into-view="{{scrollTo}}" scroll-with-animation>
    <view wx:if="{{aiHistory.length === 0}}" class="chat-hello">
      <image class="empty-ico" src="/images/ic-sparkle.svg" mode="aspectFit" />
      <view class="empty-title">可以这样问我</view>
      <view class="chat-asks">
        <view wx:for="{{quickAsks}}" wx:key="*this" class="chat-ask" data-q="{{item}}" bindtap="askQuick">{{item}}</view>
      </view>
    </view>

    <view wx:for="{{aiHistory}}" wx:key="index" id="m{{index}}" class="chat-item {{item.role}}">
      <view class="chat-bubble">{{item.content}}</view>
    </view>
    <view wx:if="{{aiThinking}}" class="chat-item ai" id="thinking">
      <view class="chat-bubble chat-bubble-thinking">正在算…</view>
    </view>
    <view class="chat-pad" id="chatBottom"></view>
  </scroll-view>

  <view class="chat-input-bar">
    <input
      class="chat-input"
      value="{{aiInput}}"
      placeholder="输入你的问题…"
      placeholder-class="ph"
      confirm-type="send"
      bindinput="onAiInput"
      bindconfirm="sendAi"
    />
    <view class="chat-send {{aiInput ? '' : 'is-disabled'}}" bindtap="sendAi">发送</view>
  </view>
</view>
