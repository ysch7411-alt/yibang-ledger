/* pages/profile/profile.wxss */

/* ---------- 身份卡 ---------- */
.me-card {
  margin: 24rpx 0 24rpx;
  padding: 36rpx 32rpx 12rpx;
  border-radius: var(--r-lg);
  background: linear-gradient(140deg, #E4551D 0%, #C9451A 100%);
  box-shadow: 0 18rpx 40rpx -22rpx rgba(201, 69, 26, .85);
}
.me-top {
  display: flex;
  align-items: center;
}
.me-avatar {
  width: 116rpx;
  height: 116rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, .22);
  border: 2rpx solid rgba(255, 255, 255, .35);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 56rpx;
  flex-shrink: 0;
}
.me-info {
  flex: 1;
  min-width: 0;
  margin: 0 20rpx;
}
.me-name {
  font-size: 38rpx;
  font-weight: 700;
  color: #fff;
}
.me-shop {
  margin-top: 6rpx;
  font-size: 25rpx;
  color: rgba(255, 255, 255, .8);
}
.me-plan {
  height: 52rpx;
  padding: 0 22rpx;
  border-radius: var(--r-full);
  font-size: 24rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  flex-shrink: 0;
}
.me-plan.free {
  background: rgba(255, 255, 255, .2);
  color: #fff;
}
.me-plan.pro {
  background: #FFD66B;
  color: #6B3A00;
}

/* 数据条：让「用的越久越值」这件事可视化 */
.me-stats {
  display: flex;
  align-items: stretch;
  margin-top: 32rpx;
  padding: 24rpx 0;
  border-top: 1rpx solid rgba(255, 255, 255, .2);
}
.me-stat {
  flex: 1;
  min-width: 0;
  text-align: center;
}
.me-stat-v {
  font-size: 40rpx;
  font-weight: 700;
  color: #fff;
  line-height: 1.1;
}
.me-stat-k {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, .75);
}
.me-sep {
  width: 2rpx;
  background: rgba(255, 255, 255, .2);
  margin: 6rpx 0;
}

/* ---------- 底部 ---------- */
.me-footer {
  text-align: center;
  padding: 48rpx 0 24rpx;
}
.me-footer-l1 {
  font-size: 24rpx;
  color: var(--t3);
}
.me-footer-l2 {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--t4);
}

/* ---------- 越用越懂卡片 ---------- */
/* 放在身份卡下面第一屏：招牌卖点要让老板天天看见，不能藏在设置里 */
.memo-card {
  padding: 28rpx 32rpx 24rpx;
  background: linear-gradient(160deg, #FFFFFF 0%, #FFF8F4 100%);
}
.memo-hd {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.memo-t {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--t1);
}
.memo-hero {
  display: flex;
  align-items: baseline;
  margin-top: 14rpx;
}
.memo-num {
  font-size: 58rpx;
  font-weight: 700;
  color: var(--brand-ink);
  line-height: 1.1;
}
.memo-unit {
  margin-left: 12rpx;
  font-size: 27rpx;
  color: var(--t2);
}
.memo-sub {
  margin: 22rpx 0 12rpx;
  font-size: 25rpx;
  color: var(--t3);
}
.memo-map {
  display: flex;
  align-items: center;
  min-height: 64rpx;
  padding: 10rpx 0;
  font-size: 28rpx;
}
.memo-from {
  color: var(--t3);
}
.memo-arrow {
  margin: 0 14rpx;
  color: var(--t4);
}
.memo-to {
  color: var(--t1);
  font-weight: 600;
}
.memo-by {
  margin-left: 14rpx;
  padding: 2rpx 12rpx;
  border-radius: 8rpx;
  background: var(--brand-weak);
  color: var(--brand-ink);
  font-size: 22rpx;
  font-weight: 600;
}
.memo-chips {
  display: flex;
  flex-wrap: wrap;
  margin: 0 -8rpx;
}
.memo-chip {
  height: 56rpx;
  padding: 0 22rpx;
  margin: 0 8rpx 12rpx;
  border-radius: var(--r-full);
  background: var(--fill);
  color: var(--t2);
  font-size: 25rpx;
  display: flex;
  align-items: center;
}
.memo-empty {
  margin-top: 16rpx;
  font-size: 26rpx;
  line-height: 1.6;
  color: var(--t3);
}
.memo-tip {
  margin-top: 18rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid var(--line);
  font-size: 25rpx;
  line-height: 1.6;
  color: var(--t3);
}

/* ---------- 身份卡的店名行：可点击修改 ---------- */
/* 原来「点这里完善店名」点不动，是个空头承诺。现在整块可点，右侧给一支白铅笔做提示。
   图标用另存的白色版（ic-pencil-w.svg），不用 CSS filter —— 小程序里 image 的 filter 支持不稳。 */
.me-shop-row {
  display: flex;
  align-items: center;
  margin-top: 6rpx;
}
.me-shop-row .me-shop {
  margin-top: 0;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.me-edit {
  width: 26rpx;
  height: 26rpx;
  flex: none;
  margin-left: 10rpx;
  opacity: .8;
}

/* 改资料的弹层里那行说明 */
.pf-note {
  padding: 2rpx 0 22rpx;
  font-size: 25rpx;
  line-height: 1.65;
  color: var(--t3);
}
/* 表单三件套在这里也定义一份：profile.wxss 是页面级作用域，
   拿不到 record.wxss 里的同名类 */
.f-block {
  margin-bottom: 28rpx;
}
.f-label {
  font-size: 25rpx;
  color: var(--t3);
  margin-bottom: 12rpx;
}
.f-input {
  height: 88rpx;
  padding: 0 24rpx;
  border-radius: var(--r-sm);
  background: var(--fill);
  font-size: 29rpx;
  color: var(--t1);
}
