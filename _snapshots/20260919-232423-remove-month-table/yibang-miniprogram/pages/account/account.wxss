/* pages/account/account.wxss —— 账号与安全 */

.acc-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 64rpx;
}
.acc-k {
  font-size: 30rpx;
  color: var(--t1);
}
.acc-v {
  font-size: 28rpx;
}
.acc-ok {
  color: var(--income);
  font-weight: 600;
}
.acc-off {
  color: var(--t3);
}
.acc-note {
  margin-top: 14rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid var(--line);
  font-size: 25rpx;
  line-height: 1.6;
  color: var(--t3);
}

/* 右侧的值（手机号 / 去绑定） */
.acc-val {
  flex: none;
  margin-left: 16rpx;
  font-size: 27rpx;
  color: var(--t2);
  font-variant-numeric: tabular-nums;
}

/* 危险区标题 */
.danger-hd {
  margin: 40rpx 4rpx 12rpx;
  font-size: 25rpx;
  color: var(--t3);
}

.acc-foot {
  margin-top: 36rpx;
  font-size: 24rpx;
  line-height: 1.8;
  color: var(--t3);
  text-align: center;
}
