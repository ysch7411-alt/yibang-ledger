# ---------------------------------------------------------------------------
# 备份与临时产物（2026-09-23 补）
#
# ⚠️ 这些目录**曾经被提交过**，所以光加 ignore 不够 ——
#    git 的 .gitignore 只对"未跟踪"的文件生效，已经进过库的必须显式取消跟踪：
#        git rm -r --cached _snapshots
#    当时 3383 个跟踪文件里 **3005 个是快照**（89% 是备份，不是代码）。
#    而且里面还含图片和 .sql，明明上面早写了 *.png / *.sql ——
#    **"写了规则"和"已经进库了"是两件事**，这个坑每个项目都会踩一次。
# ---------------------------------------------------------------------------

# 代码快照（本地回滚用，属工作产物，不进库）
_snapshots/

# 验证脚本的产物：截图、事故备份
_verify/shots/
_verify/damaged-backup-*/

# 上传的用户文件（真实业务数据，绝不能进库）
yibang-server/uploads/
