.pg{min-height:100vh;background:#FAF8F4;padding:24rpx 24rpx 60rpx;box-sizing:border-box}
.hint{font-size:24rpx;color:#8A7F76;line-height:1.6;margin:8rpx 8rpx 24rpx}
.loading,.empty{padding:80rpx 24rpx;text-align:center;color:#8A7F76;font-size:26rpx}
.list{display:flex;flex-direction:column;gap:16rpx}
.card{background:#fff;border-radius:20rpx;padding:24rpx;display:flex;align-items:center;gap:20rpx}
.ico{width:64rpx;height:64rpx;border-radius:18rpx;background:#FAF8F4;display:flex;align-items:center;justify-content:center;flex-shrink:0}
.ico .ic{width:34rpx;height:34rpx}
.bd{flex:1;min-width:0}
.nm{display:block;font-size:30rpx;color:#2A2522;font-weight:600}
.meta{display:block;font-size:22rpx;color:#8A7F76;margin-top:6rpx}
