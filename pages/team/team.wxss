/* pages/team/team.wxss —— 与 preview-demo.html 主色对齐 */
.pg { min-height: 100vh; background: #FAF8F4; padding: 24rpx; }

.hero { background: linear-gradient(135deg, #FF6B35 0%, #F45B22 100%); border-radius: 20rpx;
  padding: 40rpx 32rpx; color: #fff; margin-bottom: 24rpx; }
.hero-ic { width: 64rpx; height: 64rpx; margin-bottom: 12rpx; }
.hero-t { font-size: 36rpx; font-weight: 700; }
.hero-s { font-size: 24rpx; opacity: 0.9; margin-top: 8rpx; }

.card { background: #fff; border-radius: 24rpx; padding: 28rpx;       /* demo padding 14px → ×2 */
  margin-bottom: 20rpx; box-shadow: 0 4rpx 16rpx rgba(0,0,0,.06);
  border: 1rpx solid #f0f0eb; }
.card-hd { display: flex; justify-content: space-between; align-items: center; margin-bottom: 20rpx; }
.card-hd-t { font-size: 30rpx; font-weight: 600; color: #2A2522; }
.card-hd-action { font-size: 26rpx; color: #FF6B35; font-weight: 600; }

.member { display: flex; align-items: center; gap: 24rpx; padding: 16rpx 0; }
.member-avatar { width: 80rpx; height: 80rpx; border-radius: 50%; background: #FF6B35; color: #fff;
  display: flex; align-items: center; justify-content: center;
  font-size: 28rpx; font-weight: 700; flex-shrink: 0; }
.member-info { flex: 1; }
.member-name { font-size: 30rpx; font-weight: 600; color: #2A2522; }
.member-role { font-size: 22rpx; color: #888; margin-top: 4rpx; }
.member-tag { background: #FFFBEB; color: #B08800; font-size: 20rpx; padding: 6rpx 14rpx;
  border-radius: 999rpx; }

.info-row { display: flex; justify-content: space-between; padding: 12rpx 0; font-size: 26rpx; }
.info-l { color: #2A2522; font-weight: 500; }
.info-r { color: #888; }

.tip { background: #FFFBEB; border-radius: 16rpx; padding: 24rpx 28rpx; border: 1rpx solid #F0E0A0; }
.tip-hd { display: flex; align-items: center; gap: 12rpx; margin-bottom: 8rpx; }
.tip-ic { width: 32rpx; height: 32rpx; }
.tip-t { font-size: 26rpx; font-weight: 600; color: #6B5A1E; }
.tip-s { display: block; font-size: 24rpx; color: #6B5A1E; opacity: 0.8; line-height: 1.5; }
