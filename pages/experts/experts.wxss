.pg{min-height:100vh;background:#FAF8F4;padding:24rpx 24rpx 60rpx;box-sizing:border-box}
.sk{padding:20rpx 0}
.sk-i{height:220rpx;background:#EFEAE3;border-radius:20rpx;margin-bottom:24rpx}
.err{padding:120rpx 40rpx;text-align:center}
.err-t{display:block;font-size:30rpx;color:#2A2522}
.err-btn{display:inline-block;margin-top:40rpx;background:#C9451A;color:#fff;
  font-size:28rpx;padding:18rpx 56rpx;border-radius:999rpx}
.cards{display:flex;flex-direction:column;gap:24rpx}
.ex{background:#fff;border-radius:20rpx;padding:28rpx 24rpx;
  box-shadow:0 2rpx 12rpx rgba(120,60,30,.05)}
.hd{display:flex;align-items:flex-start;gap:20rpx;margin-bottom:22rpx}
.av{width:76rpx;height:76rpx;border-radius:22rpx;background:#F9EAE4;
  display:flex;align-items:center;justify-content:center;font-size:40rpx;flex-shrink:0}
.tt{flex:1;min-width:0}
.n{display:block;font-size:34rpx;font-weight:600;color:#2A2522}
.s{display:block;font-size:24rpx;color:#8A7F76;margin-top:6rpx}
.pro{font-size:22rpx;color:#C9451A;background:#F9EAE4;padding:8rpx 16rpx;
  border-radius:999rpx;flex-shrink:0}
.free{font-size:22rpx;color:#2E7D5B;background:#EAF3DE;padding:8rpx 16rpx;
  border-radius:999rpx;flex-shrink:0}
.caps{display:flex;flex-wrap:wrap;gap:12rpx}
.cap{background:#FAF8F4;border:1rpx solid #EDE7DF;color:#6C6258;
  font-size:24rpx;padding:10rpx 20rpx;border-radius:999rpx}
.cant{margin-top:18rpx;padding-top:16rpx;border-top:1rpx dashed #EDE7DF}
.cant-t{font-size:24rpx;color:#8A7F76}
.tip{background:#fff;border-radius:18rpx;padding:26rpx;margin-top:32rpx}
.tip-t{display:block;font-size:26rpx;font-weight:600;color:#2E7D5B;margin-bottom:8rpx}
.tip-s{display:block;font-size:24rpx;color:#8A7F76;line-height:1.6}
