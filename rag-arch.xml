<colgroup><col width="150"/><col width="250"/><col width="300"/></colgroup>
<thead><tr><th background-color="light-gray"><p>组件</p></th><th background-color="light-gray"><p>方案</p></th><th background-color="light-gray"><p>说明</p></th></tr></thead>
